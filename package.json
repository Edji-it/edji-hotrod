{
  "name": "edji-hotrod",
  "version": "4.13.14",
  "description": "Hot Rod is Edji's roaring Front End!",
  "author": "Edji, Inc.",
  "homepage": "https://edji.it/",
  "scripts": {
    "ng": "ng",
    "deploy:branch": "ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:dev": "yarn release && ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:dev:minor": "yarn release --release-as minor && ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:dev:major": "yarn release --release-as major && ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:prod": "grunt checkbranch:master:true && ng build --prod && grunt push:prod && grunt cloudfront:prod",
    "dev": "ng serve",
    "dev:ssl": "ng serve --ssl true",
    "start": "ng serve",
    "build": "ng build",
    "build:ci": "ng build -c=test",
    "test": "jest --reporters=default",
    "test:ci": "JEST_JUNIT_OUTPUT='./output/jest/results.xml' jest --reporters=jest-junit",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:ci": "protractor-flake --parser standard --max-attempts=3 -- e2e/protractor-circleci.conf.js",
    "e2e:dev": "protractor-flake --parser standard --max-attempts=1 -- e2e/protractor.conf.js",
    "e2e:headless": "ng e2e --protractor-config e2e/protractor-circleci.conf.js",
    "e2e:mobile": "ng e2e --protractor-config e2e/protractor-mobile.conf.js",
    "release": "yarn standard-version",
    "server:ci": "http-server dist/edji-hotrod -p 3375 --cors --silent",
    "webdriver": "webdriver-manager update",
    "postinstall": "node ng-add-pug-loader.js"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "^0.801.2",
    "@angular/animations": "^8.1.3",
    "@angular/cdk": "^8.2.3",
    "@angular/common": "^8.1.3",
    "@angular/compiler": "^8.1.3",
    "@angular/core": "^8.1.3",
    "@angular/forms": "^8.1.3",
    "@angular/http": "^7.2.15",
    "@angular/material": "^8.2.3",
    "@angular/platform-browser": "^8.1.3",
    "@angular/platform-browser-dynamic": "^8.1.3",
    "@angular/router": "^8.1.3",
    "@ngrx/effects": "^8.1.0",
    "@ngrx/store": "^8.1.0",
    "@sentry/browser": "^4.2.3",
    "airtable": "^0.7.1",
    "angular-2-dropdown-multiselect": "codiak/angular-2-dropdown-multiselect",
    "angular-safeguard": "^2.0.1",
    "angular2-medium-editor": "1.3.1",
    "angulartics2": "^7.0.2",
    "bootstrap": "4.2.1",
    "core-js": "^2.6.5",
    "driver.js": "^0.9.8",
    "emojione": "^4.5.0",
    "hammerjs": "^2.0.8",
    "html2canvas": "^1.0.0-alpha.12",
    "html2canvas-render-offscreen": "^0.0.3",
    "jspdf": "^1.4.1",
    "linkifyjs": "^2.1.6",
    "medium-editor": "^5.23.3",
    "ngx-page-scroll": "^5.0.0",
    "ngx-scrollbar": "^7.0.1",
    "opus-recorder": "^4.1.4",
    "primeng": "^7.0.5",
    "pug-loader": "^2.4.0",
    "rangy": "^1.3.0",
    "rxjs": "^6.5.2",
    "socket.io-client": "^2.2.0",
    "standard-version": "^4.4.0",
    "zone.js": "^0.8.29"
  },
  "devDependencies": {
    "@angular/cli": "^8.1.2",
    "@angular/compiler-cli": "^8.1.3",
    "@angular/language-service": "^8.1.3",
    "@types/hammerjs": "^2.0.36",
    "@types/jasmine": "^3.3.13",
    "@types/jest": "^24.0.25",
    "@types/node": "~8.9.4",
    "@types/socket.io-client": "^1.4.32",
    "@types/uglify-js": "^3.0.4",
    "@types/webpack": "^4.4.34",
    "@typescript-eslint/eslint-plugin": "^1.6.0",
    "@typescript-eslint/parser": "^1.6.0",
    "apply-loader": "^2.0.0",
    "codelyzer": "~4.2.1",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-prettier": "^3.0.1",
    "grunt": "^1.0.2",
    "grunt-aws": "^0.6.2",
    "grunt-checkbranch": "^1.0.4",
    "http-server": "^0.11.1",
    "jasmine": "^3.4.0",
    "jasmine-marbles": "^0.5.0",
    "jasmine-reporters": "^2.3.2",
    "jasmine-spec-reporter": "^4.2.1",
    "jest": "^24.9.0",
    "jest-extended": "^0.11.2",
    "jest-junit": "^6.4.0",
    "jest-preset-angular": "^7.1.1",
    "prettier": "^1.16.4",
    "protractor": "^5.4.3",
    "protractor-console-plugin": "^0.1.1",
    "protractor-flake": "^4.0.0",
    "pug": "^2.0.4",
    "pug-jest": "^1.0.1",
    "ts-node": "~5.0.1",
    "tslint": "~5.9.1",
    "typescript": "3.4.1"
  }
}
