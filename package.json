{
  "name": "edji-hotrod",
  "version": "4.10.14",
  "description": "Hot Rod is Edji's roaring Front End!",
  "author": "Edji, Inc.",
  "homepage": "https://edji.it/",
  "scripts": {
    "ng": "ng",
    "deploy:dev": "yarn release && ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:dev:minor": "yarn release --release-as minor && ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:dev:major": "yarn release --release-as major && ng build --prod && grunt push:dev && grunt cloudfront:dev",
    "deploy:prod": "grunt checkbranch:master:true && ng build --prod && grunt push:prod && grunt cloudfront:prod",
    "dev": "ng serve",
    "dev:ssl": "ng serve --ssl true",
    "start": "ng serve",
    "build": "ng build",
    "build:ci": "ng build -c=test",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:ci": "protractor-flake --parser standard --max-attempts=3 -- e2e/protractor-circleci.conf.js",
    "e2e:dev": "protractor-flake --parser standard --max-attempts=3 -- e2e/protractor.conf.js",
    "e2e:headless": "ng e2e --protractor-config e2e/protractor-circleci.conf.js",
    "e2e:mobile": "ng e2e --protractor-config e2e/protractor-mobile.conf.js",
    "postinstall": "node ./ng-add-pug-loader.js",
    "release": "yarn standard-version",
    "server:ci": "http-server dist/edji-hotrod -p 3375 --cors --silent",
    "webdriver": "webdriver-manager update"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^7.2.5",
    "@angular/cdk": "^7.2.5",
    "@angular/common": "^7.2.5",
    "@angular/compiler": "^7.2.5",
    "@angular/core": "^7.2.5",
    "@angular/forms": "^7.2.5",
    "@angular/http": "^7.2.5",
    "@angular/platform-browser": "^7.2.5",
    "@angular/platform-browser-dynamic": "^7.2.5",
    "@angular/router": "^7.2.5",
    "@ngrx/effects": "^7.4.0",
    "@ngrx/store": "^7.4.0",
    "@sentry/browser": "^4.2.3",
    "angular-2-dropdown-multiselect": "codiak/angular-2-dropdown-multiselect",
    "angular-safeguard": "^2.0.1",
    "angular2-medium-editor": "1.3.1",
    "angulartics2": "^7.0.2",
    "bootstrap": "4.2.1",
    "core-js": "^2.6.5",
    "emojione": "^3.1.4",
    "hammerjs": "^2.0.8",
    "html2canvas": "^1.0.0-alpha.12",
    "html2canvas-render-offscreen": "^0.0.3",
    "jspdf": "^1.4.1",
    "linkifyjs": "^2.1.6",
    "medium-editor": "^5.23.3",
    "ng-cli-pug-loader": "^0.1.3",
    "ngx-page-scroll": "^5.0.0",
    "opus-recorder": "^4.1.4",
    "primeng": "^7.0.5",
    "protractor-flake": "^4.0.0",
    "rangy": "^1.3.0",
    "rxjs": "^6.4.0",
    "standard-version": "^4.4.0",
    "zone.js": "^0.8.29"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^0.13.9",
    "@angular/cli": "^7.3.9",
    "@angular/compiler-cli": "^7.2.5",
    "@angular/language-service": "^7.2.5",
    "@types/hammerjs": "^2.0.36",
    "@types/jasmine": "~2.8.7",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "~8.9.4",
    "@typescript-eslint/eslint-plugin": "^1.6.0",
    "@typescript-eslint/parser": "^1.6.0",
    "apply-loader": "^2.0.0",
    "codelyzer": "~4.2.1",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-prettier": "^3.0.1",
    "grunt": "^1.0.2",
    "grunt-aws": "^0.6.2",
    "grunt-checkbranch": "^1.0.4",
    "http-server": "^0.11.1",
    "jasmine-core": "3.1.0",
    "jasmine-reporters": "^2.3.2",
    "jasmine-spec-reporter": "4.2.1",
    "karma": "~4.1.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.5",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "prettier": "^1.16.4",
    "protractor": "^5.4.2",
    "pug": "^2.0.3",
    "pug-loader": "^2.4.0",
    "ts-node": "~5.0.1",
    "tslint": "~5.9.1",
    "typescript": "3.2.4"
  }
}
