nav-bar
.container-fluid
  //- .row.navy.has-sparks
  //-   .sparks(style='z-index:0;')
  //-   .col-sm-12
  //-     img.hero-background(src='/assets/images/hero-lg.png')
  //-     .call-to-action
  //-       h1.promo-header.center Empower with Hero
  .row.twilight.has-sparks(style="padding-top:100px; padding-bottom: 100px; position: relative; overflow:hidden;")
    .sparks
    img.promo-spotlight(style="position:absolute;right:10%;bottom:0px;height:95%;", src="/assets/images/hero-promo-spotlight.svg")
    img(style="width:100%; position: absolute; bottom: -50px;",src="/assets/images/hero-promo-skyline.svg")
    .col-12(style="padding-bottom:25px;")
      h1.big-bold(style="color:#fff;") Answer the Call
    .col-1
    .col-6
      p.row-xl-pad(style='font-size:1.25em;')
        | Hero gives you more powers to supercharge your classrooms readings. Engage your students with questions, in reading discussion, and more! 
        span([innerHTML]="':tada:' | emojione")
      button.btn.btn-lg.btn-hero((click)='goHero()')
        | Go Hero
  //- Feature preview and Academy CTA
  .row.row-xl-pad
    .col-8
      .row
        .feature-preview.col-4.text-center(pageScroll, href="#sectionAudio")
          .img-wrap
            img(src="/assets/images/promo-spot-mic.svg")
          h3.pt-3 Amp up student voice
        .feature-preview.col-4.text-center(pageScroll, href="#sectionFilter")
          .img-wrap
            img(style="transform: translateX(-1px);", src="/assets/images/promo-spot-filter.svg")
          h3.pt-3 Filter on individuals
        .feature-preview.col-4.text-center(pageScroll, href="#sectionQuestion")
          .img-wrap
            img(style="transform: translate3d(2px,2px,0px);", src="/assets/images/promo-spot-question.svg")
          h3.pt-3 Ask and assess
    .col-4
        h2.small-bold Assemble Your Team
        p With Hero Academy, your whole school can wield the powers of Hero
        .btn.btn-secondary((click)="showRequestAcademyModal = true") Request Academy Info
  .row.hero-promo-form(style="margin:50px 0px;")
    .col-md-8.offset-md-2
      h2.text-center.medium-bold(style='margin-bottom: 0.5em;') Make Powerful Lessons
  .row.row-xl-pad
    #sectionQuestion.col-4.offset-md-1
      h3.medium-semibold Add in-line <b>Questions</b> to Readings, and get compiled answers
      //- p In-line questions and compiled answers.
    .col-7.text-center
      img(src="/assets/images/hero-promo-question.png")
  .row.row-xl-pad
    .col-4.offset-md-1
      h3.medium-semibold Comment <b>Replies</b> let you or your students start discussions right in the text
      //- pimg(src="/assets/images/hero-promo-question.png")
      //-   strong Comment Replies
      //-   br
      //-   | Replies let you or your readers start discussion right in the text. Reach out to a student and ask them to expand on their comment, or let students talk to eachother to explore a topic even more in depth on their own!
    .col-7.text-center
      img(src="/assets/images/hero-promo-replies.png", style="border:1px solid #cdcdcd; max-width: 400px;")
  .row.row-xl-pad
    .col-4.offset-md-1
      h3.medium-semibold <b>Custom Group Codes</b> for memorization or for tying into another activity
      //- br
      //- | Share a reading with a custom code you select to be memorable and easier for your students to reach. Codes can describe the reading, an answer to a trivia question, or a fun to get students even more excited about reading!
      //- <p><strong>Custom Avatars</strong><br/>As a Reading owner, have your picture show next to each of your comments.</p>
    .col-7.text-center
      img(src="/assets/images/hero-promo-codes.png", style="border:1px solid #cdcdcd; max-width: 400px;")
  .row.navy.row-xl-pad.has-sparks
    .sparks
    .col-12
      h1.on-dark.text-center What's the next step in your hero's journey?
    .col-2
    .col-4
      .button__row
          button.btn.btn-secondary((click)="showRequestAcademyModal = true") Request Academy Info
    .col-4
      .button__row
          button.btn.btn-hero((click)='goHero()')
            | Time to Go Hero
  .row.row-xl-pad
    #sectionAudio.col-4.offset-md-1
      h3.medium-semibold
        | Put student voices on a stage with <b>Audio Comments</b>
    .col-7.text-center
      img(src="/assets/images/hero-promo-audio.png", style="border:1px solid #cdcdcd; max-width: 400px;")
  .row.row-xl-pad
    #sectionFilter.col-4.offset-md-1
      h3.medium-semibold
        | <b>Student Filters</b> give the power to review and show off an individual's annotations
    .col-7.text-center
      img(src="/assets/images/hero-promo-filter.png", style="max-width: 400px;")
  .row.row-xl-pad
    .col-4.offset-md-1
      h3.medium-semibold
        | Priority customer support at the ready to help you build your lesson and solve technical issues in your classroom
    .col-7.text-center
      img(src="/assets/images/hero-promo-phone.svg", style="max-width: 400px;")
  .row.navy.row-xl-pad.has-sparks
    .sparks
    .col-12.text-center
      h1.on-dark(style="margin:0px;")
        | Answer the Call
      p.on-dark.mt-2.mb-4
        | Engage your students, build super lessons, and support Edji
      .button__row.pb-2
          button#heroCTA.btn-lg.btn.btn-hero((click)='goHero()')
            | Go Hero 
            span(style='font-weight: 700;')
//- container-fluid
hot-login-register.modal-will-fade(
    [loginHeader]="loginModalHeader", 
    [class.show]='showLoginModal',
    (closeModal)='showLoginModal = false',
    (loginSuccess)='showHeroSubModal = true'
  )
hero-subscribe-modal.modal-will-fade(
    [class.show]='showHeroSubModal', 
    (closeModal)='showHeroSubModal = !showHeroSubModal', 
    (heroWasBorn)="_router.navigate(['/dashboard'])"
  )
request-academy-modal.modal-will-fade(
  [class.show]="showRequestAcademyModal",
  (closeModal)="showRequestAcademyModal = false"
)
