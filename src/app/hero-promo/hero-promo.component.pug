  //-     .call-to-action
  //-       h1.promo-header.center Empower with Hero
  .row.hero-promo-form
    .col-md-8.offset-md-2
      .button__row.pb-4
        button#heroCTA.btn.btn-hero((click)='goHero()')
          | Go Hero for 
          span(style='font-weight: 700;') $60/yr
      h1(style='margin-bottom: 0.5em;') Heroes Make Powerful Lessons
      p(style='font-size:1.25em;')
        | Hero gives you more powers to supercharge your classrooms readings. Engage your students with questions, in reading discussion, and more! 
        span([innerHTML]="':tada:' | emojione")
      p(style='font-size:1.25em') As a Hero, you get:
      p
        strong Reading Questions
        br
        | Gather more insight into your students thoughts as they read. Ask them what they learned or how their understanding of the topic has changed. Choose if they can answer with emoji, text, or by recording their own audio answer!
      p
        strong Comment Replies
        br
        | Replies let you or your readers start discussion right in the text. Reach out to a student and ask them to expand on their comment, or let students talk to eachother to explore a topic even more in depth on their own!
      p
        strong Custom Group Codes
        br
        | Share a reading with a custom code you select to be memorable and easier for your students to reach. Codes can describe the reading, an answer to a trivia question, or a fun to get students even more excited about reading!
      //- <p><strong>Custom Avatars</strong><br/>As a Reading owner, have your picture show next to each of your comments.</p>
      p
        strong Audio Comments
        span.beta-tag (BETA)
        br
        | Let your students record an Audio Comment as they read so they can put their thoughts directly into the reading for their classmates to hear. Great for students that struggle with writing, or students that are so excited they just can&apos;t wait to write their thoughts down!
      br
      small
        span.beta-tag (BETA)
        |  Audio comments are currently only available on Windows computers and Chromebooks while using the Google Chrome Browser. iPad and MacBook functionality is coming soon!
  //- Share buttons!
    NOTES:
    - Change the second half of onclick to customize the default share message.
  .row
    .col-12.text-center
      //- Facebook
      .icon-share-button
        a(href='https://www.facebook.com/sharer/sharer.php?u=https%3A//edji.it/%23/hero' title='Share on Facebook' target='_blank' onclick="window.open('https://www.facebook.com/sharer/sharer.php?u=https%3A//edji.it/%23/hero'); return false;")
          img(alt='Share on Facebook' src='assets/share-icons/Facebook.png')
      //- Twitter
      .icon-share-button
        a(href='https://twitter.com/intent/tweet?source=https%3A%2F%2Fedji.it&text=:%20https%3A%2F%2Fedji.it' target='_blank' title='Tweet' onclick="window.open('https://twitter.com/intent/tweet?text=' + 'Read like a superhero with Edji Hero! ' + encodeURIComponent(document.URL)); return false;")
          img(alt='Tweet' src='assets/share-icons/Twitter.png')
      //- Email
      .icon-share-button
        a(href='mailto:?subject=&body=:%20https%3A%2F%2Fedji.it' target='_blank' title='Send email' onclick="window.open('mailto:?subject=' + '' + '&body=' +  encodeURIComponent(document.URL)); return false;")
          img(alt='Send email' src='assets/share-icons/Email.png')
//- container-fluid
hot-login-register.modal-will-fade(
    [loginHeader]="loginModalHeader", 
    [class.show]='showLoginModal',
    (closeModal)='showLoginModal = false',
    (loginSuccess)='showHeroSubModal = true'
  )
hero-subscribe-modal.modal-will-fade(
    [class.show]='showHeroSubModal', 
    (closeModal)='showHeroSubModal = !showHeroSubModal', 
    (heroWasBorn)="_router.navigate(['/dashboard'])"
  )
