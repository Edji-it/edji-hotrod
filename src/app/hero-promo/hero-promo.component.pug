#top
nav-bar
.container-fluid
  //- Promo row
  .row.row-xl-pad.navy.has-sparks
    .sparks
    .col-md-11.offset-md-1
      h1.display-4.on-dark.mb-0(style="font-weight: 100; line-height: 1.5em;")
        | Fastest way to get students reading
        .ml-2 Easiest way to annotate content
        .ml-4 Best way to see student thoughts
      //- p.lead
        | Edji's core set of features will stay open and freely available, but a Hero subscription supports Edji and unlocks even more abilities 
        span([innerHtml]="':tada:' | emojione")
  //- Feature preview and Academy CTA
  .row.row-xl-pad
    .col-md-8
      .row
        .feature-preview.col-md-4.text-center(pageScroll, href="#sectionFilter", (click)='spotlightTracking("studentFiltering")')
          .img-wrap
            img(style="transform: translateX(-1px);", src="/assets/images/promo-spot-filter.svg")
          h3.pt-3 Filter on individuals
        .feature-preview.col-md-4.text-center(pageScroll, href="#sectionAudio", (click)='spotlightTracking("audioCommenting")')
          .img-wrap
            img(src="/assets/images/promo-spot-mic.svg")
          h3.pt-3 Amp up student voice
        .feature-preview.col-md-4.text-center(pageScroll, href="#sectionQuestion", (click)='spotlightTracking("questionsAnswers")')
          .img-wrap
            img(style="transform: translate3d(2px,2px,0px);", src="/assets/images/promo-spot-question.svg")
          h3.pt-3 Ask and assess
    .col-md-4.pt-4
        h2.small-bold Assemble Your Team
        p With Hero Academy, your whole school can wield the powers of Hero
        .btn.btn-secondary((click)="requestAcademyModalShow('featurePreview')") Request Academy Info
  .row
    .hero-rule
  //- Student Filters
  .row.row-xl-pad
    #sectionFilter.col-md-4.offset-md-1
      h3.medium-semibold
        | <b>Student Filters</b> give the power to review and show off an individual's annotations
    .col-md-7.text-center
      img(src="/assets/images/hero-promo-filter.png", style="max-width: 400px;")
  .row
    .hero-rule
  //- Replies
  .row.row-xl-pad
    .col-md-4.offset-md-1
      h3.medium-semibold Comment <b>Replies</b> let you and your students start discussions right in the text
    .col-md-7.text-center
      .promo-screen-wrap
        img(src="/assets/images/hero-promo-replies.png")
  .row
    .hero-rule
  //- Audio Comments
  .row.row-xl-pad
    #sectionAudio.col-md-4.offset-md-1
      h3.medium-semibold
        | Put student voices on a stage with <b>Audio Comments</b>
    .col-md-7.text-center
      .promo-screen-wrap
        img(src="/assets/images/hero-promo-audio.png")
  .row
    .hero-rule
  //- Questions
  .row.row-xl-pad
    #sectionQuestion.col-md-6.offset-md-3
      h3.medium-semibold.text-center Add in-line <b>Questions</b> to Readings, and get answers in one place
      //- p In-line questions and compiled answers.
    .col-md-12.text-center
      img(src="/assets/images/hero-promo-question.png", style="max-width:700px;")
  .row
    .hero-rule
  //- Instructions
  .row.row-xl-pad
    #sectionInstructions.col-md-4.offset-md-1
      h3.medium-semibold
        | Use <b>Instructions</b> to give students clear goals and improve understanding
    .col-md-7.text-center
      img(src="/assets/images/hero-promo-instructions.png", style="max-width: 500px;")
  //- //- CTA Row
  //- .row.navy.row-xl-pad.has-sparks
  //-   .sparks
  //-   .col-12
  //-     h1.on-dark.text-center What's the next step in your hero's journey?
  //-   .col-2
  //-   .col-md-4
  //-     .button__row
  //-         button.btn.btn-secondary((click)="requestAcademyModalShow('middleCTA')") Request Academy Info
  //-   .col-md-4
  //-     .button__row
  //-         button.btn.btn-hero((click)='goHero("middleCTA")')
  //-           | Time to Go Hero
  .row.hero-promo-form(style="margin:50px 0px;")
    .col-12
      h1.big-light.text-center(style='margin-bottom: 0.5em;') 
        | Make
        span(style="background:rgba(253, 228, 104, 0.45); padding:0 0.1em; margin: 0 0.1em; display:inline-block;") Powerful 
        | Lessons
      p.medium-semibold.text-center Hero unlocks the full power of Edji with...
  //- Classroom Support
  .row.row-xl-pad
    #sectionSupport.col-md-4.offset-md-1
      h3.medium-semibold
        | <b>Priority Classroom Support</b> at the ready to help you build your lesson and solve technical issues in your classroom
    .col-md-7.text-center
      img(src="/assets/images/hero-promo-phone.svg", style="max-width: 400px;")
  .row
    .hero-rule
  //- Reading Recap
  .row.row-xl-pad
    #sectionRecap.col-md-6.offset-md-3
      h3.medium-semibold.text-center
        | See each student's engagement in-depth with <b>Reading Recap</b>
    .col-md-12.text-center.pt-4
      img(src="/assets/images/hero-promo-recap.png", style="max-width: 700px;")
  .row
    .hero-rule
  //- Custom Codes
  .row.row-xl-pad
    .col-md-4.offset-md-1
      h3.medium-semibold <b>Custom Group Codes</b> for memorization or for tying readings into another activity
    .col-md-7.text-center
      .promo-screen-wrap
        img(src="/assets/images/hero-promo-codes.png")
  .row
    .hero-rule
  //- Feedback
  .row.row-xl-pad
    #sectionFeedback.col-md-4.offset-md-1
      h3.medium-semibold Give live <b>Feedback</b> to students when it is most impactful
    .col-md-7.text-center
      img(src="/assets/images/hero-promo-feedback.png", style="max-width:600px;")
  .row.navy.row-xl-pad.has-sparks
    .sparks
    .col-12.text-center
      h1.big-light.on-dark(style="margin:0px;")
        | Answer the Call
      p.on-dark.mt-2.mb-4
        | Engage your students, build super lessons, and support Edji
      .button__row.py-2
          button#heroCTA.btn-lg.btn.btn-hero((click)='goHero("lowerCTA")')
            | Go Hero 
            span(style='font-weight: 700;')
          button.btn.btn-secondary.ml-4([routerLink]="['/pricing']", fragment="top") 
            | Compare Plans
//- container-fluid
hot-login-register.modal-will-fade(
    [loginHeader]="loginModalHeader", 
    [class.show]='showLoginModal',
    (closeModal)='showLoginModal = false',
    (loginSuccess)='showHeroSubModal = true'
  )
hero-subscribe-modal.modal-will-fade(
    [class.show]='showHeroSubModal', 
    (closeModal)='showHeroSubModal = !showHeroSubModal', 
    (heroWasBorn)="_router.navigate(['/dashboard'])"
  )
request-academy-modal.modal-will-fade(
  [class.show]="showRequestAcademyModal",
  (closeModal)="showRequestAcademyModal = false",
  [academyPlans]="academyPlans",
  [sliderPos]="sliderPos"
)
