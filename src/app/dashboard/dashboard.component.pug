nav-bar([showDashboardOptions]="true")
.dashboard-toolbar
  a#joinTab.tab-2.h1((click)="mobileShowJoined=true", [class.active]="mobileShowJoined") Joined
  a#createdTab.tab-2.h1((click)="mobileShowJoined=false", [class.active]="!mobileShowJoined") Created
//- Dashboard uses the *fluid* container, for maximum space use
.container-fluid.dashboard-container
  .row
    .col-12
      router-outlet
.fixed-btn-row--SE
  tutorial-box.hidden-sm-down(
    [tutorialName]="'newReading'",
    [pageObjs]="toolTipsContent", 
    [pager]="toolTipStepNo", 
    (pageChange)="toolTipStepNo = $event"
  )
hot-user-details-update([showModal]="showUserDetailsModal", (closeModal)="showUserDetailsModal = false")