h1.joined-header.no-flow(for="projectCodeInput") Joined Readings
  i.icon__tooltip(tooltipPosition="bottom", pTooltip="These are Readings that someone else made, and you joined!")
    span.icon.icon-circle.icon-info i
form.pb-4.hidden-md-up([formGroup]="codeForm", (ngSubmit)="addSession(codeForm.value)")
  .input-group.input-group-lg.pb-2
    input#projectCodeInputJoinDash.form-control(
      name="ProjectCodeInput",
      [formControl]="codeForm.controls['projectCode']",
      type="text",
      style="text-align: center;",
      placeholder="🔑 Code",
      aria-describedby="add-project-code"
    )
    .input-group-append
      button#buttonJoinProject.btn.btn-primary(
        [class.loading]="joinLoading",
        type="submit",
        name="Join",
        href="#"
      ) Join
  .alert.alert-info(*ngIf="!codeForm.controls['projectCode'].pristine && codeForm.controls['projectCode'].hasError('required')")
    strong([innerHtml]="':zap: Code' | emojione")
    | Enter a lightning code to quickly join a project!
  .alert.alert-danger(*ngIf="errorObject.wrongCode") {{errorObject.wrongCode}}
//- Main content row
.row
  .col-12.col-sm-3
    .mb-2
      .btn.btn-filter(
          [innerHtml]="':sparkles: Recently Created' | emojione",
          [class.active]="activeFilter === 'recent'",
          (click)="loadFilter('recent')"
        )
  .col-12.col-lg-6.col-md-9.col-sm-6.item-list.joined-list
    //- Show messaging if no Projects exist
    .alert.alert-info(role="alert", *ngIf="!loading && projects.length < 1 && !errorObject.projectError")
      h4.alert-heading No Joined Readings Yet...
      p Once you've joined someone else's Reading, it will show here.
    //- Show loading until Projects call gets back
    .row.loading(*ngIf="loading")
    .alert.alert-danger(*ngIf="errorObject.projectError && projects.length < 1")
      strong Oh no!
      | &nbsp;{{errorObject.projectError}}
    ng-container(*ngFor="let project of projects")
      .list-item.list-item--button.project-card(
            [routerLink]="['/project', project._id]",
            [class.hide]="!project.createdAt",
            [class.archived]="project.archived"
          )
        .reading-icon.hide-for-archived
          span {{ project.reading && project.reading.title ? project.reading.title.substring(0,2) : '' }}
        .archived-icon.show-for-archived
          .icon.icon-folder
        .reading-title
          .reading-title--center-row
            h1.small {{ project.reading ? project.reading.title : ''}}
              span(*ngIf="project.reading && !project.reading.title")
                i Untitled
              span.reading-project--label {{project.label}}
        div(style="clear:both; line-height: 18px; padding: 10px 0px 0px;")
          span(style="color: #cdcdcd; margin-right: 5px;") Created by:
          follow-tag(*ngIf="project.teacher", [owner]="project.teacher")
          pre.prj-code.text-code(style="margin-top: -5px; margin-bottom: 0px;") {{project.code || 'none'}}
    <p-paginator [rows]="rows" [totalRecords]="total" (onPageChange)="loadJoinedFeed($event)"></p-paginator>
