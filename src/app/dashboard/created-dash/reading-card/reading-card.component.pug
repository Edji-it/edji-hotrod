.list-item.list-item--block.reading-card(
  [ngClass]="{'draft-edit' : (reading['draft']), 'archived': (reading.archived) }"
)
  .reading-icon.hide-for-archived
    span {{reading.title.substring(0,2)}}
  .archived-icon.show-for-archived
    .icon.icon-folder
  .reading-title([class.no-version]="!reading.parent_id")
    .reading-title--center-row(
      *ngIf="reading['draft']",
      [routerLink]="['/new-reading/' + reading._id]"
    )
      h1.small.reading-title__text {{reading.title}} 
        span(*ngIf="!reading.title")
          i Untitled
    .reading-title--center-row(
      *ngIf="!reading['draft']", 
      [attr.testVersionNumber]="reading.title"
    )
      h1.small.reading-title__text {{reading.title}} 
        span(*ngIf="!reading.title")
          i Untitled
      p.reading-details(
        *ngIf="reading.parent_id"
      ) 
        span.reading-date {{ reading.createdAt | edjidate:'timeAgo':null }} &nbsp;
        span.reading-version((click)="getVersions(reading.version_id)") 
          | Previous Versions
  i.icon.icon-draft.reading-draft(*ngIf="reading['draft']")
  //- The Dropdown Options Menu
  #optionsWrap.dropdown.reading-options(
    *ngIf="!readOnly && (!reading['draft'] || reading.draft !== true || reading.projects[0])", 
    [class.show]="showOptions"
  )
    button.btn.btn-icon--plain(
      (click)="showOptions = !showOptions", 
      [attr.data-test]="'options-'+reading.title"
    )
      i.icon.icon-more
    //- dropdown buttons
    .dropdown-menu.dropdown-menu-right.reading-card-menu([class.show]="showOptions")
      //- Create New Group dropdown button
      button.dropdown-item.e2e-new-group(
        (click)="relevantReading = reading; showAddModal = true; showOptions = false;",
        [attr.testFindCreateNewGroup]="reading.title",
        [disabled]="reading.archived"
      ) 
        .icon.icon-plus
        | &nbsp; Create New Group
      //- Copy & Edit dropdown button
      button.dropdown-item(
        (click)="showOptions=false;", 
        [routerLink]="['/new-reading/']", 
        [queryParams]="{ copyId: reading._id }",
        [attr.testFindCopyAndEdit]="reading.title"
      ) 
        .icon.icon-create
        | &nbsp; Copy and Edit
      //- Reading Link dropdown button
      button.dropdown-item.e2e-reading-link(
        (click)="showOptions=false; showReadingLinkModal=true",
        [attr.testReadingLink]="reading.title"
      ) 
        .icon.icon-reading-link
        | &nbsp; Reading Link
      //- Delete dropdown button
      button.dropdown-item(
        (click)="relevantReading = reading; showDeleteReadingModal = true; showOptions = false;", 
        [attr.data-test]="'delete-'+reading.title"
      ) 
        .icon.icon-delete
        | &nbsp; Delete
  .reading-data(*ngIf="!reading['draft']")
    //- Subject Tags
    .tag-row.w-75
      ng-container(*ngIf="reading.subjects && reading.subjects.length > 0")
        span.badge-pill.badge-secondary.badge-subject(*ngFor="let subject of reading.subjects") {{ subject | subjectName }}
      ng-container(*ngIf="gradeDisplay")
        span.badge.badge-grades(title="Grade levels") {{ gradeDisplay }}
    //- Reading action buttons
    .w-25.reading-action-row(*ngIf="!readOnly")
      //- Source Link
      a.btn.btn-icon--round.reading-action(
        *ngIf="reading.source", 
        [attr.href]="reading.source", 
        title="Source", 
        target="_blank"
      )
        i.icon.icon-link
      //- Private/Public Toggle
      #togglePublic.btn.btn-icon--round.reading-access-icon.reading-action(
        [attr.title]="reading.public ? 'Public Reading' : 'Private Reading'", 
        (click)="togglePublicTooltip()",
        [class.access-icon__hover]="_route.snapshot.routeConfig.path!='discover'",
        [class.disabled]="reading.archived",
        [attr.testFindTogglePublic]="reading.title"
      )
        i#readingPublic.icon(*ngIf="reading.public", [innerHTML]="':earth_americas:' | emojione")
        i#readingPrivate.icon(*ngIf="!reading.public", [innerHTML]="':lock:' | emojione")
        .tooltip-wrap
          .tooltip.tooltip--interactive([class.show]="togglePublicFlag", [class.no-link]="!reading.source")
            .tooltip-title
              | Make public for others to Discover?
            .tooltiptext.block-with-text
              //- Public option
              label#readingMakePublic.form-check-label.form-check-btn(
                  [class.active]="reading.public",
                  title="Allow anyone to find this Reading in Discover",
                  (click)="$event.stopPropagation(); togglePublic(true)"
                )
                span([innerHTML]="':earth_americas: Public' | emojione")
              //- Private option
              label#readingMakePrivate.form-check-label.form-check-btn(
                  [class.active]="!reading.public",
                  title="Hide this Reading from Discover",
                  (click)="$event.stopPropagation(); togglePublic(false)"
                )
                span([innerHTML]="':lock: Private' | emojione")
      //- Bookmark action
      .btn.btn-icon--round.reading-action.hover--tooltip(
        title="Bookmark",
        [class.hide]="reading.archived",
        [class.active]="reading.owner_bookmarked",
        [class.disabled]="!user.hero_status",
        (click)="user.hero_status && toggleBookmark(reading)"
      )
        i.icon.icon-bookmark.hide-inactive
        i.icon.icon-bookmark-off.hide-active
        .tooltip-wrap
          .tooltip.tooltip--interactive
            .tooltip-title(*ngIf="!user.hero_status") Bookmarking is available with <a class="link" [routerLink]="['/plans']">Hero</a>
            .tooltip-title(*ngIf="user.hero_status") {{ reading.owner_bookmarked ? "Bookmarked" : "Not Bookmarked" }}
  //- Delete Reading if Draft Button
  .btn--delete-project.icon-button.btn--delete-draft(*ngIf="reading['draft']", title="Delete Draft", (click)="$event.stopPropagation(); relevantReading = reading; showDeleteReadingModal = true;")
    span([innerHtml]="':x:' | emojione")
//- The Project Card
.list-item.list-item--button.project-card(
      *ngFor="let project of reading.projects", 
      [class.new-project]="project.new",
      [class.archived]="reading.archived",
      [class.read-only]="readOnly"
    )
  .row.project-row--right-pad([routerLink]="!readOnly ? ['/project', project._id] : []")
    .col-8
      //- Title
      //- IMPORTANT NOTE: had to move the project link here so that the delete project button would work. Otherwise it overlapped and both buttons pressed.
      .title
        .project-title-input
          span.reading-project--label([attr.testFindGroupLabel]="reading.title", [class.read-only]="readOnly")
            span(style="color: #cdcdcd;") Group:
            | &nbsp;{{project.label}}
          span.project-title-input__save((click)="updateProjectLabel(reading._id, reading.newLabel)", [innerHtml]="':white_check_mark:' | emojione")
      div(style="clear:both;")
        span.metadata {{ project.comment_count ? project.comment_count : 0 }} Comments
        span &nbsp;|&nbsp;
        span.metadata {{ project.student_count ? project.student_count : 0 }} Students
    .col-4.prj-btns.pull-right
      //- Project Code
      pre.prj-code.text-code(style="float:right;") {{project.code || 'none'}}
  //- Delete Project Button
  .btn--delete-project.icon-button(*ngIf="!readOnly", title="Delete Group", (click)="relevantProject = project; showDeleteProjectModal = true;")
    span([innerHtml]="':x:' | emojione")
//- Modals
//- hot-add-project-modal is opens when "Create New Group" under the dropdown is clicked
hot-add-project-modal(
  *ngIf="showAddModal", 
  [reading]="relevantReading",
  (groupSaved)="addGroup(relevantReading, $event)",
  (closeModal)="showAddModal = false"
)
//- hot-del-reading pops up when "Delete" is clicked underneath a Reading's dropdown menu
hot-del-reading(
  *ngIf="showDeleteReadingModal", 
  [reading]="relevantReading", 
  (deleteReading)="removeReading(relevantReading)", 
  (closeModal)="showDeleteReadingModal = false"
)
//- hot-del-project pops up when you cliock the delete button for a group
hot-del-project(
  *ngIf="showDeleteProjectModal",
  [project]="relevantProject",
  (closeModal)="showDeleteProjectModal = false"
)
//- Add data for making reading public
hot-discover-add-meta(
  [showModal]="showReadingDiscoverModal", 
  [reading]="reading",
  (closeModal)="showReadingDiscoverModal = false"
)
//- Reading link share modal
edji-reading-link(
  *ngIf="showReadingLinkModal", 
  [reading]="reading",
  [isCreator]="true",
  (closeModal)="showReadingLinkModal = false"
)