//- Created Readings View
.row
  .col-12.col-sm-6
    ng-container
      h1.no-flow Created Readings
        i.icon__tooltip(tooltipPosition="bottom", pTooltip="Readings are how you share content on Edji!")
          span.icon.icon-circle.icon-info  i
  .col-12.col-sm-6.text-right
    button#buttonNewReading.btn.btn-primary.new-reading-btn(*ngIf="user.type == 'temp'", (click)="showLoginReqModal = true") 
      | New Reading
      i.icon.icon-create.mr-0.icon--btn-inline
    button#buttonNewReading.btn.btn-primary.new-reading-btn(*ngIf="user.type != 'temp'", [routerLink]="['/new-reading']")
      | New Reading
      i.icon.icon-create.mr-0.icon--btn-inline
//- Main content row
.row
  .col-12.col-sm-3
    .mb-2
      .form-group
        .input-group.input-group([class.active]="isSearching")
          .input-group-prepend-icon((click)="searchInput.focus()")
            i.icon.icon-filter
          input#readingSearch.form-control(
            #searchInput,
            name="SearchTermInput", 
            [(ngModel)]="searchParams.searchTerm", 
            type="text", 
            style="text-align: left;", 
            placeholder="Find my Reading...",
            (keyup.enter)="updateSearchParams('search_term')"
          )
          .form-control-clear.form-control-clear--in-field.icon.icon-close(
              *ngIf="searchParams.searchTerm.length > 0",
              (click)="searchParams.searchTerm = ''; updateSearchParams(''); isSearching=false"
          )
      //- Recently Created
      .btn-filter-wrap
        button.btn.btn-filter(
          [class.active]="searchParams.createdCollection === 'recent'",
          (click)="searchParams.createdCollection = 'recent'; searchParams.first=0; updateSearchParams('filter_recent')"
        )
          .icon([innerHtml]="':sparkles:' | emojione")
          | Recently Created
      //- Bookmarks
      .btn-filter-wrap.hover--tooltip(style="position:relative;")
        button#bookmarksBtn.btn.btn-filter( 
          [class.active]="searchParams.createdCollection === 'bookmarked'",
          [class.disabled--not-hero]="!user.hero_status",
          (click)="searchParams.createdCollection = 'bookmarked'; searchParams.first=0; updateSearchParams('bookmarked')"
        )
          i.icon.icon-bookmark(style="vertical-align:middle;")
          | Bookmarks
        .tooltip-wrap(*ngIf="!user.hero_status")
          .tooltip.tooltip--interactive
            .tooltip-title Bookmarking is available with <a class="link" [routerLink]="['/plans']">Hero</a>
      //- Versions
      .btn-filter-wrap
        button.btn.btn-filter.active(
            *ngIf="searchParams.createdCollection === 'versions'",
            [innerHtml]="':books: Versions' | emojione", 
        )
    //- Promo content
    ng-container(*ngIf="!isSearching && !(user && user.isStudent)")
      .card.my-4.hidden-sm-down
        .card-body.card-body--small.pt-1.px-3.pb-3
          .label.card-title From the Edji Guide
          p.card-text Get ideas and tips for your classroom:
          ul.link-list
            li(*ngFor="let guide of guideLinks")
              a.link(target="_blank", [href]="guide.url")
                | {{ guide.displayName }}
      .card.hidden-sm-down
        .card-body.card-body--small.pt-1.px-3.pb-1
          .label.card-title Discover Readings
          //- p.card-text Get ideas and tips for your classroom:
          .btn-filter-wrap.hover--tooltip(style="position:relative;")
            button#dashboardFilterStrategies.btn.btn-filter(
              title="Find strategy templates by Edji to get you started",
              [routerLink]="['/discover']",
              [queryParams]="{library: 'strategies'}"
            )
              i.icon.icon-strategies-sm(style="vertical-align:middle;")
              | Strategies
    .form-group(*ngIf="isSearching")
      label Try the Public Library
      .btn-filter-wrap
        button#publicSearch.btn.btn-filter( 
          title=`Search for ${searchParams && searchParams.searchTerm} on the discover feed`,
          (click)="updateSearchParams('', null, true)"
        )
          .icon([innerHTML]=`':earth_americas:' | emojione`) 
          | Search for "{{searchParams && searchParams.searchTerm}}"
  .col-12.col-sm-6.item-list.created-list([ngClass]="['page-'+pageNo]")
    ng-container(*ngIf="isSearching && !loading")
      .found__readings
        span Found <b id="searchCount">{{ total || 0 }}</b> readings for "{{lastSearchTerm}}"&nbsp;
        a.link(
          *ngIf="filterCount > 0",
          tabindex="0", 
          (click)="clearFilterVars(true); searchParams.searchTerm=''; updateSearchParams(''); isSearching=false",
          title="Click to clear"
        ) 
          |with {{ filterCount }} filters
          i.icon.icon-close.mx-1
      br
    <p-paginator [class.disabled]="paginationDisabled" [rows]="rows" [first]="searchParams.first" [totalRecords]="total" (onPageChange)="updateSearchParams('feed_paginate', $event)"></p-paginator>
    .mb-4
    //- Show readings with date values
    .alert.alert-info(role="alert", *ngIf="!isSearching && !loading && readings.length < 1 && !searchAlerts.serverError && searchParams.createdCollection === 'recent'")
      quick-start-flag
      //- @todo enable with more templates
      //- .row(*ngIf="!templateChoices")
      //-   .col-8
      //-     h2.alert-heading Get Started with a Simple Lesson
      //-     p To kick things off, let's create a simple lesson that you can use with your students as a short activity or keep as an example.
      //-   .col-4.text-right
      //-     img(src="/assets/images/guide/new-reading.png")
      //-   .col-12
      //-     p.font-weight-bolder I primarily teach...
      //-     label.form-check-label.form-check-btn(
      //-       *ngFor="let cohort of cohortOptions; let i = index",
      //-       [class.active]="cohortChoice === cohort",
      //-       [attr.data-test]="'gradesOption' + i",
      //-       (click)="_analytics.event('onboarding_chooseReading_gradesSelected', cohort.label)"
      //-     )
      //-       input.form-check-input(
      //-           type="radio",
      //-           name="cohort.label",
      //-           (change)="showTemplates(cohort, i)"                
      //-         )
      //-       span {{ cohort.label }}
      .row
        .col-12(data-test="templateChoices")
          h2.alert-heading Get Started with a Simple Lesson
          //- @todo enable with more templates
          //- p Great, we're excited to help you teach <i>{{cohortChoice.label}}</i>. 
          p To kick things off, let's create a simple lesson that you can use with your students as a short activity or keep as an example.
          p.font-weight-bolder Which of these would you like to try?
          .row.no-gutters.justify-content-center
            //- @todo loop through templateChoices when more templates are available
            .col-12.col-xl-6.template-link__wrap(*ngFor="let template of templates")
              a.template-link(
                [routerLink]="['/new-reading']",
                [queryParams]="{ 'copyId': template._id, 'guide':'welcome' }",
                data-test="templateChoice",
                (click)="_analytics.event('onboarding_chooseReading_templateSelected', template.title)"
              )
                span([innerHtml]="template.title | emojione")
                p.text-muted.small([innerHtml]="template.note")
        .col-12
          //- @todo enable with more templates
          //- .btn.btn-link.no-margin((click)="templateChoices = null", tabindex="0")
          //-   i.icon.icon-caret.left
          //-   | Back
        //- .col-lg-7
        //-   h4.alert-heading Create your first reading!
        //-   p Watch Will show you the basics of creating a Reading to get you started.
        //- .col-lg-5.nopadding.text-center
        //-   .guide-video-thumb((click)="showNewReadingVideoModal = true")
        //-     .icon.icon-play
        //-     img(src="/assets/images/thumbnail-first-reading.jpg")
      //- https://youtu.be/GPB8i8H8IBc
    .alert.alert-danger.alert-readings(*ngIf="errorObject.serverError || searchAlerts.serverError", role="alert")
      b Error Loading Readings
      | There was an error loading your readings. Please try again later or <a href="mailto:support@edji.it" target="_blank" class="link">contact support</a>.
    //- No results message when user is genuinely searching
    .alert.alert-info(*ngIf="searchAlerts.noResults && user.hero_status")
      b No Readings Found
      | There are no readings for "{{searchParams.searchTerm}}" with your current filters, please try a different term or expanding your filters. 
    //- Bookmarked: No Readings message
    .alert.alert-info.alert-readings(*ngIf="!isSearching && !loading && readings.length < 1 && searchParams.createdCollection === 'bookmarked'")
      b No Bookmarked Readings
      p You do not currently have any Created Readings bookmarked!
    .row.loading.e2e-reading-loader(*ngIf="loading")
    //- Sub headings for specific cases
    .row(*ngIf="activeFilter === 'versions'")
      .col-12        
        h2.w-100.center Versions of &#8220;{{ activeFilterValue }}&#8221;
    ng-container(*ngFor="let reading of readings; index as i")
      //- Mark beginning of archived readings
      .divider--alert(*ngIf="reading.archivedBegin")
        .alert.small
          .icon.icon-folder
          b Recently Archived Readings
      //- Legacy Readings Header
      .float-left.w-100(*ngIf="readings[i - 1] && readings[i - 1].archivedEnd")
        h2.center Legacy Readings
          i.icon__tooltip(tooltipPosition="bottom", pTooltip="Your Readings created before 2019")
            span.icon.icon-circle.icon-info  i
      hot-reading-card(style="margin-bottom: 30px; float:left; width:100%;", [reading]="reading")
      //- Mark beginning of archived readings
      .divider--alert(*ngIf="reading.archivedEnd")
        .archived-fade--above
        .alert
          .hero-h.mr-1 H
          b Access all Archived with Hero
          p.pl-4 With Hero, you support Edji’s continued development and can have unlimited active Readings - including your currently archived!
          .btn-row.right
            a.btn.btn-hero.btn-sm([routerLink]="['/plans']") Go Hero
    ng-container(*ngIf="isSearching && !user.hero_status")
      .divider--alert
        .archived-fade--above.searching
        .alert
          .hero-h.mr-1 H
          b Find any of your Readings with Hero
          p.pl-4 With Hero, you support Edji’s continued development and can have unlimited active Readings - including your currently archived!
          .btn-row.right
            a.btn.btn-hero.btn-sm([routerLink]="['/plans']") Go Hero
    <p-paginator [class.disabled]="paginationDisabled"  [rows]="rows" [first]="searchParams.first" [totalRecords]="total" (onPageChange)="updateSearchParams('feed_paginate', $event)"></p-paginator>
  .col-12.col-sm-3
    h2 Drafts
    .draft-card__wrap(*ngFor="let draft of drafts", [class.action-active]="draft.loading")
      .draft-card([routerLink]="['/new-reading/' + draft._id]")
        .icon.icon-lg.icon-create
        .h2.draft-card__title {{ draft.title }}
        p.draft-card__date Last edited {{ draft.updatedAt | edjidate:'timeAgo':null }}
      .draft-card__action.icon-button.e2e-draft-delete(title="Delete draft", (click)="deleteDraft(draft); draft.loading = true")
        span(*ngIf="!draft.loading", [innerHtml]="':x:' | emojione")
        .icon.icon-loading(*ngIf="draft.loading")

hot-login-req(*ngIf="showLoginReqModal", (closeModal)="showLoginReqModal = false")
.modal.show(*ngIf="showNewReadingVideoModal", (click)="showNewReadingVideoModal = false")
  .modal-dialog.modal-video
    button.close(aria-label="close", (click)="showNewReadingVideoModal = false")
      span &times;
    .modal-content
      .modal-body
        .embed-responsive.embed-responsive-16by9
          iframe.embed-responsive-item(
              src="//www.youtube.com/embed/GPB8i8H8IBc",
              frameborder="0",
              allow="autoplay; encrypted-media"
              allowfullscreen
          )
