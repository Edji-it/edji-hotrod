//- Created Readings View
.row.hidden-sm-down
  .col-sm-6
    h1.no-flow Created Readings
      i.icon__tooltip(tooltipPosition="bottom", pTooltip="Readings are how you share content on Edji!")
        span.icon.icon-circle.icon-info  i
  .col-sm-6
    button#buttonNewReading.btn.btn-primary.new-reading-btn(*ngIf="user.type == 'temp'", (click)="showLoginReqModal = true") 
      | New Reading
      i.icon.icon-create.mr-0.icon--btn-inline
    button#buttonNewReading.btn.btn-primary.new-reading-btn(*ngIf="user.type != 'temp'", [routerLink]="['/new-reading']")
      | New Reading
      i.icon.icon-create.mr-0.icon--btn-inline
.row.hidden-md-up
  button#buttonNewReadingMobile.btn.btn-primary.new-reading-btn([routerLink]="[ '/new-reading' ]") 
    | New Reading
    i.icon.icon-create.mr-0.icon--btn-inline
//- Main content row
.row
  .col-12.col-sm-3
    .mb-2
      .btn.btn-filter(
          [innerHtml]="':sparkles: Recently Created' | emojione", 
          [class.active]="activeFilter === 'recent'",
          (click)="loadFilter('recent')"
        )
      .btn.btn-filter(
          [innerHtml]="':bookmark: Bookmarked' | emojione", 
          [class.active]="activeFilter === 'bookmarked'",
          (click)="loadFilter('bookmarked')"
        )
    .card.my-4
      .card-body.card-body--small.pt-1.px-3.pb-3
        h5.card-title From the Edji Guide
        p.card-text Get ideas and tips for your classroom:
        ul.link-list
          li(*ngFor="let guide of guideLinks")
            a.link(target="_blank", [href]="guide.url")
              | {{ guide.displayName }}
  .col-8.col-sm-6.item-list.created-list([ngClass]="['page-'+pageNo]")
      //- Show readings with date values
      .alert.alert-info.alert-dismissible(role="alert", *ngIf="!loading && readings.length < 1 && !errorObject.readingError")
        .row
          .col-lg-7
            h4.alert-heading Create your first reading!
            p Watch Will show you the basics of creating a Reading to get you started.
          .col-lg-5.nopadding.text-center
            .guide-video-thumb((click)="showNewReadingVideoModal = true")
              .icon.icon-play
              img(src="/assets/images/thumbnail-first-reading.jpg")
        //- https://youtu.be/GPB8i8H8IBc
      .alert.alert-danger.alert-readings(*ngIf="errorObject.readingError", role="alert") {{ errorObject.readingError }}
      .row.loading(*ngIf="loading")
      hot-tutorial-reading(*ngIf="!loading && readings.length < 1 && !errorObject.readingError && user.type !=='temp'")
      ng-container(*ngFor="let reading of readings")
        //- Mark beginning of archived readings
        .divider--alert(*ngIf="reading.archivedBegin")
          .alert.small
            .icon.icon-folder
            b Recently Archived Readings
        hot-reading-card(style="margin-bottom: 30px; float:left; width:100%;", [reading]="reading")
        //- Mark beginning of archived readings
        .divider--alert(*ngIf="reading.archivedEnd")
          .archived-fade--above
          .alert
            .hero-h.mr-1 H
            b Access all Archived with Hero
            p.pl-4 With Hero, you support Edji’s continued development and can have unlimited active readings - including your currently archived!
            .btn-row.right
              a.btn.btn-hero.btn-sm([routerLink]="['/hero']") Go Hero
      <p-paginator [rows]="rows" [totalRecords]="total" (onPageChange)="loadCreatedFeed($event)"></p-paginator>
  .col-4.col-sm-3
    h2 Drafts
    .draft-card(*ngFor="let draft of drafts", [routerLink]="['/new-reading/' + draft._id]")
      .icon.icon-lg.icon-create
      .h2.draft-card__title {{ draft.title }}
      p.draft-card__date Last edited {{ draft.updatedAt | edjidate:'timeAgo':null:secondsAgo }}

hot-login-req(*ngIf="showLoginReqModal", (closeModal)="showLoginReqModal = false")
.modal.show(*ngIf="showNewReadingVideoModal")
  .modal-dialog.modal-video
    button.close(aria-label="close", (click)="showNewReadingVideoModal = false")
      span &times;
    .modal-content
      .modal-body
        .embed-responsive.embed-responsive-16by9
          iframe.embed-responsive-item(
              src="//www.youtube.com/embed/GPB8i8H8IBc",
              frameborder="0",
              allow="autoplay; encrypted-media"
              allowfullscreen
          )
      