//- This is a simplified version of the reading card which is assumed to be a draft
.list-item.list-item--block.reading-card.draft-edit([routerLink]="['/new-reading']", [queryParams]="{ copyId: reading._id }")
  .reading-icon
    span {{reading.title.substring(0,2)}}
  .reading-title
    .reading-title--center-row
      h1.small {{reading.title}}
        span(*ngIf="!reading.title")
          i Untitled
      p.blockquote-footer(
        *ngIf="reading.version_count && reading.version_count > 0", 
        [attr.testVersionNumber]="reading.title"
      ) Version {{reading.version_count > 0 ? reading.version_count : '' }}
  i.icon.icon-draft