.audio-comment-input-wrapper.input-wrap(
  [ngClass]="[comment.active ? 'active' : '', reply ? 'reply-display' : '']"
)
  //- .audio-btn-wrap([class.fade-out]="!comment.active")
    //- [class.disabled]="isRecording() || isLoading()"
    //- Play
  button#audioPlay.btn-audio(
      *ngIf="!isPlaying() && !isLoading()",
      (click)="play()",
      [class.disabled]="!isPlayable()"
    )
    i.icon-play
    //- Pause
  button#audioPause.btn-audio(
    *ngIf="isPlaying()",
    (click)="pause()"
  )
    i.icon-pause
  //- Loading
  button#audioLoading.btn-audio(
    *ngIf="isLoading()"
  )
    i.icon-loading
  //- Restart Playback
  button#audioRestart.btn-audio(
    [class.disabled]="!isPlayable()",
    (click)="restartPlayback()"
  )
    i.icon-restart
  //- Record
  button#audioRecord.btn-audio.btn-record(
    *ngIf="!(userPermission <= 3)",
    (click)="isRecording() ? stopRecord() : record()",
    [class.disabled]="isLoading() || isPlaying()",
    [class.active]="isRecording()"
  )
    i.icon([ngClass]="[ isRecording() ? 'icon-stop' : 'icon-mic']")
  //- Waveform
  .wave-wrap()
    //- [style.width]="getCalcWidth()"
    canvas.wave-form
    //- (click)="setPlaybackTime($event)"
    //- Check for countdownText so "null" does not show in Edge
    .countdown(*ngIf="countdownText[countdownI]", [innerHtml]="countdownText[countdownI]")
    .playhead(
        *ngIf="isPlaying() || isRecording()",
        [class.recording]="isRecording()",
        [style.minWidth]="playheadPos + '%'"
      )
.popover.popover--attach-bottom.fade([class.show]="confirmClear")
  .popover-content.text-center
    p.small Do you really want to clear this recording?
    .btn.btn-secondary.btn-sm.mr-2((click)="confirmClear = false") Cancel
    .btn.btn-hero.btn-sm((click)="clearRecording()") Clear
