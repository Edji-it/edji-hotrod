.audio-comment-input-wrapper.input-wrap(
  [ngClass]="[comment.active ? 'active' : '', reply ? 'replyDisplay' : '']"
)
  .audio-btn-wrap([class.fade-out]="!comment.active")
    //- [class.disabled]="isRecording() || isLoading()"
    button#audioPlay.btn-audio(
        *ngIf="!isPlaying() && !isLoading()", 
        (click)="play()"
      )
      i.icon-play
    button#audioPause.btn-audio(
      *ngIf="isPlaying()", 
      (click)="pause()"
    )
      i.icon-pause
    button#audioPause.btn-audio(
      *ngIf="isLoading()"
    )
      i.icon-loading
    button#audioRestart.btn-audio(
      [class.disabled]="!isPlayable()", 
      (click)="restartPlayback()"
    )
      i.icon-restart
    button#audioRecord.btn-audio.btn-record(
      [class.hide]="userPermission <= 3", 
      (click)="isRecording() ? stopRecord() : record()", 
      [class.disabled]="!isInactive() && !isRecording()",
      [class.active]="isRecording()"
    )
      i.icon([ngClass]="[ isRecording() ? 'icon-stop' : 'icon-mic']")
  .wave-wrap([style.width]="getCalcWidth()")
    canvas.wave-form((click)="setPlaybackTime($event)")
    //- Check for countdownText so "null" does not show in Edge
    .countdown(*ngIf="countdown", [innerHtml]="countdownText[countdownI] ? countdownText[countdownI] : ''")
    .playhead(
        *ngIf="isPlaying() || isRecording()",
        [class.recording]="isRecording()",
        [style.width]="playheadPos + 'px'"
      )
    //- .playing(*ngIf="audio && !isPlaying()", [class.hide]="!comment.active && (isRecording() || !audio.currentTime)", [style.width]="pausedWidth + 'px'")
