.emojionearea([ngClass]='{ active: isActive }')
	.emojionearea-picker.emojionearea-picker-position-bottom.emojionearea-filters-position-top
		.emojionearea-wrapper
			.emojionearea-filters
				i.emojionearea-filter(*ngFor='let category of emojifilters; let i = index', [attr.title]='category.title', [innerHtml]='category.icon | emojione', (tap)='goToCategory(i)', [ngClass]="{ 'below-scroll': category['scrollY'] >= scrollAreaOffset }")
				i#keyboardDoneBtn.keyboard-btn((tap)='makeInactive()', style='float: right;')
					| Close
			.emojionearea-scroll-area(#emojiScrollArea, (window:resize)='updateScrollValues()', (scroll)='scrollUpdate($event)')
				.input-group.input-group-sm.input--emoji-search
					.input-group-prepend-icon
						i.icon.icon-search
					input.form-control(
						type="text",
						[(ngModel)]="searchTerm",
						(keyup)="getEmojiResults(searchTerm)",
						placeholder="Search emoji"
					)
					.form-control-clear.form-control-clear--in-field.icon.icon-close(
            *ngIf="searchTerm",
            (tap)="searchTerm = ''"
          )
				.emojionearea-emojis-list(*ngIf="searchTerm")
					.emojionearea-category#categorySearch
						i.emojibtn(*ngFor='let emoji of emojiResults', (tap)="addEmoji(':' + emoji + ':')", role='button', [attr.dataname]="':' + emoji + ':'", [innerHtml]="':' + emoji + ':' | emojione")
				.emojionearea-emojis-list
					//- slice: Reduce tap bindings and image load when keyboard is not active
					.emojionearea-category(*ngFor='let category of emojifilters | slice:0:(isActive ? filtersLastIndex : 2); let i = index', [attr.id]="'category' + i")
						h1 {{ category.title }}
						//- We use click here because the tap event interferes with scroll on an iPad 2
						i.emojibtn(*ngFor='let emoji of category.emoji', (tap)="addEmoji(':' + emoji + ':')", role='button', [attr.dataname]="':' + emoji + ':'", [innerHtml]="':' + emoji + ':' | emojione")
