doctype html
.text-comment.input-wrap([ngClass]="[activated ? 'active' : '']")
  //- Comment Input
  textarea.text-comment-input(
    #textInput,
    type='text', 
    placeholder="Text comment...", 
    [class.disabled]="readOnly",
    [(ngModel)]="comment.data", 
    (blur)='updateComment(comment)', 
    (keydown.enter)='blurField($event)', 
    (keydown.shift.enter)='blurField($event)', 
    (keyup.esc)='blurField($event)', 
    [ngClass]="{ 'replyDisplay': reply, 'disabled': readOnly, 'hide': !activated }",
    [style.minHeight]="textareaHeight"
  )
  //- Comment Display
  #textCommentInput.text-comment-input(
    #textDisplay,
    [innerHtml]="comment.data | linkify | emojione", 
    [ngClass]="{ 'replyDisplay': reply, 'hide': activated }",
    (tap)="clickToggleActive($event)"
  )