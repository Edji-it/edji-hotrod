#comment.comment.hidden-md-down(
    [class.new]="comment.new",
    [class.saved]="justSaved",
    [class.active]="active",
    [class.readonly]="readOnly",
    [ngClass]="[ expanded ? 'expanded' : '', reply ? 'replyComment comment__force-display' : 'hidden-md-down line-count-' + lineCount ]"
)
    .expand-comments(
        *ngIf="!commentLite",
        (tap)='expanded ? collapse() : expand()',
        [ngClass]="comment.type == 'emoji' ? 'cmtEmoji' : 'cmtText'"
    )
        .hidden-lg-up.expand__arrow-left(*ngIf="lineCount == 1 && expanded")
    .comment-username(
        *ngIf='comment.author && !commentLite',
        [ngClass]="[ reply ? 'replyUsername' : '' ]"
    )
        | {{ comment.author }}
        .comment__time.text-right(*ngIf="reply && replyRef") &nbsp;{{ comment.createdAt | edjidate:'timeAgo':null:secondsAgo }}
        .comment__time.text-right(*ngIf="reply && !replyRef") &nbsp;{{ comment.updatedAt | edjidate:'timeAgo':null:secondsAgo }}
    .comment__avatar(*ngIf="comment.author",[class.show]="comment.showAvatar || reply") {{comment.author.substr(0,2).toUpperCase()}}
    .comment-input-wrapper([ngClass]="[ replyRef ? 'replyCommentHandler' : '' ]")
        //- Swap between different comment types
        emoji-comment(
            *ngIf="comment.type == 'emoji' || !comment.type",
            [comment]="comment",
            [reply]="reply",
            (activate)="activate()",
            (deactivate)="deactivate(comment)"
        )
        text-comment(
            *ngIf="comment.type == 'text'",
            [readOnly]="readOnly",
            [comment]="comment",
            [active]="comment.active",
            [reply]="reply",
            (activate)="activate()",
            (deactivate)="deactivate(comment, $event)"
        )
        audio-comment(
            *ngIf="comment.type == 'audio'",
            [comment]="comment",
            (save)="deactivate(comment)",
            [active]="comment.active",
            [recordNewAudio]="reRecordAudio",
            (showDeleteAudioModal)="showDeleteAudioModal = true",
            [userPermission]="userPermission",
            [reply]="reply"
        )
        button#commentDelBtn.inline-delete(
            *ngIf="userPermission >= 3",
            (tap)="userPermission > 3 ? deleteComment(comment) : showDeleteModal = true"
        ) 
            | +
        .reply#addReply(
            *ngIf="!reply && project.types.indexOf('reply') > -1",
            (click)="commentReply.emit()"
        )
            p.text-left.reply-text-left Reply
            .text-right
                p.reply-text-right {{ repliesById[comment._id] && repliesById[comment._id].length }}
                img.reply-icon(src="assets/images/icon-comment-white.svg")
    //- END .comment-input-wrapper          
    .comment__save(
        *ngIf="comment.active",
        (tap)="deactivate(comment)",
        [innerHtml]="':white_check_mark:' | emojione"
    )
    i.comment__saved([innerHtml]='":ok_hand:" | emojione')
//- END .comment - desktop

div(*ngIf="commentPaneActive")
    hr.mobileBlock-hr(*ngIf="commentMobile && !commentMobileFirst")
    .comment-action--save.comment-action--save__mobile.comment-action--save__mobile-btn(
        *ngIf="comment.active",
        (tap)="deactivate(comment)",
        [innerHtml]="':white_check_mark:' | emojione"
    )
    #comment.comment.hidden-lg-up.mobileBound(
        [class.new]="comment.new",
        [class.saved]="justSaved",
        [class.active]="comment.active",
        [class.readonly]="readOnly",
        [ngClass]="[ commentMobile ? 'mobileBlock-mobile-comment' : '' ]"
    )
        .user-icon([ngClass]="[ commentMobile ? 'mobileBlock-mobile-comment' : '' ]")
            span {{comment.author.substring(0,2)}}
        .mobileBlock([ngClass]="[ commentMobile ? 'mobileBlock-mobile-comment' : '' ]")
            .list-item.list-item--block.mobileTime-card
                | {{comment.author}}
                span.mobileTime-card__time &nbsp;{{ comment.createdAt | edjidate:'timeAgo':null:secondsAgo }}
            .comment-input-wrapper
                emoji-comment(
                    *ngIf="comment.type == 'emoji' || !comment.type",
                    [comment]="comment",
                    [reply]="reply",
                    (activate)="activate()",
                    (deactivate)="deactivate(comment)"
                )
                text-comment(
                    *ngIf="comment.type == 'text'",
                    [readOnly]="readOnly",
                    [comment]="comment",
                    [active]="comment.active",
                    [reply]="reply",
                    (activate)="activate()",
                    (deactivate)="deactivate(comment, $event)"
                )
                audio-comment(
                    *ngIf="comment.type == 'audio'",
                    [comment]="comment",
                    (save)="deactivate(comment)",
                    [active]="comment.active",
                    [recordNewAudio]="reRecordAudio",
                    (showDeleteAudioModal)="showDeleteAudioModal = true",
                    [userPermission]="userPermission",
                    [reply]="reply"
                )
            //- Text that was commented on
            .list-item.list-item.mobileHighlight-card.h-1(*ngIf="!isImage")
                | {{ comment.text ? comment.text : '...'}}
            //- Image comment handling
            .list-item.list-item.mobileHighlight-card_liImage.h-1(*ngIf="isImage")
                .mobileHighlight-card_image Image
            //- button.mobileHighlight-card_button((tap)="getImagePos(comment.start)") View&nbsp;&#8594;
    //- Comment action buttons
    .comment-action--block.row
        .col-6.float-left.btn-float-left__sm
            button.btn.btn-sm.btn-hero(*ngIf="userPermission >= 3", (tap)="userPermission > 3 ? deleteComment(comment) : showDeleteModal = true") Delete
        .col-6.float-right.btn-float-right__sm
            //- button.btn.btn-sm.btn-primary(*ngIf="repliesById[comment._id] && repliesById[comment._id].length>0", (tap)="commentReply.emit(comment)") Replies ({{ repliesById[comment._id] && repliesById[comment._id].length }})
            button.btn.btn-sm.btn-primary((tap)="commentReply.emit(comment)") Replies ({{ repliesById[comment._id] && repliesById[comment._id].length || '0' }})
            //- button.btn.btn-sm.btn-primary(ngIf="!repliesById[comment._id]", (tap)="commentReply.emit(comment)") Reply
//- END .comment - mobile

//- Mobile Icon
div((tap)='toggleCPane(comment)')
    img.comment__button--mobile(
        src="assets/images/icon-comment.svg",
        [ngClass]="[ reply ? 'icon-hidden' : 'hidden-lg-up']"
    )
    .comment__count--mobile(
        *ngIf="commentByPos[_projects.lineNumberArray[comment.start]]"
    ) {{ commentByPos[_projects.lineNumberArray[comment.start]].length }}
hot-del-comment(
    *ngIf="showDeleteModal",
    [comment]="comment",
    (delete)="deleteComment(comment)",
    (closeModal)="showDeleteModal = false; commentDeactivate.emit(comment)"
)
hot-del-audio(
    *ngIf="showDeleteAudioModal",
    [comment]="comment",
    (delete)="reRecordAudio = true; showDeleteAudioModal = false",
    (closeModal)="showDeleteAudioModal = false"
)