//- Comment wrap
div([id]="'comment-' + comment._id")
    #comment.comment(
        [class.new]="comment.new",
        [class.saved]="justSaved",
        [class.active]="comment.active",
        [class.read-only]="userPermission < 5",
        [class.comment--reply]="reply || comment.reply_to",
        [class.comment--large]="largeDisplay",
        [ngClass]="[ readingReport ? 'comment-block--align-top':'' ]",
    )
        user-avatar(
            [userId]="comment.user_id",
            [size]="reply ? 'small' : 'medium'",
            [tempName]="comment.author",
            [selected]="selected",
            [class.comment__reply-avatar]="reply"
        )
        .user-icon__fullname(*ngIf="largeDisplay")
            a.link.comment--large__user-link(
                [routerLink]="['./']",
                [queryParams]="{ student: comment.user_id }"
            ) {{ comment.author }}
            a.link.sub-label(
              (click)="copyLink()",
              [class.is-draft]="_comments.isCommentNewDraft(comment)"
            )
              span.time-text--draft New
              span.time-text--date {{ comment.createdAt | edjidate:'timeAgo':null }}
              span.text-success(*ngIf="linkCopied") &nbsp;-&nbsp;Comment link copied!
        .comment-block(
          [class.comment-block--large]="largeDisplay",
          [class.comment-block--reading-recap]="readingReport"
        )
            .comment-meta(*ngIf="!readingReport && !largeDisplay")
                a.link.comment__user-link(
                  [routerLink]="['./']",
                  [queryParams]="{ student: comment.user_id }"
                )
                  | {{comment.author}}
                a.link.comment-meta__time(
                  [routerLink]="['./']",
                  [queryParams]="reply ? { reply: comment._id, comment: comment.reply_to } : { comment: comment._id }",
                  [class.is-draft]="_comments.isCommentNewDraft(comment)"
                ) &nbsp;
                    span.time-text--draft New
                    span.time-text--date {{ comment.createdAt | edjidate:'timeAgo':null }}
            .comment__content
                ng-container(*ngIf="!reply && !comment.reply_to")
                  //- Text that was commented on
                  .comment__highlight(*ngIf="!isImageSpot && !readingReport", data-test="commentAnnotatedText")
                      | {{ comment.text ? comment.text : '...'}}
                  //- Image comment handling
                  .comment__highlight(*ngIf="isImageSpot && !readingReport")
                      .comment__highlight_image Image
                      button.comment__highlight_button((tap)="scrollToImage(comment.start)") View&nbsp;&#8594;
                .reply-action-badge(*ngIf="!reply && comment.reply_to")
                  //- If not dispaying reply in context, provide a link
                  a.link.btn.btn-xs-action.btn--reply.has-icon(
                    [routerLink]="['./']",
                    [queryParams]="{ reply: comment._id, comment: comment.reply_to }"
                  )
                    | Reply
                    i.icon.icon-reply-arrow
                .comment-input-wrapper(
                  [ngClass]="[ comment.type + '' ]",
                  [class.input-wrapper--reply]="reply || comment.reply_to"
                )
                    //- emoji-comment(
                    //-     *ngIf="comment.type == 'emoji' || !comment.type",
                    //-     [comment]="comment",
                    //-     [readOnly]="userPermission < 5",
                    //-     [reply]="reply",
                    //-     (activate)="activate()",
                    //-     (deactivate)="deactivate(comment)"
                    //- )
                    text-comment(
                        [readOnly]="userPermission < 5",
                        [comment]="comment",
                        [active]="comment.active",
                        [reply]="reply",
                        (activate)="activate()",
                        (deactivate)="deactivate(comment, $event)"
                    )
                    .icon-group--in-field(*ngIf="userPermission >= 5 && !_comments.emojiActive")
                        .icon.icon-comment-emoji.hover--tooltip((click)="activateEmojiKeyboard()")
                            .tooltip-wrap
                                .tooltip
                                    .tooltip-title Add Emoji
                        .icon.icon-comment-audio.hover--tooltip(
                          *ngIf="comment.type !== 'audio'",
                          (click)="addAudio()"
                        )
                            .tooltip-wrap
                                .tooltip
                                    .tooltip-title Add Recording
                .comment-attachment-wrapper(*ngIf="comment.type == 'audio'")
                    audio-comment(
                        [comment]="comment",
                        (save)="deactivate(comment)",
                        [active]="comment.active",
                        [userPermission]="userPermission",
                        [reply]="reply",
                        [commentContext]="commentContext"
                    )
                    .icon-group--in-field
                        .icon.icon-close(*ngIf="userPermission >= 5", (click)="removeAudio()")
            //- Comment action buttons
            .comment__action-row.btn-row.left.mt-0(*ngIf="!readingReport", [class.reply-gap]="repliesShowing")
                ng-container(*ngIf="((!comment.data || comment.data=='') && (!comment.url || comment.url == '')) && !readingReport")
                    i.icon.icon-draft.icon-draft__comment
                ng-container(*ngIf="!readingReport && !reply && !comment.reply_to && project.types.indexOf('reply') > -1 && !((!comment.data || comment.data=='') && (!comment.url || comment.url == ''))")
                    button#addReply.btn.btn-xs-action.btn--reply.has-icon(
                        (tap)="repliesShowing = !repliesShowing",
                        [class.has-reply]="hasReplies(comment)",
                        [class.text-only]="repliesShowing"
                    )
                        i.icon.icon-reply-arrow
                        | {{ replyBtnText() }}
                ng-container(*ngIf="userPermission >= 3")
                    .action-separator
                    button.btn.btn-xs-danger.e2e-delete-button((tap)="userPermission > 3 ? deleteComment(comment) : _comments.deleteCommentConfirmation(comment, commentContext)") Delete
                ng-container(*ngIf="userPermission >= 5 && !comment.active")
                    .action-separator
                    button.btn.btn-xs-primary((tap)="activate(comment)") Edit
                ng-container(*ngIf="comment.active && userPermission >= 5 && !readingReport")
                    .action-separator
                    button.btn.btn-xs-action.has-icon((tap)="deactivate(comment)", data-test="commentSaveButton")
                        i.icon.icon-check
                        | Save
                ng-container(*ngIf="justSaved")
                    .btn.btn-xs-action.has-icon.ml-1.display-only
                        i.icon.icon-check
                        | Saved
    //- Display Replies
    ng-container(*ngIf="!reply && !comment.reply_to && repliesShowing")
      .replies
        .replies__header
          .arrow-wrap
            img.arrow-point(src="assets/images/reply-triangle.png")
            .arrow-line
        ng-container(*ngIf="repliesById[comment._id]")
          .comment-wrap-row(*ngFor="let replyComment of repliesById[comment._id] | sortByDate:'createdAt'")
            edji-comment.comment--replyBlock(
              *ngIf="replyComment.author",
              [comment]="replyComment",
              [commentContext]="'reply'",
              [isActive]="replyComment.active",
              [reply]="true",
              (commentActivation)="commentActivation($event, replyComment)",
              [attr.replyId]="replyComment._id"
            )
        //--Reply input--
        .reply-row
          user-avatar.comment__avatar.show([userDetails]="user")
          .reply-input__line
          .replyInput Add Reply
          //--Add reply buttons--
          .replyButtonGroup
            button#addEmojiReply.emoji(*ngIf="project.types.indexOf('emoji') > -1", (click)="addReplyOfType(comment, 'emoji')")
              i.icon.icon-comment-emoji
            button#addTextReply.emoji(*ngIf="project.types.indexOf('text') > -1", (click)="addReplyOfType(comment, 'text')")
              i.icon.icon-comment-text
            button#addAudioReply.emoji(*ngIf="project.types.indexOf('audio') > -1", (click)="addReplyOfType(comment, 'audio')")
              i.icon.icon-mic
