#comment.comment.hidden-md-down(
    [class.new]="comment.new",
    [class.saved]="justSaved",
    [class.active]="active",
    [class.readonly]="readOnly",
    [ngClass]="[ expanded ? 'expanded' : '', active ? 'comment__show' : '', reply ? 'replyComment' : 'hidden-md-down line-count-' + lineCount ]"
)
    .expand-comments(
        *ngIf="!commentLite",
        (tap)='expanded ? collapse() : expand()',
        [ngClass]="comment.type == 'emoji' ? 'cmtEmoji' : 'cmtText'"
    )
        .hidden-lg-up.expand__arrow-left(*ngIf="lineCount == 1 && expanded")
    .comment-username(
        *ngIf='comment.author && !commentLite',
        [ngClass]="[ reply ? 'replyUsername' : '' ]"
    )
        | {{ comment.author }}
        .comment__time.text-right(*ngIf="reply && replyRef") &nbsp;{{ comment.createdAt | edjidate:'timeAgo':null:secondsAgo }}
        .comment__time.text-right(*ngIf="reply && !replyRef") &nbsp;{{ comment.updatedAt | edjidate:'timeAgo':null:secondsAgo }}
    .comment__avatar(*ngIf="comment.author",[class.show]="comment.showAvatar || reply") {{comment.author.substr(0,2).toUpperCase()}}
    .comment-input-wrapper([ngClass]="[ replyRef ? 'replyCommentHandler' : '' ]")
        //- Swap between different comment types
        emoji-comment(
            *ngIf="comment.type == 'emoji' || !comment.type",
            [comment]="comment",
            [reply]="reply",
            (activate)="activate()",
            (deactivate)="deactivate(comment)"
        )
        text-comment(
            *ngIf="comment.type == 'text'",
            [readOnly]="readOnly",
            [comment]="comment",
            [active]="comment.active",
            [reply]="reply",
            (activate)="activate()",
            (deactivate)="deactivate(comment, $event)"
        )
        audio-comment(
            *ngIf="comment.type == 'audio'",
            [comment]="comment",
            (save)="deactivate(comment)",
            [active]="comment.active",
            [recordNewAudio]="reRecordAudio",
            (showDeleteAudioModal)="showDeleteAudioModal = true",
            [userPermission]="userPermission",
            [reply]="reply"
        )
        button#commentDelBtn.inline-delete(
            *ngIf="userPermission >= 3",
            (tap)="userPermission > 3 ? deleteComment(comment) : showDeleteModal = true"
        ) 
            | +
        .reply#addReply(
            *ngIf="!reply && project.types.indexOf('reply') > -1",
            (click)="commentReply.emit()"
        )
            p.text-left.reply-text-left Reply
            .text-right
                p.reply-text-right {{ repliesById[comment._id] && repliesById[comment._id].length }}
                img.reply-icon(src="assets/images/icon-comment-white.svg")
    //- END .comment-input-wrapper          
    .comment__save(
        *ngIf="comment.active",
        (tap)="deactivate(comment)",
        [innerHtml]="':white_check_mark:' | emojione"
    )
    i.comment__saved([innerHtml]='":ok_hand:" | emojione')
//- END .comment - desktop

#commentMobile.comment.hidden-lg-up(
    [class.new]="comment.new",
    [class.saved]="justSaved",
    [class.active]="active",
    [class.readonly]="readOnly",
    [ngClass]="[ active ? 'comment__show' : '' ]"
)
    .sliding-pane.from-left([ngClass]="[ commentPane ? 'slide-in' : '' ]")
        .container-fluid.container--less-pad
            p Line {{ lineNum }}
            h4(*ngIf="commentCount>1 || commentCount===0") {{ commentCount }} Comments
            h4(*ngIf="commentCount===1") {{ commentCount }} Comment
            button.close.stats-close-btn.btn-icon--round((click)="commentPane=false", type="button")
                span(aria-hidden="true") ×
            hot-firecard(*ngFor="let fireComment of _util.commentPosArray[_util.lineNumberArray[comment.start]]", [fireComment]="fireComment")
            .fireBound
                .fire-icon--light
                    span.s-emoji([innerHtml]="':seedling:' | emojione")
//- END .comment - mobile

//- Mobile Icon
div((tap)='commentPane ? collapseCommentPane() : expandCommentPane(comment)')
    img.comment__button--mobile(
        src="assets/images/icon-comment.svg",
        [ngClass]="[ reply ? 'icon-hidden' : 'hidden-lg-up']"
    )
    .comment__count--mobile(
        *ngIf="_util.commentPosArray[_util.lineNumberArray[comment.start]]"
    ) {{ _util.commentPosArray[_util.lineNumberArray[comment.start]].length }}
hot-del-comment(
    *ngIf="showDeleteModal",
    [comment]="comment",
    (delete)="deleteComment(comment)",
    (closeModal)="showDeleteModal = false; commentDeactivate.emit(comment)"
)
hot-del-audio(
    *ngIf="showDeleteAudioModal",
    [comment]="comment",
    (delete)="reRecordAudio = true; showDeleteAudioModal = false",
    (closeModal)="showDeleteAudioModal = false"
)