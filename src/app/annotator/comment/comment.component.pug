//- Other components that use a comment display like questions use this block for display and logic
#comment.comment.hidden-md-down(
    *ngIf="reply",
    [id]="'comment-' + comment._id",
    [class.new]="comment.new",
    [class.saved]="justSaved",
    [class.active]="active",
    [class.readonly]="readOnly",
    [ngClass]="[ comment.expanded ? 'expanded' : '', reply ? 'replyComment comment__force-display' : 'hidden-md-down line-count-' + indexOnLine ]"
)
    .expand-comments(
        *ngIf="!commentLite",
        (tap)='comment.expanded ? collapse() : expand()',
        [ngClass]="comment.type == 'emoji' ? 'cmtEmoji' : 'cmtText'"
    )
        .hidden-lg-up.expand__arrow-left(*ngIf="lineCount > 1 && comment.expanded")
    .comment-username(
        *ngIf='comment.author && !commentLite',
        [ngClass]="[ reply ? 'replyUsername' : '' ]"
    )
        | {{ comment.author }}
        .comment__time.text-right(*ngIf="reply && replyRef") &nbsp;{{ comment.createdAt | edjidate:'timeAgo':null }}
        .comment__time.text-right(*ngIf="reply && !replyRef") &nbsp;{{ comment.updatedAt | edjidate:'timeAgo':null }}
    .comment__avatar(*ngIf="comment.author",[class.show]="comment.showAvatar || reply", [class.selected]="comment.selected") {{comment.author.substr(0,2).toUpperCase()}}
    .comment-input-wrapper([ngClass]="[ replyRef ? 'replyCommentHandler' : '', comment.type + '' ]")
        //- Swap between different comment types
        emoji-comment(
            *ngIf="comment.type == 'emoji' || !comment.type",
            [readOnly]="readOnly",
            [comment]="comment",
            [reply]="reply",
            (activate)="activate()",
            (deactivate)="deactivate(comment)"
        )
        text-comment(
            *ngIf="comment.type == 'text'",
            [readOnly]="readOnly",
            [comment]="comment",
            [active]="comment.active",
            [reply]="reply",
            (activate)="activate()",
            (deactivate)="deactivate(comment, $event)"
        )
        audio-comment(
            *ngIf="comment.type == 'audio'",
            [comment]="comment",
            (save)="deactivate(comment)",
            [active]="comment.active",
            [userPermission]="userPermission",
            [reply]="reply",
            [commentContext]="commentContext"
        )
        .reply(
            *ngIf="!reply && project.types.indexOf('reply') > -1",
            (tap)="commentReply.emit()"
        )
            p.text-left.reply-text-left Reply
            .text-right
                p.reply-text-right {{ repliesById[comment._id] && repliesById[comment._id].length }}
                img.reply-icon(src="assets/images/icon-comment-white.svg")
    //- END .comment-input-wrapper          
    .comment__save(
        *ngIf="comment.active",
        (tap)="deactivate(comment)",
        [innerHtml]="':white_check_mark:' | emojione"
    )
    i.comment__saved([innerHtml]='":ok_hand:" | emojione')
    //- Comment action row
    .comment__action-row.btn-row.left.mt-0([class.reply-gap]="repliesShowing")
        button.btn.btn-xs-danger.e2e-delete-button(*ngIf="userPermission >= 3", (tap)="userPermission > 3 ? deleteComment(comment) : _comments.deleteCommentConfirmation(comment, commentContext)") Delete
        ng-container(*ngIf="comment.type != 'audio' && !readOnly && !comment.active")
            .action-separator
            button.btn.btn-xs-primary((tap)="activate(comment)") Edit
//- END the other component comment display

//- Comments that are displayed in the comment pane
hr.mobileBlock-hr(*ngIf="commentMobile && !commentMobileFirst && !readingReport")
div(*ngIf="commentPaneActive", [id]="'comment-' + comment._id")
    //- We are removing this dot indicator for now
    //- .comment-selected-highlight(*ngIf="comment && (comment.selected || comment.new)")
    //-     .comment-selected-dot__mobile
    #comment.comment.mobileBound(
        [class.new]="comment.new",
        [class.saved]="justSaved",
        [class.active]="comment.active",
        [class.readonly]="readOnly",
        [ngClass]="[ commentMobile ? 'mobileBlock-mobile-comment' : '' ]"
    )
        .comment-action--save.comment-action--save__mobile.comment-action--save__mobile-btn(
            *ngIf="comment.active && !readOnly && !readingReport",
            (tap)="deactivate(comment)",
            [innerHtml]="':white_check_mark:' | emojione"
        )
        .user-icon(
                *ngIf="!readingReport", 
                [class.selected]="comment.selected",
                [class.has-teacher-tag]="comment.authorIsTeacher", 
                [ngClass]="[ commentMobile ? 'mobileBlock-mobile-comment' : '' ]"
            )
            span.user-icon__initials {{comment.author.substring(0,2)}}
        .mobileBlock([ngClass]="[ commentMobile ? 'mobileBlock-mobile-comment' : '', readingReport ? 'mobileBlock--reading-recap' : '' ]")
            .list-item.list-item--block.mobileTime-card(*ngIf="!readingReport")
                | {{comment.author}}
                span.mobileTime-card__time([class.is-draft]="isCommentNewDraft(comment)") &nbsp;
                    span.time-text--draft New
                    span.time-text--date {{ comment.createdAt | edjidate:'timeAgo':null }}
            .comment-input-wrapper
                emoji-comment(
                    *ngIf="comment.type == 'emoji' || !comment.type",
                    [comment]="comment",
                    [readOnly]="readOnly",
                    [reply]="reply",
                    (activate)="activate()",
                    (deactivate)="deactivate(comment)"
                )
                text-comment(
                    *ngIf="comment.type == 'text'",
                    [readOnly]="readOnly",
                    [comment]="comment",
                    [active]="comment.active",
                    [reply]="reply",
                    (activate)="activate()",
                    (deactivate)="deactivate(comment, $event)"
                )
                audio-comment(
                    *ngIf="comment.type == 'audio'",
                    [comment]="comment",
                    (save)="deactivate(comment)",
                    [active]="comment.active",
                    (showDeleteAudioModal)="showDeleteAudioModal = true",
                    [userPermission]="userPermission",
                    [reply]="reply",
                    [commentContext]="commentContext"
                )
            //- Text that was commented on
            .list-item.mobileHighlight-card.h-1(*ngIf="!isImage && !readingReport")
                blockquote
                    | {{ comment.text ? comment.text : '...'}}
            //- Image comment handling
            .list-item.mobileHighlight-card_liImage.h-1(*ngIf="isImage && !readingReport")
                .mobileHighlight-card_image Image
            //- button.mobileHighlight-card_button((tap)="getImagePos(comment.start)") View&nbsp;&#8594;
            //- Comment action buttons
            .comment__action-row.btn-row.left.mt-0([class.reply-gap]="repliesShowing")
                ng-container(*ngIf="((!comment.data || comment.data=='') && (!comment.url || comment.url == '')) && !readingReport")
                    i.icon.icon-draft.icon-draft__comment
                ng-container(*ngIf="!readingReport && !reply && project.types.indexOf('reply') > -1 && !((!comment.data || comment.data=='') && (!comment.url || comment.url == ''))")
                    button#addReply.btn.btn-xs-action.btn--reply(
                        (tap)="toggleReplies()", 
                        [class.has-reply]="hasReplies(comment)",
                        [class.text-only]="repliesShowing"
                    )
                        i.icon.icon-reply-arrow
                        | {{ replyBtnText() }}
                ng-container(*ngIf="userPermission >= 3")
                    .action-separator
                    button.btn.btn-xs-danger.e2e-delete-button((tap)="userPermission > 3 ? deleteComment(comment) : _comments.deleteCommentConfirmation(comment, commentContext)") Delete
                ng-container(*ngIf="comment.type != 'audio' && !readOnly && !comment.active")
                    .action-separator
                    button.btn.btn-xs-primary((tap)="activate(comment)") Edit
//- END comment pane display

//- Handle Desktop and Mobile Icons for activating comments
avatar-portal(
    *ngIf="!reply && !readingReport",
    [comment]="comment",
    [lineCount]="lineCount",
    [indexOnLine]="indexOnLine",
    [isActive]="indicatesPane",
    [lineY]="comment.lineY",
    (toggleCommentPane)="toggleCPane(comment)",
    [ngClass]="['e2e-comment--'+comment.author.replace(' ', '-')]"
)