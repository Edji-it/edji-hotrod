//- Desktop Avatar Icons
.user-icon__wrap.pointer.hidden-sm-down(
  *ngIf="indexOnLine<9",
  (tap)='triggerCommentPane(true)',
  [ngClass]="['avatar-count-' + indexOnLine, 'avatar-' + comment.type]",
  [class.active]="active",
  [class.has-teacher-tag]="comment.authorIsTeacher",
  [class.pending]="loading",
  [class.draft]="_comments.isCommentNewDraft(comment)"
)
  .portal-scroll-adjust(#scrollEl)
  user-avatar(*ngIf="indexOnLine<8", [userId]="comment.user_id", [tempName]="comment.author")
  span.tooltipbody(*ngIf="indexOnLine<8")
    .tooltip-title([class.inline-center]="comment.type == 'audio'")
      | {{comment.author}}
    .tooltipblank(*ngIf="!comment.data && !loading")
      | Empty draft
    .tooltipblank(*ngIf="loading")
      | Creating comment...
    .tooltipemoji(*ngIf="comment.type == 'emoji' || !comment.type", [innerHtml]="comment.data | emojione")
    .tooltiptext.block-with-text(*ngIf="comment.type == 'text'", [innerHtml]="comment.data | linkify | emojione")
    span.tooltipaudio(*ngIf="comment.type == 'audio'")
      button#audioPlay.btn-audio(
        *ngIf="!isPlaying()",
        (click)="play()"
      )
        i.icon-play
      button#audioPause.btn-audio(
        *ngIf="isPlaying()",
        (click)="pause()"
      )
        i.icon-pause
  span.tooltipbody(*ngIf="indexOnLine==8")
    .tooltiptext.tooltipcount {{commentsByPos[comment.lineY] && commentsByPos[comment.lineY].length}} Comments
  .user-icon(*ngIf="indexOnLine==8", style="background: #fff;")
    .user-icon__overflow +{{commentsByPos[comment.lineY] && commentsByPos[comment.lineY].length - 7}}
  .reply-tag(*ngIf="repliesById[comment._id] && repliesById[comment._id].length>0")
    | {{repliesById[comment._id].length}}

//- Mobile Icon
.comment__button--mobile.hidden-md-up(
  (tap)='triggerCommentPane(false)',
  [ngClass]="[ active ? 'active' : '' ]"
)
.comment__count--mobile.hidden-md-up {{ lineCount }}
