doctype html
//-Annotator Component

    Provides:
    - Highlighting functionality
    - Tying in comments and comment creation methods
scroll-progress([scrollProgress]="currentScroll")
#emojiAnnotator.annotator.reading-page(
    [ngClass]="[ commentPane ? 'sliding-out' : '']",
    [style.min-height]="currentDocHeight + 'px'"
)
    .text-options(
        *ngIf="directCommentOptions.length > 0",
        [style.top]="highlightY + 'px'",
        [ngClass]="{ 'active' : optionsShow || optionsForceShow }"
    )
        //- optionsShow
        //- Desktop buttons
        .highlight-options.hidden-md-down
            //- Add Comment
            button#addComment.emoji(
                (tap)="addCommentOfType()"
            )
                i.icon.icon-comment-add
                label New
            //- View Comments
            button#viewComments.emoji(
                (tap)="viewCommentsOnSelection()"
            )
                i.icon.icon-search
                label View
        //- Mobile buttons
        .comment-options__mobile-wrap.hidden-lg-up([class.bottom-bar-offset]="project.isTeaching")
            //- .mobile-carrot-pointer &#9654;
            .comment__options--mobileRow.comment-options-group--mobile([class.btn-group-show--animation]="optionsShow")
                //- Add Comment (Mobile)
                #addCommentMobile.comment__options--mobileCol.btn.btn-icon--circle-shadow.comment-options--mobile.col-6(
                    *ngIf="project.types.indexOf('emoji') > -1",
                    [class.btn-show--animation]="optionsShow",
                    (tap)="addCommentOfType()"
                )
                    button.emoji.comment__options--mobileButton()
                        i.icon.icon-comment-add
                //- View Comments (Mobile)
                #viewCommentsMobile.comment__options--mobileCol.btn.btn-icon--circle-shadow.comment-options--mobile.col-6(
                    [class.btn-show--animation]="optionsShow",
                    (tap)="viewCommentsOnSelection()"
                )
                    button.emoji.comment__options--mobileButton()
                        i.icon.icon-search
    //- end .text-options
    .content--active__wrap
        .alert.alert-warning.alert-dismissible.fade.show(
            role="alert",
            *ngIf="audioSupportError"
        )
            button.close(
                type="button",
                data-dismiss="alert",
                aria-label="Close",
                (click)="audioSupportError = !audioSupportError"
            )
                span(aria-hidden="true") &times;
            b Audio Comments Unavailable
            | The browser you are on does not currently support recording audio. Our recommended browser for audio comments is <a href="https://www.google.com/chrome/browser/desktop/" target="_blank">Google Chrome </a> on a desktop device.
        //- Create components after load for reading
        //- Note: Applying TABINDEX to content wrappers will crash longer readings on Chrome mobile
        #annotatorContent.content.content--active.pt-4(
            (tap)="showCommentOptions($event)",
            (clickOutside)="hideCommentOptions()",
            [ngClass]="[ (quickSelect.anchor != null || quickSelect.boxes)? 'quick-select--begin' : '', (quickSelect.focus != null || (quickSelect.boxes && quickSelect.boxes.end)) ? 'quick-select--end':'']"
            #activeContent
        )
            //- Onboarding action
            .alert.alert-info.alert--margin.alert--clickable(
                *ngIf="onboardGuide",
                [class.fade-out]="quickSelect.anchor != null || userCommentsCreated > 0",
                (click)="tutorialGifUrl = '/assets/guide/add-highlight-v2.gif'; _analytics.event('onboarding_createComment_openHow')",
                data-test="commentHintOnboarding"
            )
                quick-start-flag
                | How do I comment?
            //- Reading Group Instructions
            .row.lesson-block(*ngIf="(project.group_instructions && project.group_instructions.length > 1) || project.quick_labels")
                    .lesson-block__indicator([innerHtml]="':mega:' | emojione")
                    .lesson-block__body
                        ng-container(*ngIf="project.group_instructions")
                            .lesson-block__header Instructions
                            p([innerHtml]="project.group_instructions")
                        ng-container(*ngIf="project.quick_labels")
                            .lesson-block__header Quick Labels
                            .quick-label(*ngFor="let label of project.quick_labels")
                                .icon.icon-quick-label
                                | {{ label | emojione }}
            //- Word Loop: reading.words is one big array of individual "words", which can also be puncuation or media
            <span #words class="w" *ngFor="let w of reading.words | slice:0:lastWord ; let i = index" [ngClass]="[ w && w.styles ? w.styles.join(' ') : '', getHighlightClass(project.heat_vision, project.isTeaching, filterHighlightArray, highlightArray, alwaysHighlightArray, i), focusClass(focusArray, i), quickSelectClass(quickSelect, i) ]" [attr.index]="i">
                //- Comment Loop: Display comments if they exist for this Word
                .margin-portal(*ngFor="let comment of commentsByIndex[i]; let ci = index")
                  avatar-portal(
                      [comment]="comment",
                      [commentExplorerActive]="commentPane",
                      [isActive]="comment.active",
                      (toggleCommentExplorer)="openComment($event, comment)",
                      [ngClass]="['e2e-comment--'+comment.author.replace(' ', '-')]",
                      (mouseenter)='!optionsShow && focusHighlight(comment.start, comment.end, comment.loc, comment.box)',
                      (mouseleave)='!optionsShow && unfocusHighlight(comment.start, comment.end, comment.loc, comment.box)',
                      [class.imageComment]="comment.imageY",
                      [class.hide]="!projectStore.isCommentVisible(comment)",
                      [class.spec-owner]="comment.user_id === project.teacher_id",
                      [style.top]="comment.imageY ? comment.imageY + 'px' : '0px'"
                  )
                //- Link Words: If a word is actually a link, handle it differently
                a.w(
                    *ngIf="w.a",
                    [attr.index]="i",
                    [attr.href]="w.url",
                    target="_blank"
                )
                  | {{ w.str }}
                //- Non-link Words, show content
                | {{ w.s ? '&nbsp;' : (!w.a ? w.str : '') }}
                .img-wrap(*ngIf="w.img")
                    //- Word/Hit Boxes
                    ng-container(*ngIf="w.boxes")
                        //- Preview word locations
                        .w-box-preview.hover--tooltip
                            .icon.icon-word-boxes
                            .tooltip-wrap
                                .tooltip
                                    .tooltip-title Click on words to highlight text!
                        //- @todo REMOVE adjustments for bad data
                        .w.w-box(
                            *ngFor="let box of w.boxes; let bi = index",
                            [style.top]="box.y + '%'",
                            [style.height]="box.h + '%'",
                            [style.left]="box.x + '%'",
                            [style.width]="box.w + '%'",
                            [attr.w-index]="i",
                            [attr.index]="bi",
                            [ngClass]="[getHighlightClass(project.heat_vision, project.isTeaching, filterHighlightArray, highlightArray, alwaysHighlightArray, i, bi), quickSelectClass(quickSelect, i, bi), focusClass(focusArray, i, bi)]"
                        )
                    //- Placeholder image hotspot
                    .hotspot(
                        *ngIf="imageHotspotPlaceholder.index == i && (imageHotspotPlaceholder.focus || imageHotspotPlaceholder.preview)",
                        [class.focused]="imageHotspotPlaceholder.focus",
                        [style.left]="imageHotspotPlaceholder.x  + '%' ",
                        [style.top]="imageHotspotPlaceholder.y + '%' "
                    )
                    //- Image Hotspots: Show hotspot for each comment
                    .hotspot(
                        *ngFor="let comment of commentsByIndex[i]",
                        [class.hidden]="!projectStore.isCommentVisible(comment) || comment.box",
                        [style.top]="comment['loc'] ? comment['loc']['y'] + '%' : '0%'",
                        [style.left]="comment['loc'] ? comment['loc']['x'] + '%' : '0%'"
                    )
                    //- Image: Display image for image "word"
                    img.reading-image(
                        [attr.id]="'readingImage' + i",
                        [attr.index]="i",
                        [src]="w.url",
                        (load)="updateImageHeights()"
                    )
                //- Question Words: Display question component
                edji-question(
                    *ngIf="w.q && reading.questions",
                    [question]="reading.questions[w.index]"
                )
                //- end Word span ".w"
            </span>
            //- Teacher's Feedback
            .row.lesson-block(*ngIf="feedbackForUser && feedbackForUser.length > 0")
                .lesson-block__indicator
                    .icon.icon-feedback
                .lesson-block__body
                    .lesson-block__header Teacher's Feedback For You
                    ng-container(*ngFor="let feedback of feedbackForUser")
                        edji-teacher-feedback(
                            [feedback]="feedback",
                            [teacherName]="project && project.teacher.fullname"
                        )
            .row.mb-4(*ngIf="lastWord < reading.words.length")
                .loading(style="margin: 0 auto;")
            //- Nested within annotator content
            comment-bubble(
              [visible]="commentBubble",
              [comment]="selectedComment",
              [top]="commentHeightPos + 'px'",
              (closed)="commentBubble = false; selectedComment = null"
            )
//- End of Reading options
.button__row
    button.btn.btn-secondary(
        *ngIf="user.type == 'temp'",
        [routerLink]="['/register']",
        [queryParams]="{ userId: user._id }"
    ) Save this reading
    //- Copy and Edit: Temp User
    button.btn.btn-primary(
        *ngIf="reading && user.type == 'temp'",
        [routerLink]="['/register']",
        [queryParams]="{ reading: reading._id, userId: user._id }"
    ) Copy and edit
    //- Copy and Edit: Registered User
    button.btn.btn-primary(
        *ngIf="reading && user.type != 'temp' && user._id != reading.owner_id",
        [routerLink]="['/new-reading']",
        [queryParams]="{ copyId: reading._id }"
    ) Copy and edit

//- Bottom of the page Options
.fixed-btn-row--SE.hidden-sm-down(
    [class.bottom-bar-offset]="project.isTeaching"
)
    tutorial-box(
        [tutorialName]="'highlighting'",
        [pageObjs]="guideContent",
        [pager]="guideStepNo",
        (pageChange)="guideStepNo = $event",
        [class.keyboard-offset]="_comments.emojiActive",
        [class.mobile-toolbar-offset]="optionsShow",
        [forceCollapse]="true"
    )

//- Emoji Keyboard: Custom Emoji entry component
    [currentComment]="_comments.activeComment && _comments.activeComment.data ? _comments.activeComment.data : ''",
emoji-keyboard(
    [isActive]="_comments.emojiActive"
)

comment-explorer(
    (visibleChange)="toggleCommentExplorer($event)",
    (clearSelected)="selectedComment = null"
)

//- Icon Arrow for the active comment
.icon-comment-arrow(
    [class.slide-in]="commentPane && selectedComment",
    [style.top]="commentHeightPos + 'px'"
)

//- Delete Comment Modal
hot-del-comment(
    *ngIf="_comments.showDeleteCommentModal",
    [comment]="_comments.deleteCommentRef",
    (delete)="deleteComment(_comments.deleteCommentRef)",
    (closeModal)="_comments.commentDeleted()"
)
//- Tutorial gifs
edji-tutorial-gif(
    *ngIf="tutorialGifUrl",
    [header]="'How to Comment'",
    [gif]="tutorialGifUrl",
    [description]="'<b>1.</b> Click an image or word<br/><b>2.</b> Select a comment type<br/><b>3.</b> Make your comment to save the highlight'",
    (closeModal)="tutorialGifUrl = ''"
)
