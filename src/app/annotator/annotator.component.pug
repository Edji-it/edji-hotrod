doctype html
//-Annotator Component

    Provides:
    - Highlighting functionality
    - Tying in comments and comment creation methods
scroll-progress([scrollProgress]="currentScroll")
#emojiAnnotator.annotator.reading-page(
    [ngClass]="[ lineExpanded ? 'comment-expanded' : '' , commentPane ? 'sliding-out' : '']",
    [style.min-height]="currentDocHeight + 'px'"
)
    .text-options(
        *ngIf="directCommentOptions.length > 0",
        (blur)="hideCommentOptions($event)",
        [style.top]="highlightY + 'px'",
        [ngClass]="{ 'active' : optionsShow }"
    )
        //- optionsShow
        //- Desktop buttons
        .options.hidden-md-down
            //- Emoji Comment
            button#addEmojiComment.emoji(
                *ngIf="project.types.indexOf('emoji') > -1",
                (tap)="addCommentOfType('emoji')"
            )
                i.icon.icon-comment-emoji
            //- Text Comment
            button#addTextComment.emoji(
                *ngIf="project.types.indexOf('text') > -1",
                (tap)="addCommentOfType('text')"
            )
                i.icon.icon-comment-text
            //- Audio Comment
            button#addAudioComment.emoji(
                *ngIf="project.types.indexOf('audio') > -1",
                [class.super-disabled]="audioSupportError",
                (tap)="addCommentOfType('audio')"
            )
                i.icon.icon-mic
        //- Mobile buttons
        .comment-options__mobile-wrap.hidden-lg-up([class.bottom-bar-offset]="project.isTeaching")
            //- .mobile-carrot-pointer &#9654;
            .comment__options--mobileRow.comment-options-group--mobile([class.btn-group-show--animation]="optionsShow")
                //- Emoji Comment
                #addEmojiCommentMobile.comment__options--mobileCol.btn.btn-icon--circle-shadow.comment-options--mobile(
                    *ngIf="project.types.indexOf('emoji') > -1",
                    [ngClass]="'col-' + (12 / directCommentOptions.length)",
                    [class.btn-show--animation]="optionsShow",
                    (tap)="addCommentOfType('emoji')"
                )
                    button.emoji.comment__options--mobileButton()
                        i.icon.icon-comment-emoji
                //-- Text Comment
                #addTextCommentMobile.comment__options--mobileCol.btn.btn-icon--circle-shadow.comment-options--mobile(
                    *ngIf="project.types.indexOf('text') > -1",
                    [ngClass]="'col-' + (12 / directCommentOptions.length)",
                    [class.btn-show--animation]="optionsShow",
                    (tap)="addCommentOfType('text')"
                )
                    button.emoji.comment__options--mobileButton()
                        i.icon.icon-comment-text
                //-- Audio Comment
                #addAudioCommentMobile.comment__options--mobileCol.btn.btn-icon--circle-shadow.comment-options--mobile(
                    *ngIf="project.types.indexOf('audio') > -1",
                    [ngClass]="'col-' + (12 / directCommentOptions.length)",
                    [class.super-disabled]="audioSupportError",
                    [class.btn-show--animation]="optionsShow",
                    (tap)="addCommentOfType('audio')"
                )
                    button.emoji.comment__options--mobileButton()
                        i.icon.icon-mic
    //- end .text-options
    .article-wrap
        .alert.alert-warning.alert-dismissible.fade.show(
            role="alert",
            *ngIf="audioSupportError"
        )
            button.close(
                type="button",
                data-dismiss="alert",
                aria-label="Close",
                (click)="audioSupportError = !audioSupportError"
            )
                span(aria-hidden="true") &times;
            | The browser you are on does not currently support recording audio. Audio comment playback may also be affected on some browsers. The recommended browser for audio comments is the
            a(href="https://www.google.com/chrome/browser/desktop/", target="_blank")
                | Google Chrome Web Browser
            | for your desktop device.
        //- Create components after load for reading
        //- Note: -1 tabindex for disabling "Touch to Search" on mobile https://developers.google.com/web/updates/2015/10/tap-to-search
        #annotatorContent.content.active-content.pt-4(
            tabindex="-1",
            (tap)="showCommentOptions($event)",
            [style.touch-action]="'pan-y'",
            (clickOutside)="hideCommentOptions()",
            [ngClass]="[ quickSelect.anchor != null ? 'quick-select--begin' : '', quickSelect.focus != null ? 'quick-select--end':'']",
            #article
        )
            //- Reading Group Instructions
            .row.lesson-block(*ngIf="project.group_instructions && project.group_instructions.length > 1")
                    .lesson-block__indicator([innerHtml]="':mega:' | emojione")
                    .lesson-block__body
                        .lesson-block__header Instructions
                        p([innerHtml]="project.group_instructions")
            h1 Testing 1062
            //- Word Loop: reading.words is one big array of individual "words", which can also be puncuation or media
            <span #words class="w" *ngFor="let w of reading.words; let i = index; trackBy:trackByFn" [ngClass]="[ w && w.styles ? w.styles.join(' ') : '', getHighlightClass(i) ]" [attr.index]="i" [class.archived]="project.archived">
                //- Comment Loop: Display comments if they exist for this Word
                edji-comment(
                    *ngFor="let comment of commentsByIndex[i]; let ci = index",
                    [class.hidden]="!_projects.isCommentVisible(comment)",
                    [class.spec-owner]="comment.user_id === project.teacher_id",
                    [comment]="comment",
                    (mouseenter)='focusHighlight(comment.start, comment.end, comment.loc)',
                    (mouseleave)='unfocusHighlight(comment.start, comment.end, comment.loc)',
                    [readOnly]="comment.user_id !== user._id",
                    [userPermission]="getCommentPermissions(comment)",
                    [isActive]="comment.active ? true : false",
                    (commentActivation)="setActiveCommentByIndex($event, i, ci)",
                    (commentDeleted)="removeComment(comment, i, ci)",
                    (commentDeactivate)="unfocusHighlight($event.start, $event.end)",
                    (commentUpdated)="setLinePositions()",
                    (expandLine)="expandLine($event, true)",
                    (collapseLine)="expandLine($event, false)",
                    (toggleCommentPane)="toggleCommentPane($event, comment)",
                    (commentReply)="discReplyFire(comment)",
                    [class.imageComment]="comment['loc']",
                    [style.top]="comment['loc'] ? comment.imageY + 'px' : '0px'"
                ) <!-- edji-comment -->
                //- Link Words: If a word is actually a link, handle it differently
                a.w(
                    *ngIf="wHasStyle(w, 'a')",
                    [attr.index]="i",
                    [attr.href]="w.url ? ((w.url.indexOf('//') > -1) ? w.url : ('//' + w.url)) : null",
                    target="_blank"
                )
                  | {{ w && w.str }}
                //- ng-container(*ngIf="!wHasStyle(w, 'a')")
                    //- Non-link Words, show content
                | {{ false ? '&nbsp;' : w && w.str }}
                //- .img-wrap(*ngIf="wHasStyle(w, 'img')")
                //-     //- Placeholder image hotspot
                //-     .hotspot(
                //-         *ngIf="imageHotspotPlaceholder.index == i && (imageHotspotPlaceholder.focus || imageHotspotPlaceholder.preview)",
                //-         [class.focused]="imageHotspotPlaceholder.focus",
                //-         [style.left]="imageHotspotPlaceholder.x  + '%' ",
                //-         [style.top]="imageHotspotPlaceholder.y + '%' "
                //-     )
                //-     //- Image Hotspots: Show hotspot for each comment
                //-     .hotspot(
                //-         *ngFor="let comment of commentsByIndex[i]",
                //-         [class.hidden]="!_projects.isCommentVisible(comment)",
                //-         [style.top]="comment['loc'] ? comment['loc']['y'] + '%' : '0%'",
                //-         [style.left]="comment['loc'] ? comment['loc']['x'] + '%' : '0%'"
                //-     )
                //-     //- Image: Display image for image "word"
                //-     img.reading-image(
                //-         [attr.id]="'readingImage' + i",
                //-         [attr.index]="i",
                //-         [src]="w.url",
                //-         (load)="updateImageHeights()"
                //-     )
                //- //- Question Words: Display question component
                //- edji-question(
                //-     *ngIf="wHasStyle(w, 'question') && reading.questions",
                //-     [question]="reading.questions[w.index]"
                //- )
                //- end Word span ".w"
            </span>
            //- Teacher's Feedback
            .row.lesson-block(*ngIf="feedbackForUser && feedbackForUser.length > 0")
                .lesson-block__indicator
                    .icon.icon-feedback
                .lesson-block__body
                    .lesson-block__header Teacher's Feedback For You
                    ng-container(*ngFor="let feedback of feedbackForUser")
                        edji-teacher-feedback(
                            [feedback]="feedback",
                            [teacherName]="project && project.teacher.fullname"
                        )
        .row.mb-4(*ngIf="lastWord < reading.words.length")
            .loading(style="margin: 0 auto;")
//- End of Reading options
.button__row
    button.btn.btn-secondary(
        *ngIf="user.type == 'temp'",
        [routerLink]="['/register']",
        [queryParams]="{ userId: user._id }"
    ) Save this reading
    //- Copy and Edit: Temp User
    button.btn.btn-primary(
        *ngIf="reading && user.type == 'temp'",
        [routerLink]="['/register']",
        [queryParams]="{ reading: reading._id, userId: user._id }"
    ) Copy and edit
    //- Copy and Edit: Registered User
    button.btn.btn-primary(
        *ngIf="reading && user.type != 'temp' && user._id != reading.owner_id",
        [routerLink]="['/new-reading']",
        [queryParams]="{ copyId: reading._id }"
    ) Copy and edit

//- Bottom of the page Options
.fixed-btn-row--SE.hidden-sm-down(
    [class.bottom-bar-offset]="project.isTeaching"
)
    tutorial-box(
        [tutorialName]="'highlighting'",
        [pageObjs]="guideContent",
        [pager]="guideStepNo",
        (pageChange)="guideStepNo = $event",
        [class.keyboard-offset]="isEmojiKeyboardActive()",
        [class.mobile-toolbar-offset]="optionsShow"
    )

//- Emoji Keyboard: Custom Emoji entry component
    [currentComment]="_comments.activeComment && _comments.activeComment.data ? _comments.activeComment.data : ''",
emoji-keyboard(
    [isActive]="isEmojiKeyboardActive()",
    (commentChange)="updateActiveComment($event)",
    (dismissKeyboard)="inactivateComment()"
)

//- comment-pane
comment-pane(
    [isActive]="(selectedComment.active || selectedReply.active) ? true : false",
    [isSelected]="(selectedComment.selected || selectedReply.selected) ? true : false",
    [comment]="selectedComment",
    [reply]="selectedReply",
    (hideComment)="toggleCommentPane(false)",
    (commentActivationMobile)="setActiveCommentByIndex($event.activate, $event.wi, $event.ci, $event.activatedComment)",
    (commentUpdated)="setLinePositions()",
    (commentReply)="discReplyFire($event)"
)

//- Icon Arrow for the active comment
.icon-comment-arrow(
    [style.top]="commentHeightPos + 'px'"
)

//- Delete Comment Modal
hot-del-comment(
    *ngIf="_comments.showDeleteCommentModal",
    [comment]="_comments.deleteCommentRef",
    (delete)="deleteComment(_comments.deleteCommentRef)",
    (closeModal)="_comments.commentDeleted()"
)
