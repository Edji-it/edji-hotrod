nav-bar
.container.dashboard-container
  .row
    .col-sm-12.col-md-8.offset-md-2.mt-4(*ngIf="hasError")
        h2 Error Signing in with {{ loginTypeDisplay }}
        ng-container(*ngIf="messages.noUser") 
            .alert.alert-danger
                | There was no user found with that token
            .btn-row.right
                button.btn.btn-primary([routerLink]="['/login']") Return to Log In
        ng-container(*ngIf="messages.duplicate_user") 
            .alert.alert-danger
                p A user already exists with that email address. If you'd like to log in to that account, please sign in with a username and password.
                p If you have forgotten your password, you can reset it.
            .btn-row.right
                a.btn.btn-secondary([routerLink]="['/login']", [queryParams]="{mlink: 'forgot'}") Forgot Password?
                a.btn.btn-primary([routerLink]="['/login']") Log In
        ng-container(*ngIf="messages.serverError") 
            .alert.alert-danger
                | There was an error fetching your user information. Please try again or contact us.
            .btn-row.right
                button.btn.btn-primary([routerLink]="['/login']") Return to Log In
        ng-container(*ngIf="messages.noToken") 
            .alert.alert-danger
                | Sorry! Looks like something went wrong with login. Please return to the Login page and try again!
            .btn-row.right
                button.btn.btn-primary([routerLink]="['/login']") Return to Log In
    .col-sm-12.col-md-8.offset-md-2.mt-4(*ngIf="oAuthToken && messages.duplicate_user")
        h2 Log in to Link with {{ loginTypeDisplay }}
        ng-container(*ngIf="!messages.linkError")
            .alert.alert-warning
                p An Edji user already exists with your {{ loginTypeDisplay }} email address. If you'd like to link {{ loginTypeDisplay }} with your existing Edji account, please log in below. 
                p If you do not wish to link your account, you may return to the <a class="link" [routerLink]="['/login']">log in page</a> and continue with your Edji account.
            hot-login-form((loginSuccess)="linkAfterLogin($event)", submitText="Log In and Link")
            a.link([routerLink]="['/login']", [queryParams]="{mlink: 'forgot'}") Forgot password?
        ng-container(*ngIf="messages.linkError")
            .alert.alert-danger
                b Error Linking
                | There was an error linking your accounts. Please try again, or contact <a href="mailto:support@edji.it" class="link">Edji Support</a>.