#addProjectModal.modal.fade-in.show
  .modal-dialog
    .modal-content
      .modal-header
        h4.modal-title {{ heading ? heading : &apos;New Group&apos; }}
        button.close((click)='closeModal.emit()', type='button') &times;
      form([formGroup]='projectForm', (ngSubmit)='addProject(projectForm.value)')
        .modal-body.pb-0
            .alert.alert-warning(*ngIf='largeReadingWarning')
                b Large Reading
                p.mb-0 This reading may have performance issues on slower devices. Consider reducing its size before continuing.
            .alert.alert-info(*ngIf="showGuideMessage", data-test="createGroupOnboarding")
                quick-start-flag
                b About Reading Groups
                p Readings on Edji can be shared with multiple groups, and when creating a reading we kick things off with a first group
            .form-group(*ngIf='subheading')
                p {{ subheading }}
            .form-group
                label(for='newProjectLabel')
                    | Group Name
                    i.icon__tooltip(tooltipPosition="right", pTooltip="A group is a section of students on a Reading", tooltipZIndex="9000")
                        span.icon.icon-circle.icon-info  i
                input#newProjectLabel(tabindex='0', type='text', placeholder='1st Period, Vocabulary, Monday Class...', [formControl]="projectForm.controls['label']")
                #msgLabelRequired.alert.alert-warning(*ngIf="formSubmitted && projectForm.controls['label'].hasError('required')", role='alert')
                    b No Name
                    | Groups like to have names!
            .form-group(*ngIf="!hideInstructions")
                label(for='groupInstructions')
                    | Reading Group Instructions
                    i.icon__tooltip(tooltipPosition="right", pTooltip="Instructions are displayed at the beginning of a Reading, and included in the Recap.", tooltipZIndex="9000")
                        span.icon.icon-circle.icon-info  i
                textarea#groupInstructions.form-control.mGroup([formControl]="projectForm.controls['groupInstructions']", type='text', placeholder="For today's lesson, you will...")
            //- Advanced Settings
            p-fieldset([toggleable]="true", styleClass="modal-fieldset", collapsed="true")
                p-header.label Advanced Settings
                .card.card-body
                    //- Add Quick Labels
                    .form-group(formArrayName="quickLabels")
                        label Quick Labels
                        .label.text-muted Give students key terms, concepts, or categories to use in comments
                        .input-group.quick-label__field-wrap(
                            *ngFor="let item of quickLabels.controls; let pointIndex=index", 
                            [formGroupName]="pointIndex"
                        )   
                            .icon.icon-quick-label
                            input.form-control(
                                type="text", 
                                formControlName="label",
                                placeholder="Quick Label",
                            )
                            .form-control-clear.form-control-clear--in-field.icon.icon-close(
                                *ngIf="pointIndex !== 0",
                                type="button", 
                                (click)="deleteQuickLabel(pointIndex)"
                            ) 
                        button.btn.btn-primary.btn-sm.mt-1.float-right(type="button", (click)="addQuickLabel()") 
                            | Add Label
                    .form-group.row()
                        label.col-12 Comment Abilities
                        .input-group.col-4
                            .custom-control.custom-checkbox
                                input#emojiCommenting.custom-control-input(type='checkbox', [formControl]="projectForm.controls['emojiType']")
                                label.custom-control-label(for="emojiCommenting") Emoji
                        .input-group.col-4
                            .custom-control.custom-checkbox
                                input#audioCommenting.custom-control-input(type='checkbox', [formControl]="projectForm.controls['audioType']")
                                label.custom-control-label(for="audioCommenting") Audio
                        .input-group.col-4
                            .custom-control.custom-checkbox
                                input#replyCommenting.custom-control-input(type='checkbox', [formControl]="projectForm.controls['replyType']")
                                label.custom-control-label(for="replyCommenting") Replies
                    div([class.hero-box]="!isHero")
                        .form-group.p-0(*ngIf="!isHero")
                            .row.no-gutters
                                .label.w-100 Unlock custom codes!
                                    a.float-right.btn.btn-sm.btn-hero(target="_blank" href="/#/plans") Learn More
                        .form-group.pb-0([class.disabled]='!isHero')
                            label(for='customCodeInput')
                                | Custom Code
                                span.hero-h(title='Hero Power')
                                    ='H'
                            input#customCodeInput.form-control.text-code.h3.mGroup([formControl]="projectForm.controls['customCode']", type='text', placeholder='(optional)', style='text-transform:lowercase;')
                            #errorInvalidCustomCode.alert.alert-warning(*ngIf='errors.invalidCode') Whoops, someone is already using that group code. Could you pick another?
        .modal-footer
            .button__row(style='padding-top:0px;')
                button.btn.btn-primary(
                    [attr.id]=" (!reading._id || loading) ? 'loading-buttonCreateGroup' : 'buttonCreateGroup'",
                    tabindex='0',
                    type='submit',
                    [class.loading]='!reading._id || loading',
                    name='Add Project',
                    style='margin: 5px 3px; width:100%;') Create Group
            #msgServiceError.alert.alert-warning(*ngIf='formSubmitted && errors.serviceError', role='alert') There was an error in while creating your reading. Try again or contact support.
