.modal-will-fade([class.show]="showReferral", *ngIf="showReferral")
  .modal
    .modal-dialog(role="document")
      .modal-content
        .modal-header
          h4.modal-title Give Hero, Get Hero
          button.close.btn-icon--round(
              (click)="closeModal()",
              type="button",
              data-dismiss="modal",
              aria-label="Close"
             )
            span(aria-hidden="true") &times;
        .modal-body
          p.small.mb-3 Share your unique referral link to give 
            i and 
            | unlock Hero discounts.
          .row.mb-4
            .col-6
              .input-group
                input#copyreferralCode.form-control(
                  name="ProjectCodeInput",
                  type="text",
                  disabled="true",
                  value="{{referralLink}}")
                span.input-group-btn
                  button#buttonCopyReferralLink.btn.btn-primary(
                    type="button", 
                    (click)="shareReferralCode()", 
                    name="Copy", 
                    href="#") Copy
            .col-6
              .share-icon__group
                .icon-email.share-icon((click)="shareReferralCode('email')")
                .icon-twitter.share-icon((click)="shareReferralCode('twitter')")
                .icon-facebook.share-icon((click)="shareReferralCode('facebook')")
          h6.small.font-weight-bold Your Path to Hero
          p.small.mb-3 Each teacher you refer that creates a reading will unlock a 20% discount towards Hero for both of you.
            | Complete 5 referrals to get a whole year of Hero free.
          //- 5 icons for referral status
