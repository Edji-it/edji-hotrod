.modal-will-fade([class.show]="showModal", *ngIf="showModal")
  .modal#referralModal
    .modal-dialog(role="document", style="max-width:500px;")
      .modal-content
        .modal-header
          h4.modal-title Give Hero, Get Hero
          button.close.btn-icon--round(
              (click)="closeModal()",
              type="button",
              data-dismiss="modal",
              aria-label="Close"
             )
            span(aria-hidden="true") &times;
        .modal-body
          .alert.alert-reading.alert-dismissable.fade(*ngIf="alertObject.show && !showReading", [class.show]="alertObject.show", role="alert", [ngClass]="alertObject.type")
            a.close(href="#", (click)="closeAlert()") ×
            p.mb-0([innerHtml]="alertObject.message")
          div
            //- Overview copy
            p.small.mb-3 Share your unique referral link to give <i>and</i> unlock Hero discounts.
            //- Generated code for copy and share buttons
            .row.mb-4.no-gutters
              .col-sm-8
                .form-group
                  edji-share-link([link]="referralLink")
              .col-sm-4.text-center
                edji-share-social-icons(
                  [link]="referralLink",
                  [subjectCopy]="'Join me on Edji'",
                  [messageCopy]="'Create your first Reading, and we both unlock 20% off Hero!'"
                )
          //- More copy
        
          h6.small.font-weight-bold Your Path to Hero
          p.small.mb-3 Each teacher you refer that creates a reading will unlock a 20% discount towards Hero for both of you. Complete 5 referrals to get a year of Hero free.
          //- referral "squares" -- Desktop
          .hidden-sm-down
            .container
              .row
                .col-2.p-0.referral-col(
                  *ngFor="let referral of referralBlocks; let i=index", 
                  [ngClass]="['referral-col-' + i, (i == referralIndex || (i == 4 && referralIndex > i)) ? 'referral--connecting-line' : '' ]"
                )
                  .referral-block.text-center([ngClass]="['referral-block-' + i]")
                    | H
                  //- If referrals are completed, let's add a "stamp" over top and some coupon copy
                  .referral-icon(*ngIf="referralBlocks[i].referred", [ngClass]="getReferralIcon(i)", [attr.id]="'referralStamp' + (i + 1)")
            .coupon-message(
              *ngIf="referralIndex>-1", 
              [ngStyle]="{'float': referralIndex>2 ? 'right' : 'left'}"
            )
              .row.no-gutters(style="flex-wrap: initial;")
                .col-8
                  .font-xs.font-weight-bold {{referralCouponCopy.header}}
                  p.font-xs.mb-0 {{referralCouponCopy.text}}
                .col-4.ml-1
                  button#redeemReferralsButton.btn.btn-sm.btn-hero.btn-coupon((click)="useCoupon()") {{referralCouponCopy.buttonText}}
          //- referral "squares" -- Mobile
          .hidden-md-up
            .container
              .row
                .col-2.p-0.referral-col.narrow-margin(*ngFor="let referral of referralBlocks; let i=index", 
                  [ngClass]="['referral-col-' + i, referralIndex==i ? 'referral--connecting-line' : '' ]"
                )
                  .referral-block.text-center.narrow([ngClass]="['referral-block-' + i]")
                    | H
                  //- If referrals are completed, let's add a "stamp" over top and some coupon copy
                  .referral-icon.referral-icon--narrow(*ngIf="referralBlocks[i].referred", [ngClass]="getReferralIcon(i)")
            .container.coupon-message.coupon-small(
              *ngIf="referralIndex>-1", 
              [ngStyle]="{'float': referralIndex>2 ? 'right' : 'left'}"
            )
              .row(style="flex-wrap: initial;")
                .col-6
                  h6.small.font-xs.font-weight-bold.mb-1 {{referralCouponCopy.header}}
                  p.small.font-xs.mb-3 {{referralCouponCopy.text}}
                .col-4.p-0.ml-1
                  button.btn.btn-hero.btn-coupon.btn-coupon__small((click)="useCoupon()") {{referralCouponCopy.buttonText}}