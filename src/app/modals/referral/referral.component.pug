.modal-will-fade([class.show]="showReferral", *ngIf="showReferral")
  .modal
    .modal-dialog(role="document")
      .modal-content
        .modal-header
          h4.modal-title Give Hero, Get Hero
          button.close.btn-icon--round(
              (click)="closeModal()",
              type="button",
              data-dismiss="modal",
              aria-label="Close"
             )
            span(aria-hidden="true") &times;
        .modal-body
          //- Overview copy
          p.small.mb-3 Share your unique referral link to give 
            i and 
            | unlock Hero discounts.
          //- Generated code for copy and share buttons -- Desktop
          .hidden-sm-down
            .container
              .row.mb-4
                .col-sm-6.pl-0
                  .input-group
                    input#copyreferralCode.form-control(
                      name="ProjectCodeInput",
                      type="text",
                      disabled="true",
                      value="{{referralLink}}")
                    span.input-group-btn
                      button#buttonCopyReferralLink.btn.btn-primary.btn-rnd-corner-right(
                        type="button", 
                        (click)="shareReferralCode()", 
                        name="Copy", 
                        href="#") Copy
                .col-sm-6.pr-0
                  .share-icon__group.float-right
                    .icon-email.share-icon((click)="shareReferralCode('email')")
                    .icon-twitter.share-icon((click)="shareReferralCode('twitter')")
                    .icon-facebook.share-icon((click)="shareReferralCode('facebook')")
          //- Generated code for copy and share buttons -- Mobile
          .hidden-md-up.w-100
            .container
              .row.mb-4.text-center
                .col-sm-6
                  .input-group
                    input#copyreferralCode.form-control.d-inline-block.input-small(
                      name="ProjectCodeInput",
                      type="text",
                      disabled="true",
                      value="{{referralLink}}")
                    span.input-group-btn.d-inline-block
                      button#buttonCopyReferralLink.btn.btn-primary.btn-rnd-corner-right(
                        type="button", 
                        (click)="shareReferralCode()", 
                        name="Copy", 
                        href="#") Copy
                .col-sm-6
                  .share-icon__group
                    .icon-email.share-icon((click)="shareReferralCode('email')")
                    .icon-twitter.share-icon((click)="shareReferralCode('twitter')")
                    .icon-facebook.share-icon((click)="shareReferralCode('facebook')")
          //- More copy
          h6.small.font-weight-bold Your Path to Hero
          p.small.mb-3 Each teacher you refer that creates a reading will unlock a 20% discount towards Hero for both of you.
            | Complete 5 referrals to get a whole year of Hero free.
          //- referral "squares" -- Desktop
          .hidden-sm-down([ngStyle]="{'margin-bottom': numberReferrals > -1 ? '75px' : '0px'}")
            .container
              .row
                .col-2.p-0.referral-col(*ngFor="let referral of referralBlocks; let i=index", [ngClass]="['referral-col-' + i]")
                  .referral-block.text-center([ngClass]="['referral-block-' + i]")
                    | H
                  //- If referrals are completed, let's add a "stamp" over top and some coupon copy
                  .referral-icon(*ngIf="referralBlocks[i].referred", [ngClass]="getReferralIcon(i)")
                  .coupon-message(*ngIf="numberReferrals==i")
          //- referral "squares" -- Mobile
          .hidden-md-up
            .container
              .row
                .col-2.p-0.referral-col.narrow-margin(*ngFor="let referral of referralBlocks; let i=index", [ngClass]="['referral-col-' + i]")
                  .referral-block.text-center.narrow([ngClass]="['referral-block-' + i]")
                    | H
                  //- If referrals are completed, let's add a "stamp" over top and some coupon copy
                  .referral-icon.referral-icon--narrow(*ngIf="referralBlocks[i].referred", [ngClass]="getReferralIcon(i)")