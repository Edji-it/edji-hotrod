.modal-will-fade([class.show]="showModal", *ngIf="showModal")
  .modal#referralModal
    .modal-dialog(role="document")
      .modal-content
        .modal-header
          h4.modal-title Give Hero, Get Hero
          button.close.btn-icon--round(
              (click)="closeModal()",
              type="button",
              data-dismiss="modal",
              aria-label="Close"
             )
            span(aria-hidden="true") &times;
        .modal-body
          .alert.alert-reading.alert-dismissable.fade(*ngIf="alertObject.show", [class.show]="alertObject.show", role="alert", [ngClass]="alertObject.type")
            a.close(href="#", (click)="closeAlert()") ×
            p.mb-0([innerHtml]="alertObject.message")
          //- Overview copy
          p.small.mb-3 Share your unique referral link to give 
            i and 
            | unlock Hero discounts.
          //- Generated code for copy and share buttons -- Desktop
          .hidden-sm-down
            .container
              .row.mb-4
                .col-sm-8.pl-0
                  .form-group
                    .input-group
                      input#copyReferralCode.form-control(
                        name="ReferralCode",
                        type="text",
                        disabled="true",
                        value="{{referralLink}}")
                      .input-group-append
                        //- e2e: ngIf on copy button ensures link is ready to copy
                        button#buttonCopyReferralLink.btn.btn-primary.btn-rnd-corner-right(
                          *ngIf="referralLink && referralLink.length > 0"
                          type="button", 
                          (click)="shareReferralCode()", 
                          name="Copy", 
                          href="#") Copy
                    small.form-text.text-success(*ngIf="linkCopySuccess")
                      | Link was copied to your clipboard!
                .col-sm-4.pr-0
                  .share-icon__group.float-right
                    #referEmailShare.icon-email.share-icon((click)="shareReferralCode('email')")
                    #referTwitterShare.icon-twitter.share-icon((click)="shareReferralCode('twitter')")
                    #referFacebookShare.icon-facebook.share-icon((click)="shareReferralCode('facebook')")
          //- Generated code for copy and share buttons -- Mobile
          .hidden-md-up.w-100
            .container
              .row.mb-4.text-center
                .col-sm-6
                  .input-group
                    input#copyreferralCode.form-control.d-inline-block.input-small(
                      name="ProjectCodeInput",
                      type="text",
                      disabled="true",
                      value="{{referralLink}}")
                    .input-group-append
                      button#buttonCopyReferralLink.btn.btn-primary.btn-rnd-corner-right(
                        *ngIf="referralLink",
                        type="button", 
                        (click)="shareReferralCode()", 
                        name="Copy", 
                        href="#") Copy
                .col-sm-6
                  .share-icon__group
                    .icon-email.share-icon((click)="shareReferralCode('email')")
                    .icon-twitter.share-icon((click)="shareReferralCode('twitter')")
                    .icon-facebook.share-icon((click)="shareReferralCode('facebook')")
          //- More copy
          h6.small.font-weight-bold Your Path to Hero
          p.small.mb-3 Each teacher you refer that creates a reading will unlock a 20% discount towards Hero for both of you. Complete 5 referrals to get a whole year of Hero free.
          //- referral "squares" -- Desktop
          .hidden-sm-down
            .container
              .row
                .col-2.p-0.referral-col(
                  *ngFor="let referral of referralBlocks; let i=index", 
                  [ngClass]="['referral-col-' + i, (i == referralIndex || (i == 4 && referralIndex > i)) ? 'referral--connecting-line' : '' ]"
                )
                  .referral-block.text-center([ngClass]="['referral-block-' + i]")
                    | H
                  //- If referrals are completed, let's add a "stamp" over top and some coupon copy
                  .referral-icon(*ngIf="referralBlocks[i].referred", [ngClass]="getReferralIcon(i)", [attr.id]="'referralStamp' + (i + 1)")
            .coupon-message(
              *ngIf="referralIndex>-1", 
              [ngStyle]="{'float': referralIndex>2 ? 'right' : 'left'}"
            )
              .row.no-gutters(style="flex-wrap: initial;")
                .col-8
                  .font-xs.font-weight-bold {{referralCouponCopy.header}}
                  p.font-xs.mb-0 {{referralCouponCopy.text}}
                .col-4.ml-1
                  button#redeemReferralsButton.btn.btn-sm.btn-hero.btn-coupon((click)="useCoupon()") {{referralCouponCopy.buttonText}}
          //- referral "squares" -- Mobile
          .hidden-md-up
            .container
              .row
                .col-2.p-0.referral-col.narrow-margin(*ngFor="let referral of referralBlocks; let i=index", 
                  [ngClass]="['referral-col-' + i, referralIndex==i ? 'referral--connecting-line' : '' ]"
                )
                  .referral-block.text-center.narrow([ngClass]="['referral-block-' + i]")
                    | H
                  //- If referrals are completed, let's add a "stamp" over top and some coupon copy
                  .referral-icon.referral-icon--narrow(*ngIf="referralBlocks[i].referred", [ngClass]="getReferralIcon(i)")
            .container.coupon-message.coupon-small(
              *ngIf="referralIndex>-1", 
              [ngStyle]="{'float': referralIndex>2 ? 'right' : 'left'}"
            )
              .row(style="flex-wrap: initial;")
                .col-6.p-0
                  h6.small.font-xs.font-weight-bold.mb-1 {{referralCouponCopy.header}}
                  p.small.font-xs.mb-3 {{referralCouponCopy.text}}
                .col-4.p-0.ml-1
                  button.btn.btn-hero.btn-coupon.btn-coupon__small((click)="useCoupon()") {{referralCouponCopy.buttonText}}