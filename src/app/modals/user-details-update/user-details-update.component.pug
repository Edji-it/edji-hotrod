.modal.fade#userDetailsModal(*ngIf="showModal", [class.show]="showModal")
  .modal-dialog
    form.modal-content([formGroup]="heardFromForm", (ngSubmit)="formSubmit(heardFromForm)")
      .modal-header
        h4.modal-title([innerHTML]="modalHeadings.header | emojione")
        button(*ngIf="messages.success", type="button", class="close", aria-label="Close", (click)="closeModal.emit()")
          span(aria-hidden="true") &times;
      .modal-body
        .form-group
          p([innerHTML]="modalHeadings.body | emojione")
        .form-group
          label(for="sourceInput") Where did you hear about us?
          select.custom-select#sourceInput([formControl]="heardFromForm.controls['source']")
            option([value]="undefined", disabled, selected) Select...
            option(*ngFor="let option of sourceOptions", data-test="sourceOption", [value]="option.source", [innerHTML]="option.display")
          input.form-control(*ngIf="heardFromForm.controls['source'].value === 'other'",
            type="text", 
            placeholder="Somewhere else?", 
            [formControl]="heardFromForm.controls['detail']"
          )
          #msgSourceRequired.alert.alert-info(*ngIf="heardFromForm.controls['source'].hasError('required') && heardFromForm.controls['source'].dirty")
            | Could you please share where you heard about us?
      .modal-footer
        //- button.btn.btn-link((click)="closeModal.emit()")
        //-   | Later
        button.btn.btn-primary(
          type="submit", 
          [disabled]="heardFromForm.controls['source'].invalid",
          data-text="userDetailsSubmit"
        ) Let's Go