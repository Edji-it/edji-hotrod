.modal
  #loginModalOutsideContent.modal-dialog(role='document')
    #loginModal.modal-content((clickOutside)="closeModalOutside()")
      .modal-header
        h5.modal-title Log In
      .modal-body
        div(*ngIf='guestLogin')
          h3#guestLoginHeader Edji as a guest
          hot-guest-login((loginSuccess)='onLoginSuccess()')
        div(*ngIf='!guestLogin')
          edji-oauth-row
          hr
          p.text-divider.on-white or
          hot-login-form((loginSuccess)='onLoginSuccess()')
      .modal-footer(*ngIf='guestLogin')
        p.center Wait! I have an account and want to use it!
        .center
          button#gotoAccountLoginButton.btn.btn-secondary((click)='guestLogin = false') Log In with Account
      .modal-footer(*ngIf='!guestLogin && !loginOnly')
        p Wait! I don't want to login, I just want to comment!
        div
          button.btn.btn-secondary#gotoGuestLoginButton((click)='guestLogin = true') Guest Login
      .modal-footer(*ngIf='!guestLogin && loginOnly')
        p I don't have an account, but want to register!
        div
          button.btn.btn-secondary#goToRegistration((click)="goToRegister()") Register