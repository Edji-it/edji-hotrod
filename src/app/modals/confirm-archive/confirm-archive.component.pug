#confirmArchiveModal.modal.fade-in.show
  .modal-dialog
    .modal-content
      .modal-header
        h4.modal-title Confirm Share
        button.close((click)='closeModal.emit()', type='button') &times;
      .modal-body
        p.mb-3 Sharing a new reading will archive this reading:
        hot-reading-card(style="margin-bottom: 30px; float:left; width:100%;", [reading]="readingToArchive", [readOnly]="true")
        p.m-0 You can access all archived readings when you 
          a#goHeroLink.btn.btn-hero.btn-sm(
            (click)="goHero.emit()"
          ) Go Hero
          |  (along with all of the associated groups). 
      .modal-footer
        .button__row(style='padding-top:0px;')
            button.float-right#buttonConfirm.btn.btn-action(tabindex='1', type='button', (click)="confirmArchive.emit()") Continue
            button.float-right#buttonDraft.btn.btn-secondary(tabindex='0', type='button', (click)="declineArchive.emit()") Save as Draft
