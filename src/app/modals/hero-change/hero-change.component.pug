#upgradeHeroModal.modal.fade-in
  .modal-dialog
    .modal-content
      .modal-header
        h4.modal-title Hero Subscription
        button.close((click)="close()", type="button") &times;
      .modal-body.pb-0
        .row(*ngIf="!confirmCancel && !isCanceled")
          .col-12
            label Hero Subscription Plan
            table.table.table-hover
                tr.selectable([class.table-info]="subtype == 'yearly'", (click)="subtype = 'yearly'")
                  th(scope="row")
                    label.form-check-label
                      input#subPlan2.form-check-input([(ngModel)]="subtype", type="radio", name="subscriptionPlan", value="yearly", aria-label="Annual Subscription", checked)
                      | Yearly
            .alert.alert-success(*ngIf="isUpdated")
              strong Subscription Updated
              | Your Hero Subscription was updated.
            .btn-row.right
              button#subHero.btn.btn-secondary([class.loading]="canceling", (click)="confirmCancel = true") Cancel Subscription
        .row(*ngIf="confirmCancel && !isCanceled")
          .col-12
            p Please confirm that you would like to unsubscribe from Edji Hero.
            p You will remain a Hero until the end of your current payment period.
            .alert.alert-warning(*ngIf="cancelMsg", [innerHtml]="cancelMsg")
            .btn-row.center.pt-4
              button#subHero.btn.btn-hero.w-100((click)="confirmCancel = false") Nevermind, Don't Cancel my Hero Subscription
            .btn-row.center.pt-2
              button#subHero.btn.btn-secondary.w-100([class.loading]="canceling", (click)="cancelSub()") Yes, Please Cancel my Hero Subscription
            hr
        .row(*ngIf="isCanceled")
          .col-12
            p Your Hero subscription has been canceled.
      .modal-footer
        .btn-row.right
          button.btn((click)="close()", type="button", data-dismiss="modal") Close