nav-bar([showDashboardOptions]="true")
.academy-bg
.container.academy-container
  .row
    .col-8
      h1 Licenses for {{currentAcademy ? currentAcademy.name : 'Academy'}}
  .row
    .container(*ngIf="license")
      h2 Teachers on This License
      ul.list-group
        li.px-0(*ngFor="let user of license.users")
          .pl-4.container
            .row.no-gutters
              .col-4 {{user.fullname}}
              .col-4 {{user.email}}
      .row
        .col-md-8
          h2.mt-2 Pending Invitations For This License
        .col-md-4.py-3.text-center
          button.btn.btn-primary.btn-sm((click)="addLicense()") Invite a Teacher
      ul.list-group
        li.px-0(*ngFor="let invitation of license.pending_invitations")
          .pl-4.container
            .row.no-gutters
              .col-4 {{invitation.name ? invitation.name : ''}}
              .col-4 {{invitation.email ? invitation.email : ''}}
              .col-4 Expires on {{invitation.expiration | edjidate:'timeStamp':'shortDate'}}