nav-bar([showDashboardOptions]="true")
.academy-bg
.row.mx-3
  .col-md-8.px-2
    .container.academy-container.py-4
      .row
        .col-6
          .academy-header Academy
          .academy-name {{currentAcademy ? currentAcademy.name : 'Academy'}}
        .col-6
          .float-right
            .academy-header.ml-2 License Seats
            button.btn.academy-pill.bckgnd-invisible.mr-4#availableLicenseCount {{license ? license.max_users - license.users.length : 0}} 
              .text-smaller available
            button.btn.academy-pill#activeLicenseCount {{license ? license.users.length : 0}} 
              .text-smaller in Use
      .row#licenseMgmtLoader.loading(*ngIf="licenseUsers.length < 0 || !currentAcademy")
      .row
        .container(*ngIf="licenseUsers.length > 0")
          table.table.table-striped.licenses-table
            thead
              tr
                th.check-box(scope="col")
                th.academy-header.educator-header(scope="col") Educator
                th.academy-header.role-header(scope="col") Role
                th.academy-header(scope="col") Joined Academy
            tbody
              tr.no-border(
                  *ngFor="let licenseUser of licenseUsers", 
                  [class.table-danger]="licenseUser.type == 'expired'", 
                  [class.educator-pending]="licenseUser.type != 'active'"
                )
                td
                td.educator-pending--name {{ licenseUser.educator }}
                  p.small.mb-0 {{licenseUser.email}}
                td {{ licenseUser.role }}
                td(*ngIf="licenseUser.type=='active'") {{ licenseUser.joined | edjidate:'timeStamp':'mediumDate' }}
                td.educator-pending.expires(*ngIf="licenseUser.type=='pending'") 
                  i Pending - Expires {{ licenseUser.joined | edjidate:'timeStamp':'mediumDate' }}
                td.educator-pending.expires(*ngIf="licenseUser.type=='expired'") 
                  | Expired {{ licenseUser.joined | edjidate:'timeStamp':'mediumDate' }}
                  .btn.btn-secondary.btn-sm.ml-3((click)="resendInvite(licenseUser)") Resend
      .row
        .container
          .row.my-5
            .col-md-4
              .academy-name Invite to Academy
              .academy-header.font-weight-light Add a teacher or admin to your Academy. They will receive an email with a link to accept their Academy license.
            .col-md-8
              form([formGroup]="licenseInvite", (ngSubmit)="formSubmit(licenseInvite)")
                #licenseSent.alert.alert-success(*ngIf="this.inviteSuccess.sent")
                  b Sent&nbsp;
                  | Academy invite sent!
                #licenseResent.alert.alert-success(*ngIf="this.inviteSuccess.resent")
                  b Resent&nbsp;
                  | Academy invite updated and resent!
                #licenseInviteServerError.alert.alert-warning(*ngIf="inviteError.server")
                  b Server Error&nbsp;
                  | There was an error processing the invite. 
                  a.link(href="mailto:support@edji.it") Please contact support.
                .form-group
                  //- Name of Teacher
                  label Name
                  input#licenseInviteNameInput.mb-0(
                    type="text",
                    [formControl]="licenseInvite.controls['name']",
                    tabindex="0"
                  )
                  #errorTitle.alert.alert-info(*ngIf="licenseInvite.controls['name'].hasError('required') && (licenseInvite.controls['name'].dirty)") 
                    | Please enter the name of the teacher for the license invite
                .form-group
                  //- Email Address
                  label Email
                  input#licenseInviteEmailInput.mb-0(
                    type="text", 
                    [formControl]="licenseInvite.controls['email']", 
                    tabindex="0"
                  )
                  #licenseInviteErrorNoEmail.alert.alert-warning(*ngIf="licenseInvite.controls['email'].hasError('required') && (licenseInvite.controls['email'].dirty)") 
                    | Please enter the email address of the teacher for the license invite
                  #licenseInviteErrorBadEmail.alert.alert-warning(*ngIf="licenseInvite.controls['email'].hasError('emailIncorrect') && licenseInvite.controls['email'].dirty && !licenseInvite.controls['email'].hasError('required')") 
                    | We don't think that's an email...
                .form-group
                  //- Role
                  label Role
                  select.role-select.mb-0#licenseRole([formControl]="licenseInvite.controls['role']")
                    option(*ngFor="let role of licenseRoles", [ngValue]="role.value", tabindex="0") {{role.label}}
                .form-group.mt-4
                  button.btn.btn-primary.float-right#licenseInviteSubmitBtn(
                    type="submit", 
                    [disabled]="!licenseInvite.valid",
                    tabindex="0"
                  ) Submit
  .col-md-4.px-2
    .container.academy-container.py-4
      .row
        .col-12
          .academy-name Request or Update Academy Licenses
          .academy-header.font-weight-light To change your Academy’s number of licenses, update Acadmey information, or for other Hero Academy support, submit your request below.
          form([formGroup]="licenseRequest", (ngSubmit)="sendRequest(licenseRequest)")
            .form-group.mt-4
              //- Request Type
              label Request Type
              select.role-select.mb-0#licenseReqTypeInput([formControl]="licenseRequest.controls['request']")
                option(*ngFor="let requestType of licenseUpdateTypes", [ngValue]="requestType.value") {{requestType.label}}
            .form-group
              //- Message
              label Message
              textarea#licenseReqMsgInput.mb-0(
                rows="4",
                [formControl]="licenseRequest.controls['message']",
                placeholder="Additional information, such as number of licenses..."
              )
              #errorTitle.alert.alert-info(*ngIf="licenseRequest.controls['message'].hasError('required') && (licenseRequest.controls['message'].dirty)") 
                | Please enter a message
            .row
              .col-12
                i.academy-header.font-weight-light Edji Support will contact you within 48 hours to confirm completion or get additional information
              .col-12.float-right.mt-4
                #successRequestSent.alert.alert-success(*ngIf="licenseRequestSent")
                  strong Request Sent!&nbsp;
                  | We will be reaching out to you shortly.
                #msgServerError.alert.alert-danger(*ngIf="errorObject.serverError")
                  strong Oh no!&nbsp;
                  | {{errorObject.serverError}}
                button.btn.btn-primary.float-right#licenseInviteSubmitBtn(type="submit", [disabled]="!licenseRequest.valid") Request