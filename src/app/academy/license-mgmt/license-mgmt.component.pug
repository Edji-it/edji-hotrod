nav-bar([showDashboardOptions]="true")
.academy-bg
.container.academy-container
  .row
    .col-6
      .academy-header Academy
      .academy-name {{currentAcademy ? currentAcademy.name : 'Academy'}}
    .col-6.text-right
      .academy-header Licenses
      .licenses-available.mr-4 {{license ? license.max_users - license.users.length : 0}} 
        .text-smaller available
      button.btn.academy-pill {{license ? license.users.length : 0}} 
        .text-smaller in Use
  .row
    .container(*ngIf="licenseUsers.length > 1")
      table.table.table-striped.licenses-table
        thead
          tr
            th.check-box(scope="col")
            th.academy-header(scope="col") Educator
            th.academy-header(scope="col") Role
            th.academy-header(scope="col") Joined Academy
        tbody
          tr.no-border(*ngFor="let licenseUser of licenseUsers")
            td
            td {{ licenseUser.educator }}
            td {{ licenseUser.role }}
            td {{ licenseUser.joined | edjidate:'timeStamp':'shortDate' }}
  .row
    .container
      .academy-name.mt-5 Invite to Academy
      .academy-header.font-weight-light Add a teacher or admin to your Academy. They will receive an email with a link to accept their Academy license.
      form([formGroup]="licenseInvite", (ngSubmit)="formSubmit(licenseInvite)")
        //- Name of Teacher
        .form-group
          label Name
          input#licenseInviteNameInput(
            type="text",
            [formControl]="licenseInvite.controls['name']",
            tabindex="0"
          )
          #errorTitle.alert.alert-info(*ngIf="licenseInvite.controls['name'].hasError('required') && (licenseInvite.controls['name'].dirty || submitted)") 
            | Please enter the name of the teacher for the license invite
        //- Email Address
        .form-group
          label Email
          input#licenseInviteEmailInput(
            type="text", 
            [formControl]="licenseInvite.controls['email']", 
            tabindex="1"
          )
          #licenseInviteErrorNoEmail.alert.alert-info(*ngIf="licenseInvite.controls['email'].hasError('required') && (licenseInvite.controls['email'].dirty || submitted)") 
            | Please enter the email address of the teacher for the license invite
          #licenseInviteErrorBadEmail.alert.alert-info(*ngIf="licenseInvite.controls['email'].hasError('emailIncorrect') && licenseInvite.controls['email'].dirty && !licenseInvite.controls['email'].hasError('required')") 
            | We don't think that's an email...
        button.btn.btn-primary(type="submit", [disabled]="!licenseInvite.valid") Submit
license-invite-support([showModal]="showLicenseInviteModal", (closeModal)="showLicenseInviteModal=false")