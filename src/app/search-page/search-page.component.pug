nav-bar([showDashboardOptions]="true")
.container.mt-4
    .row
        .col-12.my-4
            ng-container(*ngIf="!isSearching")
                h1.mb-1 Discover Readings
                p.small.mt-2 Find readings created by others to use or modify for your class.
            ng-container(*ngIf="isSearching")
                h1.mb-1(style="display: flex;")
                    | My search for
                    .form-inline.ml-2
                        .input-group.input-group-lg
                            .input-group-prepend-icon((click)="searchInput.focus()")
                                i.icon.icon-search
                            input#readingSearch.form-control(
                                #searchInput,
                                name="SearchTermInput", 
                                [(ngModel)]="searchTerm", 
                                type="text", 
                                style="text-align: left;", 
                                placeholder="Search...",
                                (keyup.enter)="loadFeed('search_term')"
                            )
                p.mt-2 Found <b>{{ total || 0 }}</b> readings
                br
    .row
        .col-md-4
                .form-group(*ngIf="!isSearching")
                    .input-group.input-group
                        .input-group-prepend-icon((click)="searchInput.focus()")
                            i.icon.icon-search
                        input#readingSearch.form-control(
                            #searchInput,
                            name="SearchTermInput", 
                            [(ngModel)]="searchTerm", 
                            type="text", 
                            style="text-align: left;", 
                            placeholder="Search...",
                            (keyup.enter)="loadFeed('search_term')"
                        )
                .form-group
                    label Community
                    //- Public Library
                    div
                        button.btn.btn-filter( 
                            title="See public readings from all users",
                            [class.active]="!activeLibrary || activeLibrary === 'public'",
                            (click)="activeLibrary = 'public'; loadFeed('filter_public')"
                        )
                            span([innerHTML]="':earth_americas: Public Library' | emojione")
                    //- Following 
                    div
                        button.btn.btn-filter( 
                            title="Filter by users you follow",
                            [class.active]="activeLibrary === 'following'",
                            (click)="activeLibrary = 'following'; loadFeed('filter_following')"
                        )
                            span([innerHTML]="':green_heart: Following' | emojione")
                    //- Academy Libraries
                    //- div(*ngFor="let academy of academies")
                    //-     button.btn.btn-filter( 
                    //-         title="Filter by your academy's library",
                    //-         [class.active]="activeLibrary === 'ACADEMYID'",
                    //-         (click)="activeLibrary = 'ACADEMYID'; loadFeed('filter_academy')"
                    //-     )
                    //-         span([innerHTML]="':school: Academy Name' | emojione")
                .form-group
                    label Subjects
                    ss-multiselect-dropdown(
                        id="subjectDropdown",
                        [(ngModel)]="subjectFilter",
                        [options]="subjects", 
                        [settings]="subjectDropSettings",
                        (dropdownClosed)="loadFeed('search_filter')"
                    )
                br
                .form-group(style="clear:left;")
                    label Grade Level
                        button.btn-secondary.btn-sm.filter-clear(
                            *ngIf="gradesSelected.length > 0",
                            (click)="gradesSelected = []; loadFeed('')"
                        ) Clear
                    grade-selector([(ngModel)]="gradesSelected", (ngModelChange)="loadFeed('filter_gradeLevel')")
                //- .form-group
                //-     label Subjects
                    //- ss-multiselect-dropdown([options]="subjects", [(ngModel)]="subjectFilter", [settings]="subjectDropSettings")
        .col-md-8
            #notFollowingMessage.alert.alert-light(*ngIf="!searchTerm && !loading && activeLibrary == 'following' && readings.length < 1")
                h4 Time to follow someone!
                p Follow Edji to see some of our latest curated Readings.
                .comment__avatar Ed
                follow-tag(
                    id="followEdjiTag",
                    [owner]="edjiOwnerObj",
                    (followEvent)="loadFeed('')"
                )
            .row.loading(*ngIf="loading")
            //- No results message when user is genuinely searching
            .alert.alert-info(*ngIf="searchTerm && !loading && readings.length < 1")
                b No Readings Found
                | There are no readings for "{{searchTerm}}" with your current filters, please try a different term or expanding your filters. 
            <p-dataList [value]="readings" [paginator]="readings.length > 0" [paginatorPosition]="'both'" [rows]="rows" [lazy]="true" (onLazyLoad)="loadFeed('feed_paginate', $event)" [totalRecords]="total" [emptyMessage]="''">
                <ng-template let-reading pTemplate="item">
                   .col-12.feed__reading(*ngIf="reading")
                        div {{index}}
                        .feed__reading-data.mb-2(*ngIf="reading.owner")
                            .comment__avatar.mb-0 {{reading.owner.fullname.substr(0,2).toUpperCase()}}
                            follow-tag([owner]="reading.owner")
                            i.hidden-md-down.ws-nowrap {{ ' shared ' + (reading.updatedAt | edjidate:'timeAgo':null:secondsAgo) }}
                            .btn.btn-sm.btn-primary.float-right([routerLink]="['/new-reading']", [queryParams]="{ copyId: reading._id }") Get this Reading
                            i.hidden-lg-up.ws-nowrap {{ ' shared ' + (reading.updatedAt | edjidate:'timeAgo':null:secondsAgo) }}
                        hot-reading-card([reading]="reading", [readOnly]="true")
                        .feed__reading-preview(*ngIf="reading.words_preview")
                            span.w(
                                    *ngFor="let w of reading.words_preview", 
                                    [ngClass]="[ w && w.styles ? w.styles.join(' ') : '' ]"
                                )
                                | {{ (!(w && w.styles) || (w && w.styles.indexOf('space')) > -1) ? '&nbsp;' : w && w.str }}
                                div(*ngIf="w && w.styles && w.styles.indexOf('img') > -1")
                                    //- Image: Display image for image "word"
                                    img.reading-image(
                                        [attr.id]="'readingImage' + i",
                                        [attr.index]="i",
                                        [src]="w.url"
                                    )
                            span.w &hellip;
                </ng-template>
            </p-dataList>