nav-bar([showDashboardOptions]="true")
.mt-4.overflow-override([ngClass]="searchParams.district.length > 0 && academyState && academyState.academies && academyState.academies.length===0 ? 'container-fluid' : 'container'")
    .row
        .col-12.my-4
            ng-container(*ngIf="!isSearching")
                h1.mb-1 Discover Readings
                p.small.mt-2 Find readings created by others to use or modify for your class.
            ng-container(*ngIf="isSearching")
                h1.mb-1(style="display: flex;")
                    | My search for
                    .form-inline.ml-2
                        .input-group.input-group-lg
                            .input-group-prepend-icon((click)="searchInput.focus()")
                                i.icon.icon-search
                            input#readingSearch.form-control.form-control-autosize(
                                #searchInput,
                                name="SearchTermInput",
                                [(ngModel)]="searchParams.searchTerm",
                                type="text",
                                style="text-align: left;",
                                placeholder="Search...",
                                (keyup.enter)="updateSearchParams('search_term')",
                                [style.minWidth]="searchFieldWidth",
                                (keyup)="searchFieldWidth = dummySearchField.clientWidth"
                            )
                            .form-control-clear.icon.icon-close(
                                *ngIf="searchParams.searchTerm.length > 0",
                                (click)="searchParams.searchTerm = ''; updateSearchParams(''); isSearching=false"
                            )
                            .form-control.form-control-dummysize(#dummySearchField) {{ searchParams.searchTerm }}
                div.mt-2
                    span(*ngIf="!loading") Found <b data-test="searchCount" id="searchCount">{{ total || 0 }}</b> readings&nbsp;
                    a.link(
                        *ngIf="filterCount > 0",
                        tabindex="0",
                        (click)="clearFilterVars(true); updateSearchParams('')",
                        title="Click to clear"
                    )
                        |with {{ filterCount }} filters
                        i.icon.icon-close.mx-1
                br
    .row
        .col-lg-3.order-md-1.mb-4(*ngIf="searchParams.district.length > 0 && academyState && academyState.academies && academyState.academies.length===0")
            #academyBanner
                .container
                    .row.mb-3
                        .col-3.p-0.pr-2
                            img.academy-logo(src="/assets/images/logo-academy-library.svg")
                        .col-9.p-0
                            h3.d-inline-block.m-0 Academies teach together
                    .row
                        .col-12.p-0
                            p.academy-text.mb-2 Others in your district are on Edji!
                            p.academy-text.mb-4 Edji Academy makes it easy for your school or district to get you Hero, while also establishing an Academy Library.
                        .col-12.p-0.center
                            button.btn.btn-academy((click)="goToAcademyPricing()") Becoming an Academy
        .col-md-3
                .form-group(*ngIf="!isSearching")
                    .input-group.input-group
                        .input-group-prepend-icon((click)="searchInput.focus()")
                            i.icon.icon-search
                        input#readingSearch.form-control(
                            #searchInput,
                            name="SearchTermInput",
                            [(ngModel)]="searchParams.searchTerm",
                            type="text",
                            style="text-align: left;",
                            placeholder="Search...",
                            (keyup.enter)="updateSearchParams('search_term')"
                        )
                .form-group
                    label Community
                    //- Public Library
                    div
                        button#discoverFilterPublic.btn.btn-filter(
                            title="See public readings from all users",
                            [class.active]="!searchParams.activeLibrary || searchParams.activeLibrary === 'public' && searchParams.district.length===0",
                            (click)="searchParams.activeLibrary = 'public'; searchParams.first=0; updateSearchParams('filter_public')"
                        )
                            span([innerHTML]="':earth_americas: Public Library' | emojione")
                    //- My District
                    div
                        button#discoverFilterDistrict.btn.btn-filter(
                            *ngIf="userDistrict",
                            title="Filter by shared readings in your district",
                            [class.active]="searchParams.district.length > 0",
                            (click)="setDistrictParam(); searchParams.first=0; updateSearchParams('filter_district')"
                        )
                            i.icon.icon-district-sm(style="vertical-align:middle;")
                            | My District
                    //- Academy Library
                    div
                        button#discoverAcademyLibrary.btn.btn-filter(
                            *ngIf="academyState && academyState.academies && academyState.academies.length > 0",
                            title="Filter by shared readings in your academy",
                            [class.active]="searchParams.activeLibrary === 'academy'",
                            (click)="searchParams.activeLibrary = 'academy'; searchParams.first=0; updateSearchParams('filter_academy')"
                        )
                            i.icon.icon-district-sm(style="vertical-align:middle;")
                            | Academy Library
                    //- Following
                    div
                        button#discoverFilterFollowing.btn.btn-filter(
                            title="Filter by users you follow",
                            [class.active]="searchParams.activeLibrary === 'following' && searchParams.district.length===0",
                            (click)="searchParams.activeLibrary = 'following'; searchParams.first=0; updateSearchParams('filter_following')"
                        )
                            span([innerHTML]="':green_heart: Following' | emojione")
                .form-group
                    label Collections
                    div
                        button.btn.btn-filter#discoverFilterStrategies(
                            title="Find strategy templates by Edji to get you started",
                            [class.active]="searchParams.activeLibrary === 'strategies'",
                            (click)="searchParams.activeLibrary = 'strategies'; searchParams.first=0; updateSearchParams('filter_following')"
                        )
                            i.icon.icon-strategies-sm(style="vertical-align:middle;")
                            | Strategies
                .form-group
                    label Subjects
                        button.btn-link.filter-clear(
                            *ngIf="searchParams.subjectFilter.length > 0",
                            (click)="searchParams.subjectFilter = []; updateSearchParams('')"
                        ) Clear
                    ss-multiselect-dropdown(
                        id="subjectDropdown",
                        [(ngModel)]="searchParams.subjectFilter",
                        [options]="subjects",
                        [settings]="subjectDropSettings",
                        (dropdownClosed)="updateSearchParams('search_filter')"
                    )
                br
                .form-group(style="clear:left;")
                    label Grade Level
                        button.btn-link.filter-clear(
                            *ngIf="gradesSelected.length > 0",
                            (click)="gradesSelected = []; updateSearchParams('')"
                        ) Clear
                    grade-selector([(ngModel)]="gradesSelected", (ngModelChange)="updateSearchParams('filter_gradeLevel')")
                //- .form-group
                //-     label Subjects
                    //- ss-multiselect-dropdown([options]="subjects", [(ngModel)]="searchParams.subjectFilter", [settings]="subjectDropSettings")
        div([ngClass]="searchParams.district.length > 0 && academyState && academyState.academies && academyState.academies.length===0 ? 'col-md-6' : 'col-md-9'")
            #discoverStrategies.strategies-banner.mb-5.p-3(*ngIf="searchParams.activeLibrary === 'strategies'")
                .row
                    .col-2.px-4.py-0
                        i.icon-strategies-lg.d-inline-block.w-100.h-100
                    .col-6.p-0
                        h2.mb-1 Strategy Templates!
                        p.banner-text.mb-0 Reading strategy templates for trying new approaches in your classroom
                    .col-4.px-4.py-0
                        //- , style="max-width: 400px;"
                        img(src="/assets/images/graphic-strategies.svg")
            #discoverMyDistrict.district-header(*ngIf="searchParams.district.length > 0")
                div
                  i.icon-district-lg
                  h2.district-header__text {{ userDistrict }} District
                .district-subheading
                  p.font-gray Reading from teachers in your district
                            //- @todo: Enable link when district is displayed on account
                            //- a.link(
                            //-     tabindex="0",
                            //-     (click)="goToAccount()",
                            //-     title="Click to see your district"
                            //- )
                            //-     |your district
            #notFollowingMessage.alert.alert-light(*ngIf="searchAlerts.notFollowing")
                h4 Time to follow someone!
                p Follow Edji to see some of our latest curated Readings.
                .comment__avatar Ed
                follow-tag(
                    id="followEdjiTag",
                    [owner]="edjiOwnerObj",
                    (followEvent)="user.isLoggedIn ? loadFeed() : showLoginModal = true"
                )
            //- Server error while loading
            .alert.alert-warning(*ngIf="searchAlerts.serverError")
                b Error Loading
                | There was an error on our server or your connection, please try again or contact us if you continue to have an issue.
            //- No results message when user is genuinely searching
            .alert.alert-info(*ngIf="searchAlerts.noResults && !searchParams.district")
                b No Readings Found
                | There are no readings for "{{searchParams.searchTerm}}" with your current filters, please try a different term or expanding your filters.
            //- No results message when user is genuinely searching
            .alert.alert-info(*ngIf="searchAlerts.noResults && searchParams.district")
                b No Shared Readings From Your District
                p We couldn't find any shared readings from your district. You can see readings from other Teachers in your district by inviting them to Edji.
                button.btn.btn-primary((click)="showReferral()") Refer a Friend
            .row.loading(*ngIf="loading")
            ng-container(*ngIf="isSearching || filterCount > 0")
                .found__readings
                    span(*ngIf="!loading") Found <b data-test="searchCount">{{ total || 0 }}</b> readings&nbsp;
                    a.link(
                        *ngIf="filterCount > 0",
                        tabindex="0",
                        (click)="clearFilterVars(true); updateSearchParams(''); isSearching=false",
                        title="Click to clear"
                    )
                        |with {{ filterCount }} filters
                        i.icon.icon-close.mx-1
                br
            <p-dataList class="search-datalist" [value]="readings" [paginator]="readings.length > 0" [paginatorPosition]="'both'" [rows]="rows" [lazy]="true" (onLazyLoad)="updateSearchParams('feed_paginate', $event)" [totalRecords]="total" [emptyMessage]="''">
                <ng-template let-reading pTemplate="item" let-i="index">
                   .col-12.feed__reading(*ngIf="reading")
                        .feed__reading-data.mb-2(*ngIf="reading.owner")
                            user-avatar([userDetails]="reading.owner")
                            follow-tag(
                                [owner]="reading.owner",
                                (followEvent)="!user.isLoggedIn ? showLoginModal = true : ''"
                            )
                            i.hidden-md-down.ws-nowrap {{ ' shared ' + (reading.updatedAt | edjidate:'timeAgo':null) }}
                            .btn.btn-sm.btn-primary.float-right(
                                (click)="openReadingPreview(reading)",
                                [class.force-hover]="previewIndex===i"
                            ) Preview
                            i.hidden-lg-up.ws-nowrap {{ ' shared ' + (reading.updatedAt | edjidate:'timeAgo':null) }}
                        .clickable(
                            (click)="openReadingPreview(reading)",
                            (mouseenter)="readingCardHoverSet(i)",
                            (mouseleave)="readingCardHoverSet(-1)"
                        )
                            hot-reading-card(
                                [reading]="reading",
                                [readOnly]="true"
                            )
                            .feed__reading-preview.words--read-only(*ngIf="reading.words_preview")
                                span.w(
                                        *ngFor="let w of reading.words_preview",
                                        [ngClass]="[ w && w.styles ? w.styles.join(' ') : '' ]"
                                    )
                                    | {{ (!(w && w.styles) || (w && w.styles.indexOf('space')) > -1) ? '&nbsp;' : w && w.str }}
                                    div(*ngIf="w && w.styles && w.styles.indexOf('img') > -1")
                                        //- Image: Display image for image "word"
                                        img.reading-image(
                                            [attr.id]="'readingImage' + i",
                                            [attr.index]="i",
                                            [src]="w.url"
                                        )
                                span.w &hellip;
                </ng-template>
            </p-dataList>
//- Reading Preview Modal
hot-reading-preview-modal(
    *ngIf="showReadingPreviewModal",
    [reading]="selectedReading",
    [user]="user",
    (closeModal)="closeReadingPreview($event)",
    (createSuccess)="readingCreateFromPreviewSuccess($event)",
    [context]="'created'"
)
//- Confirm if user wants to archive a past reading
hot-confirm-archive-modal.modal-will-fade(
  *ngIf="showConfirmArchiveModal",
  [class.show]="showConfirmArchiveModal",
  (confirmArchive)="showConfirmArchiveModal=false; showFirstGroupModal = true",
  (declineArchive)="showConfirmArchiveModal=false",
  (goHero)="showHeroParam=true",
  (closeModal)="showConfirmArchiveModal=false",
  [readingToArchive]="readingToArchive"
)
//- Create First Group
hot-add-project-modal.modal-will-fade(
    *ngIf="showFirstGroupModal",
    [class.show]="showFirstGroupModal",
    [heading]="'Create and Share First Group'",
    [subheading]="'Your Reading has been saved! Now create your first group to publish this Reading and share with students.'",
    [reading]="createdReading",
    [groupLabel]="'Group 1'",
    (groupSaved)="finalizeShare($event)",
    (closeModal)="showFirstGroupModal = false"
)
//- Login modal with option to switch to registration page
hot-login-modal.modal-will-fade(
    *ngIf="showLoginModal",
    [class.show]="showLoginModal",
    [loginOnly]="true",
    (closeModal)="closeLoginModal($event)"
)
