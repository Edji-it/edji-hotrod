//- Reading Report Pane
.sliding-pane.from-left.reading-report([ngClass]="{ 'slide-in' : visible }")
  .container-fluid.container--less-pad
    button.close.stats-close-btn.btn-icon--round((click)='hide.emit()' type='button')
      span(aria-hidden='true') &times;
    button.btn.btn-success.btn-sm.float-right.mr-5.cody-btn-update Send Copy
  .container-fluid.container--less-pad.px-5
    //- Header Block
    .row
      .col-8
        .row
          .col-12
            h1 Josh's Reading Report
        //- Reading and Group Info
        .row.mt-5
          .col-12
            div Nasa Publishes SpaceX's Proposal for a Futuristic Kennedy Space Center
            hr.mt-0
            .row
              //- Assignment and Standards
              .col-10
                .row
                  .col-12
                    div Group Assignment
                    div In this reading students are learning about a genre of video game and how it relates to Shakespeare, paying attention to analogies.
                .row
                  .col-12
                    div CCSS.ELA-LITERACY.RI.5.2
                    div Determine two or more main ideas of a text and explain how they are supported by key details; summarize the text.
              //- Reading Stats
              .col-2
                div Contents
                div 780 Words
                div 2 Images
                div 3 Questions
      //- Teacher/Group Names
      .col-4
        .row
          .col-12
            div Teacher
            div Will Stewart
        .row
          .col-12
            div Group
            div Advisory
    //- Stat's Block
    .row.mt-5
      .col-12
        div Josh's Stats
        hr.mt-0
    .row
      .col-4
        div Small Graph 1
      .col-4
        div Small Graph 2
      .col-4
        div Small Graph 3
    .row.mt-5
      .col-12
        div Comments
        hr.mt-0
    //- Comment Block
    .row
      .col-3
        div Comment Block
      .col-9
        div Comment words on the text itself
    .row.mt-5
      .col-12
        div Summarize and Share
        hr.mt-0
    //- Summarize and Share Block
    .row
      .col-4
        .row
          .col-12
            div Summarize Josh's work with this reading, and send a PDF copy of this report to their student email, a parent, or a fellow teacher
        .row
          .col-12
            div An image of the report
      .col-8
        .row
          label Evaluation
          textarea
        .row
          label Email
          input(type="text")