.fireBound
  user-avatar([userId]="fireComment.user_id")
  .fireBlock
    .list-item.list-item--block.fireTime-card
      | {{fireComment.author}}
      span.fireTime-card__time &nbsp;{{ fireComment.createdAt | edjidate:'timeAgo':null }}
    //- Emoji Comment display
    .list-item.list-item--block.fireComment-card(*ngIf="fireComment.type == 'emoji' || !fireComment.type")
      <div class="emoji-comment-input" [innerHtml]="fireComment.data && fireComment.data.length > 0 ? (fireComment.data | emojione) : '<span class=\'sample-placeholder\'>Empty...</span>'"></div>
    //- Text Comment display
    <div class="list-item list-item--block fireComment-card" *ngIf="fireComment.type == 'text'" [innerHtml]="fireComment.data && fireComment.data.length > 0 ? (fireComment.data | linkify | emojione) : '<span class=\'sample-placeholder\'>Empty...</span>'"></div>
    //- Audio comment display
    .list-item.list-item--block.fireComment-card.fireCard-audio(*ngIf="fireComment.type == 'audio'")
      button.btn-audio.btn-fc-audio([class.disabled]="!playAble")
        i.icon-play([class.hide]="isPlaying", (tap)="play()")
        i.icon-pause([class.hide]="!isPlaying", (tap)="pause()")
      button.btn-audio.btn-fc-audio((tap)="isRecording=false; isPlaying=false; restartPlayback()")
        i.icon-restart
      .wave-wrap
        canvas.wave-form((tap)="setPlaybackTime($event)")
        .playing([class.hide]="!audio || !audio.currentTime", [style.width]="getPlayhead() + '%'")
    .list-item.list-item.fireHighlight-card.h-1(*ngIf="!isImageSpot")
      | {{ fireComment.text ? fireComment.text : '...'}}
    .list-item.list-item.fireHighlight-card_liImage.h-1(*ngIf="isImageSpot")
      .fireHighlight-card_image Image
      button.fireHighlight-card_button((tap)="getImagePos(fireComment.start)") View&nbsp;&#8594;
