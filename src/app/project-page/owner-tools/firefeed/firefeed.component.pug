<!--Fire Feed Pane-->
.sliding-pane.from-left(*ngIf='currentReading && currentReading.words', [ngClass]="{ 'slide-in' : visible }")
  .container-fluid.container--less-pad
    h4
      | Fire Feed
      button.close.stats-close-btn.btn-icon--round((click)='hide.emit()', type='button')
        span(aria-hidden='true') ×
    hot-firecard(*ngFor='let fireComment of project.comments', [fireComment]='fireComment')
    .fireBound
      .fire-icon--light
        span.is-emoji([innerHtml]="':seedling:' | emojione")
      .fireBlock
        .list-item.list-item--block.fireTime-card
          | {{ project.createdAt | edjidate:'timeAgo':null }}
        p.small
          b {{project.label}}
          |  group was created for 
          i {{currentReading.title}}
          | .