#ownerToolsBar.toolbar.hidden-md-down(*ngIf="currentProject && currentProject.isTeaching")
  label.bar-title Owner
  //- Buttons for toggling panes and tools
    - Desktop Buttons
  //- Comment Stats pane
  button#toggleLeaderboard.btn.toolbar__btn.btn-cmt(
    type="button",
    aria-label="Comment Counts",
    [routerLink]="'./'",
    [queryParams]="{ pane: 'students' }",
    [class.disabled]="currentProject.archived"
  )
    //- img(*ngIf="isMobile" style="width: 50px;" src="assets/images/icon-comment.svg")
    img(src="assets/images/icon-leaderboard.svg")
    label Students
  //- Heat Vision toggle
  button.btn.toolbar__btn.btn-hv(
    type="button",
    (tap)="togglePower('heat_vision', !this.currentProject.heat_vision)",
    [class.disabled]="currentProject.archived"
  )
    //- placement={{tooltipPlacement}} ngbTooltip="Turn on Heat Vision to let readers see comments from other readers, turn it off to make comments private!"
    i#toggleHeatVision.icon-heatvision(*ngIf="currentProject", [ngClass]="[!currentProject.heat_vision ? 'inactive' : 'active']")
    span.badge.badge-pill.badge-primary(*ngIf="currentProject.heat_vision") On
    span.badge.badge-pill.badge-secondary(*ngIf="!currentProject.heat_vision") Off
    label Vision
  //- All Comments
  button.btn.toolbar__btn(
    type="button",
    [routerLink]="'./'",
    [queryParams]="{ pane: 'comments' }",
    [class.disabled]="currentProject.archived"
  )
    i#toggleAllComments.icon-comment-feed
    span.badge.badge-pill.badge-info(*ngIf="statsLoaded") {{ commentCount }}
    label Comments
  //- Question Feed toggle
  div(*ngIf="currentReading.questions && currentReading.questions.length>0")
    button.btn.toolbar__btn.btn-hv(
      type="button",
      [routerLink]="'./'",
      [queryParams]="{ pane: 'questions' }",
      [class.disabled]="currentProject.archived"
    )
      i#toggleQuestionfeed.icon-question(*ngIf="currentProject")
      label Questions
  //- Reading Report toggle
  a.btn.toolbar__btn.btn-hv.btn-reading-recap(
    type="button",
    [routerLink]="'./'",
    [queryParams]="{ recap: true }",
    [class.hero--micro-offer__wrap]="user && !user.hero_status",
    [class.disabled]="currentProject.archived"
  )
    i#toggleReadingRecap.icon-reading-recap(*ngIf="currentProject")
    label Recap

.toolbar__btn--mobile.hidden-lg-up(*ngIf="currentProject && currentProject.isTeaching")
  //- Mobile Buttons
  .toolbar-group--mobile([class.btn-group-show--animation]="ownerToolShow", [style.max-height]="ownerToolBlockHeight")
    //- Comment Stats pane
    a#toggleLeaderboard--narrow-viewport.btn.btn-icon--circle-shadow.toolbar--mobile(
      type="button",
      [routerLink]="'./'",
      [queryParams]="{ pane: 'students' }",
      [class.btn-show--animation]="ownerToolShow",
      [class.disabled]="currentProject.archived"
    )
      img(src="assets/images/icon-leaderboard.svg", [class.hide]="!ownerToolShow", style="width: 32px;")
      //- label Tally
    //- Heat Vision toggle
    button.btn.btn-icon--circle-shadow.toolbar--mobile(
      type="button",
      (tap)="togglePower('heat_vision', !this.currentProject.heat_vision); ownerToolShow=!ownerToolShow",
      [class.btn-show--animation]="ownerToolShow",
      [class.disabled]="currentProject.archived"
    )
      i#toggleHeatVisionMobile.icon-heatvision.toolbar-icon-mobile(*ngIf="currentProject", [ngClass]="[!currentProject.heat_vision ? 'inactive' : 'active']")
      span.badge.badge-pill.badge-primary(*ngIf="currentProject.heat_vision") On
      span.badge.badge-pill.badge-secondary(*ngIf="!currentProject.heat_vision") Off
      //- label Vision
    //- All Comments toggle
    a.btn.btn-icon--circle-shadow.toolbar--mobile(
      type="button",
      [routerLink]="'./'",
      [queryParams]="{ pane: 'comments' }",
      [class.btn-show--animation]="ownerToolShow",
      [class.disabled]="currentProject.archived"
    )
      i#toggleFirefeedMobile.icon-comment-feed.toolbar-icon-mobile(*ngIf="currentProject")
      span.badge.badge-pill.badge-info(*ngIf="statsLoaded && commentCount > 0") {{ commentCount }}
      //- label Feed
    //- Question Feed toggle
    div(*ngIf="currentReading.questions && currentReading.questions.length>0")
      a.btn.btn-icon--circle-shadow.toolbar--mobile(
        type="button",
        [routerLink]="'./'",
        [queryParams]="{ pane: 'questions' }",
        [class.btn-show--animation]="ownerToolShow",
        [class.disabled]="currentProject.archived"
      )
        i#toggleQuestionfeedMobile.icon-question.toolbar-icon-mobile(*ngIf="currentProject")
        //- label Questions
  a#buttonOwnerToolToggle.btn.btn-icon--circle-shadow.mobile-menu-spot(
    *ngIf="!ownerToolShow",
    (tap)="ownerToolShow = true"
  )
    span.label Tools
  a#buttonOwnerToolToggle.btn.btn-icon--circle-shadow.mobile-menu-spot(
    *ngIf="ownerToolShow",
    (tap)="ownerToolShow = false"
  )
    span.label.text-muted Close

//- Leaderboard goes here
hot-leaderboard(
  [archived]="currentProject.archived"
)

//- Question Feed goes here
hot-questionfeed()

//- Reading Report goes here
hot-reading-recap()
