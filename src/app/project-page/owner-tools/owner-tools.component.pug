.owner-bar(*ngIf="currentProject && user._id == currentProject.teacher_id")
  label.bar-title Owner
  //- Comment Stats pane
  button.btn.owner-tools__btn.btn-cmt(type="button", aria-label="Comment Counts", (click)="showElseFalse('showCommentCounts')")
    //- img(*ngIf="isMobile" style="width: 50px;" src="assets/images/icon-comment.svg")
    img(src="assets/images/icon-leaderboard.svg")
    label Tally

  //- Heat Vision toggle
  button.btn.owner-tools__btn.btn-hv(type="button", (tap)="togglePower('heat_vision', !this.currentProject.heat_vision)")
    //- placement={{tooltipPlacement}} ngbTooltip="Turn on Heat Vision to let readers see comments from other readers, turn it off to make comments private!"
    i#toggleHeatVision.icon-heatvision(*ngIf="currentProject", [ngClass]="[!currentProject.heat_vision ? 'inactive' : 'active']")
    i.power__loading.loading([class.is-loading]="powersLoading.heatVision")
    span.badge.badge-pill.badge-primary(*ngIf="currentProject.heat_vision") On
    span.badge.badge-pill.badge-secondary(*ngIf="!currentProject.heat_vision") Off
    label Vision

  //- Fire Feed toggle
  button.btn.owner-tools__btn.btn-hv(type="button", (tap)="showElseFalse('showFireFeed')")
    i#toggleFirefeed.icon-fire-feed(*ngIf="currentProject")
    span.badge.badge-pill.badge-info(*ngIf="commentStats.stats.count && commentStats.stats.count > 0") {{ commentStats.stats.count }}
    label Feed

  //- Question Feed toggle
  div(*ngIf="currentReading.questions && currentReading.questions.length>0")
    button.btn.owner-tools__btn.btn-hv(type="button", (tap)="showElseFalse('showQuestionFeed')")
      i#toggleQuestionfeed.icon-question(*ngIf="currentProject")
      label Questions

//- Leaderboard goes here
hot-leaderboard((hide)="showCommentCounts=false", [commentStats]="commentStats", [visible]="showCommentCounts")

//- Fire Feed goes here
hot-firefeed((hide)="showFireFeed=false", [visible]="showFireFeed")

//- Question Feed goes here
hot-questionfeed((hide)="showQuestionFeed=false", [visible]="showQuestionFeed")