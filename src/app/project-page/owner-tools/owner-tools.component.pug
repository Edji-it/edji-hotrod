#ownerToolsBar.owner-bar.hidden-md-down(*ngIf="currentProject && currentProject.isTeaching")
  label.bar-title Owner
  //- Buttons for toggling panes and tools
    - Desktop Buttons
  //- Comment Stats pane
  button#toggleLeaderboard.btn.owner-tools__btn.btn-cmt(
    type="button", 
    aria-label="Comment Counts", 
    (click)="showElseFalse('showCommentCounts')", 
    [class.disabled]="currentProject.archived"
  )
    //- img(*ngIf="isMobile" style="width: 50px;" src="assets/images/icon-comment.svg")
    img(src="assets/images/icon-leaderboard.svg")
    label Students
  //- Heat Vision toggle
  button.btn.owner-tools__btn.btn-hv(
    type="button", 
    (tap)="togglePower('heat_vision', !this.currentProject.heat_vision)", 
    [class.disabled]="currentProject.archived"
  )
    //- placement={{tooltipPlacement}} ngbTooltip="Turn on Heat Vision to let readers see comments from other readers, turn it off to make comments private!"
    i#toggleHeatVision.icon-heatvision(*ngIf="currentProject", [ngClass]="[!currentProject.heat_vision ? 'inactive' : 'active']")
    span.badge.badge-pill.badge-primary(*ngIf="currentProject.heat_vision") On
    span.badge.badge-pill.badge-secondary(*ngIf="!currentProject.heat_vision") Off
    label Vision
  //- All Comments
  button.btn.owner-tools__btn(
    type="button",
    (tap)="showElseFalse('showAllComments')",
    [class.disabled]="currentProject.archived"
  )
    i#toggleAllComments.icon-comment-feed
    span.badge.badge-pill.badge-info(*ngIf="commentStats.stats.comment_count && commentStats.stats.comment_count > 0") {{ commentStats.stats.comment_count }}
    label Comments
  //- Question Feed toggle
  div(*ngIf="currentReading.questions && currentReading.questions.length>0")
    button.btn.owner-tools__btn.btn-hv(
      type="button", 
      (tap)="showElseFalse('showQuestionFeed')", 
      [class.disabled]="currentProject.archived"
    )
      i#toggleQuestionfeed.icon-question(*ngIf="currentProject")
      label Questions
  //- Reading Report toggle
  button.btn.owner-tools__btn.btn-hv.btn-reading-recap(
    type="button",
    (tap)="showElseFalse('showReadingRecap')",
    [class.hero--micro-offer__wrap]="user && !user.hero_status", 
    [class.disabled]="currentProject.archived"
  )
    i#toggleReadingRecap.icon-reading-recap(*ngIf="currentProject")
    label Recap

.owner-tools-button__mobile.hidden-lg-up(*ngIf="currentProject && currentProject.isTeaching")
  //- Mobile Buttons
  .owner-options-group--mobile([class.btn-group-show--animation]="ownerToolShow", [style.max-height]="ownerToolBlockHeight")
    //- Comment Stats pane
    button#toggleLeaderboard--narrow-viewport.btn.btn-icon--circle-shadow.owner-options--mobile(
      type="button",
      (tap)="showElseFalse('showCommentCounts'); ownerToolShow=!ownerToolShow", 
      [class.btn-show--animation]="ownerToolShow", 
      [class.disabled]="currentProject.archived"
    )
      img(src="assets/images/icon-leaderboard.svg", [class.hide]="!ownerToolShow", style="width: 32px;")
      //- label Tally
    //- Heat Vision toggle
    button.btn.btn-icon--circle-shadow.owner-options--mobile(
      type="button",
      (tap)="togglePower('heat_vision', !this.currentProject.heat_vision); ownerToolShow=!ownerToolShow", 
      [class.btn-show--animation]="ownerToolShow", 
      [class.disabled]="currentProject.archived"
    )
      i#toggleHeatVisionMobile.icon-heatvision.owner-tool-icon-mobile(*ngIf="currentProject", [ngClass]="[!currentProject.heat_vision ? 'inactive' : 'active']")
      span.badge.badge-pill.badge-primary(*ngIf="currentProject.heat_vision") On
      span.badge.badge-pill.badge-secondary(*ngIf="!currentProject.heat_vision") Off
      //- label Vision
    //- All Comments toggle
    button.btn.btn-icon--circle-shadow.owner-options--mobile(
      type="button",
      (tap)="showElseFalse('showAllComments')",
      [class.btn-show--animation]="ownerToolShow", 
      [class.disabled]="currentProject.archived"
    )
      i#toggleFirefeedMobile.icon-comment-feed.owner-tool-icon-mobile(*ngIf="currentProject")
      span.badge.badge-pill.badge-info(*ngIf="commentStats.stats.count && commentStats.stats.count > 0") {{ commentStats.stats.count }}
      //- label Feed
    //- Question Feed toggle
    div(*ngIf="currentReading.questions && currentReading.questions.length>0")
      button.btn.btn-icon--circle-shadow.owner-options--mobile(
        type="button",
        (tap)="showElseFalse('showQuestionFeed'); ownerToolShow=!ownerToolShow", 
        [class.btn-show--animation]="ownerToolShow", 
        [class.disabled]="currentProject.archived"
      )
        i#toggleQuestionfeedMobile.icon-question.owner-tool-icon-mobile(*ngIf="currentProject")
        //- label Questions
  a#buttonOwnerToolToggle.btn.btn-icon--circle-shadow.mobile-menu-spot((tap)="ownerToolShow=!ownerToolShow")
    span(style="font-size: 11px;") Tools

//- All/My Comments display
comment-explorer(
  [visible]="showAllComments"
)

//- Leaderboard goes here
hot-leaderboard(
  [(visibility)]="showCommentCounts", 
  [commentStats]="commentStats", 
  [archived]="currentProject.archived",
  [coOwnerGuide]="showCoOwnerGuide"
  )

//- Question Feed goes here
hot-questionfeed((hide)="showQuestionFeed=false", [visible]="showQuestionFeed")

//- Reading Report goes here
hot-reading-recap(*ngIf="showReadingRecap", (hide)="showReadingRecap=false", [commentStats]="commentStats")