// Comments Pane
.sliding-pane.from-left([ngclass]="{ 'slide-in' : visible }")
  .container-fluid.container--less-pad
    h4
      | Comment Tally
      button.close.stats-close-btn.btn-icon--round((click)='hide.emit()' type='button')
        span(aria-hidden='true') &times;
    .user-list-item(style='opacity: 0.3; margin-bottom: 14px; white-space: nowrap; border-bottom: 1px solid #cdcdcd;')
      span {{ commentStats.stats.userStats.length }} Readers
      img(style='height: 1em; width: auto; float: right' src='assets/images/icon-comment.svg')
    .user-list-item(*ngfor='let commentUser of commentStats.stats.userStats')
      span {{ commentUser.fullname }}
      b(style='float:right;') {{ commentUser.count }}
      .question-answer-status__block(*ngif='commentUser && currentReading.questions && currentReading.questions.length > 0')
        // (click)="testAnswerFilter(commentUser)"
        .answer-designate A:
        .answer-circle__group(*ngfor='let answer of userAnswers')
          .circle(*ngif='answer.user===commentUser._id' [ngclass]="[ answer.answered ? 'filled' : '']")
