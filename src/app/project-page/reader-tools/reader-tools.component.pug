#readerToolsBar.toolbar.hidden-md-down(*ngIf="currentProject && !currentProject.isTeaching")
  label.bar-title Reader
  //- Buttons for toggling panes and tools
    - Desktop Buttons
  //- All Comments
  div([class.hover--tooltip]="!currentProject.heat_vision",)
    a.btn.toolbar__btn(
      type="button",
      [routerLink]="'./'",
      [queryParams]="{ pane: 'comments' }",
      [class.disabled]="currentProject.archived || !currentProject.heat_vision",
    )
      i#toggleAllComments.icon-comment-feed
      span.badge.badge-pill.badge-info(
        *ngIf="currentProject.heat_vision && commentStats.stats.comment_count && commentStats.stats.comment_count > 0"
      ) {{ commentStats.stats.comment_count }}
      label Discuss
      .tooltip-wrap
        .tooltip.tooltip--right
          .tooltip-title Heat Vision is turned off, others comments disabled
  a.btn.toolbar__btn(
    type="button",
    [routerLink]="'./'",
    [queryParams]="{ student: user._id }",
  )
    i#toggleAllComments.icon.icon-comment-count
    label My Notes

.toolbar__btn--mobile.hidden-lg-up(*ngIf="currentProject && !currentProject.isTeaching")
  //- Mobile Buttons
  .toolbar-group--mobile([class.btn-group-show--animation]="ownerToolShow", [style.max-height]="'130px'")
    //- All Comments toggle
    a.btn.btn-icon--circle-shadow.toolbar--mobile(
      type="button",
      (tap)="ownerToolShow=!ownerToolShow",
      [routerLink]="'./'",
      [queryParams]="{ pane: 'comments' }",
      [class.btn-show--animation]="ownerToolShow",
      [class.disabled]="currentProject.archived || !currentProject.heat_vision"
    )
      i#toggleFirefeedMobile.icon-comment-feed.toolbar-icon-mobile
      span.badge.badge-pill.badge-info(*ngIf="commentStats.stats.count && commentStats.stats.count > 0") {{ commentStats.stats.count }}
    //- label all comments
    a.btn.btn-icon--circle-shadow.toolbar--mobile(
      type="button",
      [routerLink]="'./'",
      [queryParams]="{ student: user._id }",
      [class.btn-show--animation]="ownerToolShow",
    )
      i#toggleAllComments.icon-comment-feed.toolbar-icon-mobile
  a#buttonOwnerToolToggle.btn.btn-icon--circle-shadow.mobile-menu-spot((tap)="ownerToolShow=!ownerToolShow")
    span(style="font-size: 11px;") Tools
