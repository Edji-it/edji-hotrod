nav-bar([showProjectInfo]="true")
owner-tools
.container-fluid
  .row.loading(*ngIf="!project._id", style="min-height: 600px;")
  .project-column(*ngIf="!readingArchived")
    p.alert.alert-danger(*ngIf="error") {{ error }}
    <annotator #annotator *ngIf="project._id && reading._id"></annotator>
hot-login-modal.modal-will-fade(*ngIf="!readingArchived", [projectId]="project._id", [class.show]="showLoginModal", (closeModal)="showLoginModal = false")
hot-reading-archived-modal.modal-will-fade([class.show]="readingArchived")