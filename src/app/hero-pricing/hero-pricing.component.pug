#top
nav-bar
.container-fluid
  promo-banner([currentPage]="'hero'")
  //- Promo row
  .row.twilight.has-sparks(style="padding-top:100px; padding-bottom: 100px; position: relative; overflow:hidden;")
    .sparks
    img.promo-spotlight(src="/assets/images/hero-promo-spotlight.svg")
    img(style="width:100%; position: absolute; bottom: -50px;",src="/assets/images/hero-promo-skyline.svg")
    .col-md-11.offset-md-1(style="padding-bottom:25px;")
      h1.big-bold(style="color:#fff;") Answer the Call
    .col-md-1
    .col-md-6
      p.row-xl-pad(style='font-size:1.25em; padding-top: 0px;')
        | Hero unleashes the full power of Edji, giving you unlimited access to all of your Readings, and allowing you to evaluate student engagement and provide powerful feedback right when it’s needed
        | &nbsp;
        span([innerHTML]="':tada:' | emojione")
      .btn-row.text-left
        button#topHeroCTA.btn.btn-lg.btn-hero((click)='goHero("upperCTA")')
          | Go Hero
//- Plan Details (Free, Hero, Academy) Boxes
.container
  .row.row-xl-pad.align-items-center
    .col-sm-4
      .card.card-outline-secondary
        .card-body
          h2.card-title Edji Free
          span.pricing Free
          hr
          p.card-text
            | Edji Free is an advanced set of reading creation, annotation and discussion tools for easy classroom reading and discussion.
          label Who is it for?
          p.card-text
            | Teachers that want their class to read occasionally and see their thoughts.
          a.btn.btn-primary.btn-lg.btn-block(*ngIf="!user || !user.isLoggedIn || !user.hero_status", [routerLink]="['/register']") 
            | Register
          a.btn.btn-primary.btn-lg.btn-block.disabled(*ngIf="user && user.isLoggedIn && user.hero_status", disabled) 
            | {{ user.hero_status ? 'Included' : 'Current Plan'}}
    .col-sm-4
      .card.card-outline-danger
        .card-body
          img.card-img-top(src='/assets/images/hero-lg.png')
          h2.card-title Edji Hero
          //- $5<span class="small"> / month or </span>
          p.small.hero-color-text(*ngIf="offerDetails")
            i.icon.icon-gift.mr-1
            span([innerHtml]="offerDetails")
          span.pricing
            | $5
            span.small  / month
          p.small Charged annually per teacher
          hr
          p.card-text Hero takes the limits off of Edji and gives teachers powerful evaluation and feedback tools to assist and assess their students as they read.
          label Who is it for?
          p.card-text Teachers who make reading a staple of their class and want a detailed history of their classroom engagement
          a.btn.btn-hero.btn-lg.btn-block(*ngIf="!user || !user.isLoggedIn || !user.hero_status", tabindex='1', (click)='goHero("pricingHeroCard")') Go Hero
          a.btn.btn-hero.btn-lg.btn-block(*ngIf="user && user.isLoggedIn && user.hero_status", [routerLink]="['/account']", [innerHtml]="'Current Plan &nbsp;:tada:' | emojione")
    #academy.col-sm-4
      .card.card-outline-secondary
        .card-body
          h2.card-title Hero Academy
          span.pricing Contact Us
          hr
          p.card-text
            | Academy is the easy way to get all your schools' teachers full access to Edji Hero features. Easily get teachers signed on and manage your Academy licenses.
          label Who is it for?
          p.card-text Teachers and Administrators who want to collaborate within their school.
          button.btn.btn-primary.btn-lg.btn-block((click)="showRequestAcademyModal = true") Request More Info
  .row.mt-4
    .hero-rule
  //- Academy Pricing Slider
  .row
    .col-12
      h1.mb-5 Academy Plans
      mat-slider.label-sticky(
        [min]="0", 
        [max]="5", 
        [step]="1", 
        [thumbLabel]="true", 
        [displayWith]="formatRateLabel", 
        [(ngModel)]="sliderVal",
        [tickInterval]="1"
      )
  .row.mt-4
    .col-6
      h4 {{ academyPlans[currentSliderVal].plan }}
      h3 {{ academyPlans[currentSliderVal].size }} | {{ academyPlans[currentSliderVal].cost }}
    .col-6

    .hero-rule
  //- Feature Checkboxes
  .row.no-gutters
    .col-12
      .my-2
        h2 What's included?
      .table-responsive
        table.table.table-features
          thead 
            tr
              th(scope="col", style="width:50%;") Feature
              th.text-center(scope="col") Edji Free
              th.text-center(scope="col") Edji Hero
          tbody
            ng-container(*ngFor="let feature of featureValues")
              tr([class.row-hover]="feature.info",  (click)="feature.info ? triggerInfoModal(feature.info) : null")
                td
                  span([innerHtml]="feature.name + ' '")
                  i.icon__tooltip(*ngIf="feature.info")
                    span.icon.icon-circle.icon-info  i
                  span.text-primary.learn-more.small Learn more
                //- Standard check display
                td.feature-check(*ngIf="!feature.free_override", [innerHtml]="(feature.free ? ':white_check_mark:' : ':heavy_minus_sign:') | emojione")
                td.feature-check(*ngIf="!feature.free_override", [innerHtml]="':white_check_mark:' | emojione")
                //- Override text display
                td.feature-check(*ngIf="feature.free_override", [innerHtml]="feature.free_override")
                td.feature-check(*ngIf="feature.hero_override", [innerHtml]="feature.hero_override")
  .row
    .hero-rule
.container-fluid
  .row.navy.row-xl-pad.has-sparks
      .sparks
      .col-12.text-center
        h1.big-light.on-dark(style="margin:0px;")
          | Answer the Call
        p.on-dark.mt-2.mb-4
          | Engage your students, build super lessons, and support Edji
        .button__row.pb-2
            button#heroCTA.btn-lg.btn.btn-hero((click)='goHero("pricingLowerCTA")')
              | Go Hero 
              span(style='font-weight: 700;')
hot-login-register.modal-will-fade(
  [loginHeader]='"To go Hero, first you\'ll need an account"',
  [class.show]='showLoginModal',
  (closeModal)='showLoginModal = false',
  (loginSuccess)='showHeroSubModal = true'
)
hero-subscribe-modal.modal-will-fade(
  [class.show]='showHeroSubModal', 
  [goHeroLocation]="'heroPricingPage'", 
  (closeModal)='showHeroSubModal = !showHeroSubModal', 
  (heroWasBorn)="_router.navigate(['/dashboard'])"
)
request-academy-modal.modal-will-fade(
  [class.show]="showRequestAcademyModal",
  (closeModal)="showRequestAcademyModal = false"
)
//- Feature Info Modal
.modal(*ngIf="showInfoModal")
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        h5.modal-title {{ infoModalInfo.heading }}
        button.close((click)="showInfoModal = false")
          span(aria-hidden="true") &times;
      .modal-body
        .text-center(*ngIf="infoModalInfo.image")
          img.card.mb-4(style="display:inline-block; max-height: 500px;", [src]="infoModalInfo.image")
        p([innerHtml]="infoModalInfo.description")
      .modal-footer
        .btn.btn-secondary((click)="showInfoModal = false") Close
