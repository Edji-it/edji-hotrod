.container-fluid
  .row.navy.row-xl-pad.has-sparks
      .sparks
      .col-12.text-center
        h1.big-light.on-dark(style="margin:0px;")
          | Answer the Call
        p.on-dark.mt-2.mb-4
          | Engage your students, build super lessons, and support Edji
        .button__row.pb-2
            button#heroCTA.btn-lg.btn.btn-hero((click)='goHero("pricingLowerCTA")')
              | Go Hero
              span(style='font-weight: 700;')
hot-login-register.modal-will-fade(
    [loginHeader]='"To go Hero, first you\'ll need an account"',
    [class.show]='showLoginModal',
    (closeModal)='showLoginModal = false',
    (loginSuccess)='showHeroSubModal = true')
hero-subscribe-modal.modal-will-fade([class.show]='showHeroSubModal', [goHeroLocation]="'heroPricingPage'", (closeModal)='showHeroSubModal = !showHeroSubModal', (heroWasBorn)="_router.navigate(['/dashboard'])")
request-academy-modal.modal-will-fade(
  [class.show]="showRequestAcademyModal",
  (closeModal)="showRequestAcademyModal = false"
)
//- Feature Info Modal
.modal(*ngIf="showInfoModal")
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        h5.modal-title {{ infoModalInfo.heading }}
        button.close((click)="showInfoModal = false")
          span(aria-hidden="true") &times;
      .modal-body
        .text-center(*ngIf="infoModalInfo.image")
          img.card.mb-4(style="display:inline-block; max-height: 500px;", [src]="infoModalInfo.image")
        p([innerHtml]="infoModalInfo.description")
      .modal-footer
        .btn.btn-secondary((click)="showInfoModal = false") Close
