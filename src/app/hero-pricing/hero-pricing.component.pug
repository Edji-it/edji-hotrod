#top
nav-bar
.container-fluid
  promo-banner([currentPage]="'hero'")
  //- Promo row
  .row(style="background: #44caf3; padding-top:100px; padding-bottom: 100px; position: relative; overflow:hidden;")
    .promo-circle-graphic__wrap
      img#promoCircleGraphicBottom(src="/assets/images/hero-graphic/bottom-circles.svg")
      img#promoCircleGraphicMid(src="/assets/images/hero-graphic/top-circles.svg")
      img#promoCircleGraphicSpotlight(src="/assets/images/hero-graphic/white-circle.svg")
      img#promoCircleGraphicTop(src="/assets/images/hero-graphic/hands.svg")
      img#promoCircleGraphicHero(
        src="/assets/images/hero-lg.png",
        (click)='scrollTo("plansRow")'
      )
    .col-md-11.offset-md-1(style="padding-bottom:25px; pointer-events:none;")
      h1.big-bold(style="color:#fff;") Engage Every <br/>Student
    //- .col-md-1
    .col-md-6.offset-md-1
      p.on-dark(style='font-size:1.25em; padding-top: 0px;')
        | With a Hero subscription, <br/>every lesson can be engaging
        | &nbsp;
        //- span([innerHTML]="':tada:' | emojione")
      .btn-row.left
        button#topHeroCTA.btn.btn-primary((click)='scrollTo("plansRow")')
          | Compare Plans
        button#viewPricingCTA.btn.btn-link.on-dark((click)='scrollTo("academyPlans", true)')
          | View Pricing
.container
  .row.row-xl-pad
    .col-12.col-md-4.text-center
      .promo-icon-circle-wrap.blue
        img.pl-1(src="/assets/images/icon-create.svg")
      h4 Create endless readings
      p No more limits on number of active readings
    .col-12.col-md-4.text-center
      .promo-icon-circle-wrap.yellow
        img(src="/assets/images/icon-folder.svg")
      h4 Access your archive
      p View and edit any previously created readings
    .col-12.col-md-4.text-center
      .promo-icon-circle-wrap.red
        span([innerHtml]="':calendar:' | emojione")
      h4 Plan lessons ahead of time
      p With unlimited readings, you can prepare your whole syllabus
  //- Academy Pricing Slider
  .hero-rule
  #academyPlans.row
    .col-12
      h1.mb-5 Academy Plans
      .row
        .col-2.p-0(*ngFor="let plan of academyPlans; let i = index")
          p.text-center.small.m-0([class.hide]="i==sliderPos") {{ plan.plan }}
      mat-slider.label-sticky(
        [min]="0",
        [max]="5",
        [value]="sliderPos",
        [step]="1",
        [thumbLabel]="true",
        [displayWith]="formatRateLabel",
        [tickInterval]="1",
        (input)="sliderPos = $event.value",
      )
  .row.my-4
    .col-8
      h4 {{ academyPlans[sliderPos].plan }}
      h3 {{ academyPlans[sliderPos].size }} |
        del(style="color: red;") {{ academyPlans[sliderPos].prevCost }}
        h3(style="color: green; display: inline;") &nbsp;{{ academyPlans[sliderPos].cost }}
      p.small {{ academyPlans[sliderPos].planDetail }}
      br
      i.small Additional discounts available if purchasing multiple years at once
    .col-4
      a.btn.btn-hero.btn-lg.btn-block(
        *ngIf="isAcademyHero",
        [routerLink]="['/account']",
        [innerHtml]="'Current Plan &nbsp;:tada:' | emojione"
      )
      a.btn.btn-action.btn-lg.btn-block(
        *ngIf="!isAcademyHero",
        [routerLink]="'./'",
        [queryParams]="{ request: 'academy' }",
      ) Request Quote
  .hero-rule
  #plansRow.row.row-xl-pad.align-items-top
    .col-12.col-md-6.col-lg-4.col--free-top-offset
      .card.card-outline-secondary
        .card-body
          h2.card-title Edji Free
          span.pricing Free
          p.small &nbsp;
          hr
          p.card-text.card-text--pricing
            //- | Edji Free is an advanced set of reading creation, annotation and discussion tools for easy classroom reading and discussion.
            | 2 Reading Trial
          //- label Who is it for?
          //- p.card-text.card-text--pricing
          //-   | Teachers that want their class to read occasionally and see their thoughts.
          //- Plan Details
          div(
            *ngFor="let detail of planDetails",
            (click)="detail.info ? triggerInfoModal(detail.info) : null",
            [class.clickable]="detail.info"
          )
            hr
            .label([innerHtml]="detail.label")
            p.card-text.card-text--pricing.plan-detail
              span([innerHtml]="detail.free | emojione")
              i.icon__tooltip
                span.icon.icon-circle.icon-info  i
        .card-footer
          a.btn.btn-primary.btn-lg.btn-block(*ngIf="!user || !user.isLoggedIn || !user.hero_status", [routerLink]="['/register']")
            | Register
          a.btn.btn-primary.btn-lg.btn-block.disabled(*ngIf="user && user.isLoggedIn && user.hero_status", disabled)
            | {{ user.hero_status ? 'Included' : 'Current Plan'}}
    .col-12.col-md-6.col-lg-4
      .card.card-outline-danger
        .card-body
          img.card-img-top(src='/assets/images/hero-lg.png', style="padding-top:15.5%;")
          h2.card-title Edji Hero
          //- $5<span class="small"> / month or </span>
          p.small.hero-color-text(*ngIf="offerDetails")
            i.icon.icon-gift.mr-1
            span([innerHtml]="offerDetails")
          span.pricing
            | $5
            span.small  / month
          p.small Charged annually per teacher
          hr
          p.card-text.card-text--pricing
            //- | Hero takes the limits off of Edji and gives teachers powerful evaluation and feedback tools to assist and assess their students as they read.
            | Unlimited Readings
          //- label Who is it for?
          //- p.card-text.card-text--pricing Teachers who make reading a staple of their class and want a detailed history of their classroom engagement
          //- Plan Details
          div(
            *ngFor="let detail of planDetails",
            (click)="detail.info ? triggerInfoModal(detail.info) : null",
            [class.clickable]="detail.info"
          )
            hr
            .label([innerHtml]="detail.label")
            p.card-text.card-text--pricing.plan-detail
              span([innerHtml]="detail.hero | emojione")
              i.icon__tooltip
                span.icon.icon-circle.icon-info  i
        .card-footer
          a#priceCardCTA.btn.btn-hero.btn-lg.btn-block(
            *ngIf="!isHero && !isAcademyHero",
            tabindex='1',
            (click)='goHero("pricingHeroCard")'
          ) Go Hero
          a.btn.btn-hero.btn-lg.btn-block(
            *ngIf="isHero && !isAcademyHero",
            [routerLink]="['/account']",
            [innerHtml]="'Current Plan &nbsp;:tada:' | emojione"
          )
          a.btn.btn-primary.disabled.btn-block(
            *ngIf="isAcademyHero",
            disabled
          ) Provided by Academy
    #academy.col-12.col-md-6.offset-md-3.col-lg-4.offset-lg-0
      .card.card-outline-secondary
        .card-body
          img.card-img-top(src='/assets/images/hero-academy-lg.png')
          h2.card-title Academy
          a.link.pricing(
            [routerLink]="'./'",
            [queryParams]="{ request: 'academy' }",
            ) Request a Quote
          p.small Starting at $180/yr for 5 licenses
          hr
          p.card-text.card-text--pricing
            //- | Academy is the easy way to get all your schools' teachers full access to Edji Hero features. Easily get teachers signed on and manage your Academy licenses.
            | For Schools and Districts
          //- label Who is it for?
          //- p.card-text.card-text--pricing Teachers and Administrators who want to collaborate within their school.
          //- Plan Details
          div(
            *ngFor="let detail of planDetails",
            (click)="detail.info ? triggerInfoModal(detail.info) : null",
            [class.clickable]="detail.info"
          )
            hr
            .label([innerHtml]="detail.label")
            p.card-text.card-text--pricing.plan-detail
              span([innerHtml]="detail.academy | emojione")
              i.icon__tooltip
                span.icon.icon-circle.icon-info  i
        .card-footer
          a.btn.btn-primary.btn-lg.btn-block(
            *ngIf="!isAcademyHero",
            [routerLink]="'./'",
            [queryParams]="{ request: 'academy' }",
          ) Request Quote
  .hero-rule
  .row.row-xl-pad
    .col-12.col-md-8.offset-md-2
      h4
        | Teacher Reimbursement Program
        img.ml-2(src="/assets/images/promo-heart-hand.svg", style="height: 2em; width: auto;")
      p Hundreds of individual teachers subscribe to Edji, and we are thankful that they support us. But we don't think teachers should need to pay out of pocket for classroom tools. For this reason, if your school or district <a class="link" [routerLink]="'./'" [queryParams]="{ request: 'academy' }">subscribes to Academy</a>, we will reimburse your personal Hero subscription from the past year. Just <a class="link" href="mailto:support@edji.it">drop us an email</a>, and we will send you your refund.
      p It's our way of thanking you for teaching the next generation and supporting Edji.
      .hero-rule
    .col-12.col-md-8.offset-md-2
      h4
        | Funding in the United States
      p If you're wondering how to get funding for Edji, remember Edji can be purchased using Title I, II, or III funds. The most common way teachers get funding for Edji is by trying out the free version with a small group of teachers. When they've seen the insight and engagement it brings to their classes, they work with their principal or technology coordinator to <em>Go Hero</em> as an Academy.
  .hero-rule
.container-fluid
  .row.navy.row-xl-pad.has-sparks
      .sparks
      img.promo-spotlight(src="/assets/images/hero-promo-spotlight.svg")
      img.promo-skyline(src="/assets/images/hero-promo-skyline.svg")
      .col-12.text-center
        h1.big-light.on-dark(style="margin:0px;")
          | Answer the Call
        p.on-dark.mt-2.mb-4
          |  Build <em>super</em> lessons and engage your students
        .button__row.pb-2
            button#heroCTA.btn-lg.btn.btn-hero((click)='goHero("pricingLowerCTA")')
              | Go Hero
              span(style='font-weight: 700;')
hot-login-register.modal-will-fade(
  [loginHeader]='"To go Hero, first you\'ll need an account"',
  [class.show]='showLoginModal',
  (closeModal)='showLoginModal = false',
  (loginSuccess)='showHeroSubModal = true'
)
hero-subscribe-modal.modal-will-fade(
  [class.show]='showHeroSubModal',
  [goHeroLocation]="'heroPricingPage'",
  (closeModal)='showHeroSubModal = !showHeroSubModal',
  (heroWasBorn)="_router.navigate(['/dashboard'])"
)
request-academy-modal.modal-will-fade(
  [class.show]="showRequestAcademyModal",
  (closeModal)="showRequestAcademyModal = false",
  [academyPlans]="academyPlans",
  [sliderPos]="sliderPos",
  (sliderPosUpdate)="sliderPos = $event"
)
//- Feature Info Modal
.modal(*ngIf="showInfoModal")
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        h5.modal-title {{ infoModalInfo.heading }}
        button.close((click)="showInfoModal = false")
          span(aria-hidden="true") &times;
      .modal-body
        .text-center(*ngIf="infoModalInfo.image")
          img.card.mb-4(style="display:inline-block; max-height: 500px;", [src]="infoModalInfo.image")
        p([innerHtml]="infoModalInfo.description")
      .modal-footer
        .btn.btn-secondary((click)="showInfoModal = false") Close
