.sliding-pane-comment.from-left.slide-slow([ngClass]="[ visible ? 'slide-in' : '' ]", style="z-index: 5999;")
  .container-fluid.container--less-pad(*ngIf="visible")
    button.close.stats-close-btn.btn-icon--round((click)="dismissCommentPane()", type="button")
      span(aria-hidden="true") ×
    p Line {{ lineNumArray[comment.start] }}
    h4(
      *ngIf="commentByPos[lineNumArray[comment.start]].length>1 || commentByPos[lineNumArray[comment.start]].length===0"
    ) {{ commentByPos[lineNumArray[comment.start]].length }} Comments
    h4(
      *ngIf="commentByPos[lineNumArray[comment.start]].length===1"
    ) {{ commentByPos[lineNumArray[comment.start]].length }} Comment
    .comment-container.commentOverflow-normal(
      [ngClass]="[ comment.active && comment.type=='emoji' ? 'commentOverflow-eKey' : '',  comment.active && comment.type=='text' ? 'commentOverflow-kKey' : '' ]"
    )
      edji-comment(
        *ngFor="let mobileComment of commentByPos[lineNumArray[comment.start]]; let i = index", 
        [class.hidden]="(!project.heat_vision && user._id !== project.teacher_id) && mobileComment.user_id !== user._id && mobileComment.user_id !== project.teacher_id",
        [class.owner]="mobileComment.user_id === project.teacher_id",
        [readOnly]="mobileComment.user_id !== user._id",
        [userPermission]="getCommentPermissions(mobileComment)",
        [commentPaneActive]="true",
        [comment]="mobileComment", 
        [commentMobile]="true", 
        [commentMobileFirst]="i<1",
        (commentActivation)="commentActivationEmitter($event, mobileComment)",
        (commentUpdated)="commentUpdatedEmitter()",
        (commentReply)="commentReplyEmitter($event)",
        style="display: initial;"
      )
//- END .comment - mobile