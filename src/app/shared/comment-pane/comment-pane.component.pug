.sliding-pane-comment.from-left(*ngIf="visible", [ngClass]="[ visible ? 'slide-in' : '' ]", style="z-index: 5999;")
  .sliding-pane-comment__header.container-fluid
    .row
      .col-12
        .header-wrap
          button.close.stats-close-btn.btn-icon--round((click)="dismissCommentPane()", type="button")
            span(aria-hidden="true") ×
          p.pt-1 Comments on Line
  .comment-container.container-fluid.pb-4(
    [ngClass]="[ _comments.activeComment.active && _comments.activeComment.type=='emoji' ? 'commentOverflow-eKey' : '' ]"
  )
    .row
      .col-12
        div()
          edji-comment( 
            *ngFor="let mobileComment of commentByPos[comment.lineY]; let i = index",
            [class.hidden]="(!project.heat_vision && user._id !== project.teacher_id) && mobileComment.user_id !== user._id && mobileComment.user_id !== project.teacher_id",
            [class.owner]="mobileComment.user_id === project.teacher_id",
            [readOnly]="mobileComment.user_id !== user._id",
            [userPermission]="getCommentPermissions(mobileComment)",
            [commentPaneActive]="true",
            [comment]="mobileComment", 
            [commentMobile]="true", 
            [commentMobileFirst]="i<1",
            (commentActivation)="commentActivationEmitter($event, mobileComment)",
            (commentUpdated)="commentUpdatedEmitter()",
            (commentReply)="commentReplyEmitter($event)",
            style="display: initial;"
          )
.exit-row(*ngIf="visible", (tap)="dismissCommentPane()")
//- END .comment - mobile