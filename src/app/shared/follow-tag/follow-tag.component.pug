.user-tag
    .user-tag__name(title="Reading Creator") {{owner.fullname}}
    span(*ngIf="user._id != owner._id")
        span.badge.badge-pill.badge-button.badge-secondary.badge-follow(
                title="Click to follow!", 
                (click)="$event.stopPropagation(); followUser(owner._id)", 
                *ngIf="!isFollowing()"
            )
            |  + Follow		
        span.badge.badge-pill.badge-button.badge-success.badge-unfollow(
                title="Click to unfollow!", 
                (click)="$event.stopPropagation(); unfollowUser(owner._id)", 
                *ngIf="isFollowing()"
            ) 
            span.static Following
            span.on-hover Unfollow
