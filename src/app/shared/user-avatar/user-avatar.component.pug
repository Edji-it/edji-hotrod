.user-icon([class.user-icon--medium]="size === 'medium'", [class.user-icon--large]="size === 'large'")
    span.user-icon__initials {{ initials }}
    span.hero-tag.avatar-bottom(*ngIf="size === 'large' && user.hero_status", title="Hero Powers Activated") H
span.user-icon__fullname(*ngIf="showName") {{ fullname }}