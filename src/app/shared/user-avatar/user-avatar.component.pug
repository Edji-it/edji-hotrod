.user-icon(
    [ngClass]="['user-icon--' + size]",
    [class.selected]="selected",
    [style.background]="background"
)
    span.user-icon__initials([innerHtml]="initials | emojione")
    //- @todo enabling avatars
    //- span.user-icon__initials(*ngIf="!avatar") {{ initials }}
    //- img([src]="avatar")
    span.hero-tag.avatar-bottom(*ngIf="size === 'large' && user.hero_status", title="Hero Powers Activated") H
.user-icon__fullname(*ngIf="showName")
  | {{ fullname }}&nbsp;
  .sub-label(*ngIf="subLabel") {{ subLabel }}
