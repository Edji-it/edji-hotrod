.tooltip.tooltip--bottom.tooltip--interactive.py-0.show(
  data-test="tooltipAvatarEditor",
  (clickOutside)="initialized && saveAndClose()"
)
  .tooltip-header
    .btn.btn-link(
      [class.active]="tab === 'color'",
      (click)="tab = 'color'",
      data-test="editorTabColor"
    ) Color
    .btn.btn-link(
      [class.active]="tab === 'emoji'",
      (click)="tab = 'emoji'",
      data-test="editorTabEmoji"
    ) Emoji
    button.close((click)='saveAndClose()', type='button', data-test="avatarSave") &times;
  .tooltip-body(*ngIf="tab === 'emoji'")
    .palette-btn(
      *ngFor="let e of emojiOptions",
      [innerHtml]="':' + e + ':' | emojione",
      (click)="setEmoji(e)",
      data-test="emojiBtn"
    )
  .tooltip-body(*ngIf="tab === 'color'")
    .palette-btn(
      *ngFor="let c of colorOptions",
      (click)="setColor(c)",
      data-test="colorBtn"
    )
      .spot([style.background]="c")
  .tooltip-footer
    .text-danger(*ngIf="error") {{error}}
    .btn-row.right(*ngIf="!loading")
      .btn.btn-sm.btn-link((click)="reset()", data-test="avatarReset") Clear
      .btn.btn-sm.btn-secondary((click)="randomize()") Shuffle
    .message-row(*ngIf="loading")
      | Saving
      i.icon.icon-loading
