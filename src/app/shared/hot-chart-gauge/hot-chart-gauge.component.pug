.row
  .chart-cluster
    .gauge-value
      .gauge-value-min {{ values.min }} {{ measures.abbreviated }}
    .gauge-section.px-2
      .gauge-outline(
        [ngStyle]="{ 'width': chartSize + 'px', 'height': chartSize/2 + 'px', 'border-top-left-radius': chartSize/2 + 'px', 'border-top-right-radius': chartSize/2 + 'px', 'background': 'linear-gradient(0.25turn,' + colorLeft + ',' + colorRight + ')' }"
      )
        .gauge-inner(
          [ngStyle]="{ 'border-top-left-radius': chartSize/2 + 'px', 'border-top-right-radius': chartSize/2 + 'px' }"
        )
          .needle(
            [ngStyle]="{ 'height': chartSize/2 + 'px', 'transform': 'rotate(' + needlePosition + 'deg)' }"
          )
          //- .avg-tick(
          //-   [ngStyle]="{ 'height': chartSize/10 + 'px', 'bottom': ((chartSize/2) - (chartSize/10)) + 'px', 'transform': 'rotate(' + averagePosition + 'deg)' }"
          //- )
          .avg-tick(
            [ngStyle]="{ 'height': chartSize/2 + 'px', 'transform': 'rotate(' + averagePosition + 'deg)' }"
          )
    .gauge-value
      .gauge-value-max {{ values.max }} {{ measures.abbreviated }}
.row
  .col-12.no-gutters.p-0
    .needle-value.mt-2 {{ values.val }}
    .needle-metric {{ measures.full }}