.modal-will-fade([class.show]="_util.showShareCode")
  .modal
    .modal-dialog(role="document")
      .modal-content
        .modal-body.modal-body-share
          h4.modal-title.title-share Hand it out!
          p.msg-share To give students access to the reading, share the Group Code, and they can add it from the Edji.it homepage or their dashboard.
          .share-code--block
            .share-code--code(*ngFor="let codeLetter of _util.shareCodeDetail.code.split('')")
              span.sc--c([ngClass]="[ isNumber(codeLetter) ? 'sc--c__green' : '' ]") {{ codeLetter }}
            .share-code--label {{ _util.shareCodeDetail.label }}
        .modal-footer(*ngIf="_util.shareCodeDetail.proj_id")
          button#shareModalDashboardButton.btn.btn-secondary.btn-share-footer(type="button", (click)="navDashboard()") Return to Dashboard
          button#shareModalReadingButton.btn.btn-secondary.btn-share-footer(type="button", (click)="navProject(_util.shareCodeDetail.proj_id)") Go to Reading
        .modal-footer(*ngIf="!_util.shareCodeDetail.proj_id")
          button.btn.btn-secondary.btn-share-footer__full(type="button", (click)="_util.shareCodeModalClose()") Close