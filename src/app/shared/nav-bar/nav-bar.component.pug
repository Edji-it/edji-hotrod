.nav-bar__wrap
  #sideBar.nav-bar
    button.mNavIcon.mNav([ngClass]="{ 'mNavShowing' : mNavShow }", (click)="mNavShowFlip()")
    a.nav-bar__logo-wrap([routerLink]="['/dashboard']")
      ng-container(*ngIf="!isDevDeployed")
        img#logo.nav-bar__logo(*ngIf="currentPage!='home'", src="assets/images/logo-3.2-mark.svg")
        img#logo.nav-bar__logo-h(*ngIf="currentPage=='home'", src="assets/images/logo-3.2-horizontal.svg")
      //-  Dev logos
      ng-container(*ngIf="isDevDeployed")
        img#logo.nav-bar__logo(*ngIf="currentPage!='home'", src="assets/images/logo-3.2-mark--dev.svg")
        img#logo.nav-bar__logo-h(*ngIf="currentPage=='home'", src="assets/images/logo-3.2-horizontal--dev.svg")
    //- .nav__menu(*ngIf="!showDashboardOptions || (currentPage === 'discover' && !user.isLoggedIn)")
    //-   a#navDiscoverPublic.btn.btn-link([routerLink]="['/discover']", routerLinkActive="active", [attr.title]="'Discover Readings from other Teachers'")
    //-     | Discover
    //- Dashboard Nav
    .nav__menu(*ngIf="showDashboardOptions && user.isLoggedIn")
      ng-container(*ngFor="let link of navLinks")
        a.btn.btn-link([attr.id]="link.id", [routerLink]="[link.route]", routerLinkActive="active", [attr.title]="link.tooltip")
          | {{ link.displayName }}
      .dropdown(*ngIf="user.isAcademyAdmin", [class.show]="academyMenuShow")
        a#navAcademy.btn.btn-link([routerLink]="['/academy/licenses']", routerLinkActive="active") 
          | Academy
        //- a#navAcademy.btn.btn-link.dropdown-toggle(
        //-     routerLinkActive="active",
        //-     (click)="academyMenuShow = !academyMenuShow"
        //-   )
        //-   | Academy
        //- .dropdown-menu(aria-labelledby="navAcademy")
        //-   a.dropdown-item([routerLink]="['/academy/engagement']", routerLinkActive="active")
        //-     | Engagement
        //-   a.dropdown-item([routerLink]="['/academy/licenses']", routerLinkActive="active")
        //-     | Licenses
      a#navGuide.btn.btn-link.btn--hover-icon(*ngIf="!user.isStudent", href="http://guide.edji.it", target="_blank", )
        | Guide
        .icon.icon-external
    //- Optional Title
    div(*ngIf="pageTitle || currentPage == 'project'")
      .nav-bar__heading.hidden-md-down(*ngIf="!showProjectInfo")
        h1(
          *ngIf="pageTitle",
          title="{{ pageTitle }}"
          ) {{ pageTitle }}
      #inProjectReadingTitle.nav-bar__heading.hidden-md-down(*ngIf="showProjectInfo")
        h1.with-nav-sub(
          *ngIf="currentReading.title",
          title="{{ currentReading.title }}"
          ) {{ currentReading.title }}
        .nav-bar__author(*ngIf="currentProject.owners && currentProject.owners[0]")
          //- span.label.mr-1 Teacher{{currentProject.owners[1] && 's'}}
          .user-tag-group--teacher
            .badge.badge-pill.badge-teacher--label.hover--tooltip
              | T
              .tooltip.tooltip--top-right
                .tooltip-title Teacher{{currentProject.owners[1] && 's'}} for this Reading Group
            ng-container(*ngFor="let owner of currentProject.owners")
              follow-tag([owner]="owner")
            #addCoTeacherBtn.badge.badge-pill.badge-button.badge-teacher(
              *ngIf="currentProject.isTeaching",
              [routerLink]="['./']",
              [queryParams]="{ studentList: 'coteach'}"
            ) Add a teacher 
              //- OR add Co-teacher
            //- Live Reader Count
            //- - Student display
            .badge.badge-pill(
              *ngIf="!currentProject.isTeaching",
              [ngClass]="[ liveCount > 1 ? 'badge-primary' : 'badge-secondary']"
            ) 
              | {{ liveCount }} Reading
            //- - Teacher display
            .badge.badge-pill.badge-button(
              *ngIf="currentProject.isTeaching",
              [ngClass]="[ liveCount > 1 ? 'badge-primary' : 'badge-secondary']",
              [routerLink]="['./']",
              [queryParams]="{ studentList: 'open'}"
            ) 
              | {{ liveCount }} Reading
    //- Login/Register Actions
    .nav__btn-wrap(*ngIf="!user.isLoggedIn && !hideAccountOptions")
      a#loginLink.btn.btn-primary.nav-bar__btn([routerLink]="['/login']") Log In
      a#registerLink.btn.btn-secondary.nav-bar__btn([routerLink]="['/register']") Register
    //- User Menu: Logged in Actions
    .outer-circle--large.float-right(*ngIf="user.isLoggedIn", [class.active]="showAvatarDropdown")
      .avatar__wrap
        #avatarActionIcon.user-icon--large.pointer.float-right((click)="showAvatarDropdown=!showAvatarDropdown", (clickOutside)="showAvatarDropdown=false")
          span.user-icon__initials {{user.fullname.substring(0,2)}}
          span.hero-tag.avatar-bottom(*ngIf="user.hero_status", title="Hero Powers Activated") H
        .avatar__drop-down.list-group(*ngIf="showAvatarDropdown", [class.visible]="showAvatarDropdown")
          .arrow
          //- Account
          button#accountButton.list-group-item.list-group-item-action(type="button", (click)="openAccount()") {{ user.fullname }}
            span.list-icon--right([innerHtml]="':gear:' | emojione")
          //- Refer
          button#navReferralButton.list-group-item.list-group-item-action(*ngIf="!user.isStudent" type="button", (click)="openReferralModal()") 
            ng-container(*ngIf="user.hero_status")
              | Refer a Friend
              span.list-icon--right([innerHtml]="':satellite:' | emojione")
            ng-container(*ngIf="!user.hero_status")
              span.hero-color-text Get Hero Free
              span.list-icon--right([innerHtml]="':gift:' | emojione")
          //- Feedback
          button#navFeedbackButton.list-group-item.list-group-item-action(type="button", (click)="openFeedback()") Contact Us
            span.list-icon--right([innerHtml]="':question:' | emojione")
          //- Guides
          button#navGuidesButton.list-group-item.list-group-item-action(type="button", (click)="openGuides()") Guide
            span.list-icon--right([innerHtml]="':book:' | emojione")
          //- Log Out
          button#logOutButton.list-group-item.list-group-item-action(type="button", (click)="logout()") Log Out
            span.list-icon--right([innerHtml]="':outbox_tray:' | emojione")
    //- Project Info (Desktop & Mobile)
    .nav-bar__project-data
      ng-container(*ngIf="showProjectInfo && currentProject && currentProject._id && currentProject.owners")
        //- Heat Vision Status
        .nav__btn-slider__wrap.hover--tooltip
          .nav__btn-slider(
              [class.expanded]="sliderBtnExpanded['heat']",
              [class.loading]="sliderBtnLoading['heat']",
              [class.has-action]="currentProject.isTeaching",
              [class.inactive]="!currentProject.heat_vision"
              )
            ng-container(*ngIf="currentProject.isTeaching")
              i.icon.icon-vision-flame((click)="toggleSlider('heat')")
                .icon-pill-status
              .btn-slider__value.hover-parent((click)="toggleHeatVision(!currentProject.heat_vision)") 
                .hover-show--inline-block(style="width: 85px; text-align:center;") Turn {{ currentProject.heat_vision ? 'Off' : 'On' }}
                .hover-hide Heat Vision {{ currentProject.heat_vision ? 'On' : 'Off' }}
            ng-container(*ngIf="!currentProject.isTeaching")
              i.icon.icon-vision-flame((click)="toggleSlider('heat')")
                .icon-pill-status
              .btn-slider__value
                | Heat Vision {{ currentProject.heat_vision ? 'On' : 'Off' }}
          .tooltip.tooltip--bottom
            .tooltip-title {{ currentProject.heat_vision ? "Heat Vision on, comments visible" : "Heat Vision off, comments hidden" }}
        //- Group Label
        .nav__btn-slider__wrap.hover--tooltip
          .nav__btn-slider([class.expanded]="sliderBtnExpanded['group']", (click)="toggleSlider('group')")
            i.icon.icon-group
              .icon-pill-status
            .btn-slider__value
              | {{ currentProject.label }}
          .tooltip.tooltip--bottom
            .tooltip-title Group
            .tooltip-text([class.tooltip-text--wide]="currentProject.label.length > 25") {{ currentProject.label }}
        //- Key Code
        .nav__btn-slider__wrap.hover--tooltip
          .nav__btn-slider.has-action([class.expanded]="sliderBtnExpanded['code']")
            i.icon.icon-key((click)="toggleSlider('code')")
              .icon-pill-status
            .btn-slider__value.text-code((click)="showShareCodeModal = true") {{ currentProject.code }}
          .tooltip.tooltip--bottom
            .tooltip-title Group Code
      //- Academy Info
      .nav__btn-slider__wrap(*ngIf="academyState && academyState.academies && academyState.academies.length > 0")
        .nav__btn-slider.has-action(
            [class.expanded]="sliderBtnExpanded['academy']"
          )
          i.icon.icon-academy-plate.hover--tooltip((click)="toggleSlider('academy')")
            .icon-pill-status
            .tooltip.tooltip--bottom(style="top: calc(100% + 27px)")
              .tooltip-title Hero Academy Member
          .btn-slider__value((click)="showAcademyDropdown = !showAcademyDropdown") 
            | {{ currentAcademy.abbreviation }}
        .btn-slider__drop-down.list-group([class.visible]="showAcademyDropdown")
          .arrow
          button.list-group-item.list-group-item-action(*ngFor="let academy of academyState.academies; let i = index", (click)="_auth.setCurrentAcademy(i); showAcademyDropdown = false")
            | {{ academy.name }} ({{academy.abbreviation}})
    //- New Reading actions
    .nav__btn-wrap(*ngIf="canPublish")
      //- Share button: Desktop
      button#addReadingButton.btn.btn-action.nav-bar__btn.hidden-sm-down((click)="this.shareAction.emit()", [class.active]="showShareTooltip") 
        | Share
        i.icon.icon-megaphone.icon--btn-inline.mr-0
      //- Share button: Mobile
      button#addReadingButtonMobile.btn.btn-clear.nav-bar__btn.hidden-md-up((click)="this.shareAction.emit()", [class.active]="showShareTooltip") 
        | Share
        i.icon.icon-megaphone.icon--btn-inline.mr-0
    //- Reading Preview
    .nav__btn-wrap(*ngIf="canPublish")
      //- Share button: Desktop
      button#showReadingPreview.btn.btn-primary.nav-bar__btn.hidden-sm-down((click)="this.previewAction.emit()") 
        | Preview
      //- Share button: Mobile
      button#showReadingPreview.btn.btn-clear.nav-bar__btn.hidden-md-up((click)="this.previewAction.emit()") 
        | Preview
    //- Save button and status
    .nav__btn-wrap(*ngIf="canPublish")
      button#saveDraftButton.btn.btn-link.nav__status-label(*ngIf="!saveState || saveState == 'unsaved'", (click)="saveAction.emit()")
        | Save as Draft
      button#saveDraftButton.btn.btn-link.nav__status-label(*ngIf="saveState == 'edited'", (click)="saveAction.emit()", title="Click to save draft")
        .icon.icon-save-small
        | Save Changes
      span.nav__status-label(*ngIf="saveState == 'saving'")
        .icon.icon-in-progress
        | Saving
      span.nav__status-label.hover--tooltip#draftStatusSaved(*ngIf="saveState == 'saved'", title="Recently autosaved")
        .icon.icon-check-small
        | Saved
    //- Join Reading Code
    .row.col-4.col-xl-5.nav__join-code.hidden-md-down(*ngIf="(currentPage != 'project') && !canPublish && !hideAccountOptions")
      .input-group.input-group-lg
        input#projectCodeInputNav.form-control(
          name="ProjectCodeInput", 
          type="text", 
          style="text-align: center;", 
          (keyup.enter)="joinSession(projectCode)", 
          [(ngModel)]="projectCode", 
          [class.is-invalid]="errorObject.invalidCode"
          placeholder="🔑 Code", 
          aria-describedby="add-project-code")
        .input-group-append
          button#buttonJoinProject.btn.btn-primary(
            [class.loading]="joinLoading", 
            type="button", 
            (click)="joinSession(projectCode)", 
            name="Join", 
            href="#") Go!
      #projectCodeError.invalid-feedback.d-block(*ngIf="errorObject.invalidCode", [innerHtml]="errorObject.invalidCode | emojione")
    //- Go hero action (non-existent if already a hero)
    .nav__btn-wrap(*ngIf="!showProjectInfo && (!user.isLoggedIn || (!user.hero_status && !user.isStudent))")
      a#heroLink.btn.btn-hero.btn-sm.nav-bar__btn.hidden-sm-down([routerLink]="['/plans']", [routerLinkActive]="'hide'", fragment="top") 
        | {{ currentPage == "home" ? "Discover Hero" : heroBtnCopy }}
      a#goHeroLink.btn.btn-hero.btn-sm.nav-bar__btn.hidden-sm-down(
          *ngIf="user.isLoggedIn && currentPage == 'hero'",
          (click)="showHeroSubModal = true"
        ) Go Hero
  //- Page title/reading title
  h1.hidden-md-up.mobile-heading(*ngIf="(pageTitle && !showProjectInfo) || hideAccountOptions") {{ pageTitle }}
  h1#inProjectReadingTitle.hidden-md-up.mobile-heading(*ngIf="showProjectInfo || hideAccountOptions") {{ currentReading.title }}

//- Join Reading Code
//- .container
.col-12.nav__join-code--under.hidden-md-up(*ngIf="_router.url.indexOf('/home') > -1")
  .input-group.input-group-lg
    input#projectCodeInputUnderNav.form-control(
      name="ProjectCodeInput", 
      type="text", 
      style="text-align: center;",
      [class.is-invalid]="errorObject.invalidCode",
      (keyup.enter)="joinSession(projectCode)", 
      [(ngModel)]="projectCode", 
      placeholder="🔑 Code", 
      aria-describedby="add-project-code")
    .input-group-append
      button#buttonJoinProject.btn.btn-primary(
        [class.loading]="joinLoading", 
        type="button", 
        (click)="joinSession(projectCode)", 
        name="Join", 
        href="#") Go!
  #projectCodeError.invalid-feedback.d-block(*ngIf="errorObject.invalidCode", [innerHtml]="errorObject.invalidCode | emojione")

//- ************************************************
//- Components in Nav for display on multiple pages
//- ************************************************
//- Group share code modal
share-code(
  *ngIf="showShareCodeModal",
  [class.show]="showShareCodeModal", 
  [showOnNewReading]="isNewReading",
  (closeModal)="showShareCodeModal = false"
)
//- Message toast display
edji-message-toasts([currentPage]="currentPage")
//- Referrals
referral-modal(
  [showReferral]="showReferralModal",
  (hideReferral)="showReferralModal=false", 
  (exerciseCoupon)="useCoupon($event)"
)
//- Hero Subscribe/Pay
hero-subscribe-modal.modal-will-fade(
  *ngIf="showHeroSubModal",
  [class.show]="showHeroSubModal", 
  (closeModal)="showHeroSubModal=false", 
  (heroWasBorn)="_router.navigate(['/dashboard'])",
  [couponCode]="couponCode"
)