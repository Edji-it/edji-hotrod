.nav-bar__wrap
  #sideBar.nav-bar
    button.mNavIcon.mNav([ngClass]="{ 'mNavShowing' : mNavShow }", (click)="mNavShowFlip()")
    a.nav-bar__logo-wrap([routerLink]="['/dashboard']")
      img#logo.nav-bar__logo(src="assets/images/logo-3.2-mark.svg")

    //- Optional Title
    .nav-bar__heading.hidden-sm-down(*ngIf="!showProjectInfo")
      h1(
        *ngIf="pageTitle",
        title="{{ pageTitle }}"
        ) {{ pageTitle }}
    .nav-bar__heading.hidden-sm-down(*ngIf="showProjectInfo")
      h1(
        *ngIf="currentReading.title",
        title="{{ currentReading.title }}"
        ) {{ currentReading.title }}

    .nav__btn-wrap(*ngIf="!user.isLoggedIn")
      a#loginLink.btn.btn-primary.nav-bar__btn([routerLink]="['/login']") Log In
      a#registerLink.btn.btn-secondary.nav-bar__btn([routerLink]="['/register']") Register

    .nav-bar__user(*ngIf="user.isLoggedIn", [ngClass]="{ 'nav-bar__user__show' : mNavShow }")

      a#accountButton.nav-bar__link(tabindex="1", [routerLink]="['/account']")
        span(*ngIf="user.fullname") {{ user.fullname }}
        span(*ngIf="!user.fullname") {{ user.username }}
        span.hero-tag(*ngIf="user.hero && user.hero.active", title="Hero Powers Activated") H

      a#logOutButton.link(tabindex="1", (click)="logout()", [innerHtml]="'Log Out'")

    .nav__btn-wrap(*ngIf="!showProjectInfo && (!user.hero || !user.hero.active)")
      a#heroLink.btn.btn-clear.nav-bar__btn.hidden-sm-down.link([routerLink]="['/hero']", routerLinkActive="active") Go Hero!
      a#heroLink.btn.btn-clear.nav-bar__btn.hidden-md-up.link(*ngIf="!canPublish", [routerLink]="['/hero']", routerLinkActive="active") Hero

    //- Project Info (Desktop & Mobile)
    .nav-bar__project-data(*ngIf="showProjectInfo && currentProject && currentProject._id")
      .group-label {{ currentProject.label }} &ensp;
        span.badge.badge-pill([ngClass]="[ liveCount > 1 ? 'badge-primary' : 'badge-secondary']") {{ liveCount }} Reading
      pre.btn((click)="showShareCodeModal()", title="Display group code")
        span([innerHtml]="':key:' | emojione") 
        | &nbsp;{{ currentProject.code }}

    .nav__btn-wrap
      //- Share button: Desktop
      button#addReadingButton.btn.btn-action.nav-bar__btn.hidden-sm-down(*ngIf="canPublish", (click)="showShareTooltip = !showShareTooltip", [class.active]="showShareTooltip") Share
      //- Share button: Mobile
      button#addReadingButtonMobile.btn.btn-clear.nav-bar__btn.hidden-md-up(*ngIf="canPublish", (click)="showShareTooltip = !showShareTooltip", [class.active]="showShareTooltip") Share
      //- Publish Tooltip
      .publish-tooltip(*ngIf="showShareTooltip && !_util.showShareCode")
        h1.publish-tooltip__title Publish and Share
        p.sub-label.pb-2F inished with your reading? Give it a group name, Finalize and get your group code to share with your readers!
        .form-group(style="margin-bottom: 0px;")
          label Group Name
            .input-group
              input#firstProjectLabel.form-control.form-item--editor.h3.mGroup([(ngModel)]="groupLabel", type="text", placeholder="eg. First Period, Peer review...")
            #errorGroupLabel.alert.alert-info(*ngIf="groupLabel.length < 1 && messages.groupNameLengthError") Please pick a name for your first Reading Group!
        .form-group(*ngIf="user.hero && user.hero.active")
          label(for="customCodeInput") Custom Code
            input#customCodeInput.form-control.form-item--editor.h3.mGroup([(ngModel)]="customCode", type="text", placeholder="(optional)", style="text-transform:lowercase;")
          #errorInvalidCustomCode.alert.alert-warning(*ngIf="messages.invalidCode") Whoops, someone is already using that group code. Could you pick another?
          #errorServiceResponse.alert.alert-warning(*ngIf="messages.serviceError") Oh no! Something went wrong. If it keeps happening, let us know!
        button#addReadingFinalizeButton.btn.btn-action((click)="finalizeReadingAndShare({ groupLabel: groupLabel, customCode: customCode })", [class.loading]="shareLoading") Finalize and Share
      .nav__btn-wrap
      //- Save button: Desktop
      button#saveDraftButton.btn.btn-secondary.nav-bar__btn.hidden-sm-down(*ngIf="canPublish", (click)="saveAction.emit()") Save
      //- Save button: Mobile
      button#saveDraftButton.btn.btn-clear.nav-bar__btn.hidden-md-up(*ngIf="canPublish", (click)="saveAction.emit()") Save

  h1.hidden-md-up.mobile-heading(*ngIf="pageTitle && !showProjectInfo") {{ pageTitle }}
  h1.hidden-md-up.mobile-heading(*ngIf="showProjectInfo") {{ currentReading.title }}

share-code([showOpenReading]="_route.snapshot.queryParams.readingCodeModal")