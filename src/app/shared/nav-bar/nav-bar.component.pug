.nav-bar__wrap
  #sideBar.nav-bar
    button.mNavIcon.mNav([ngClass]="{ 'mNavShowing' : mNavShow }", (click)="mNavShowFlip()")
    a.nav-bar__logo-wrap([routerLink]="['/dashboard']")
      ng-container(*ngIf="!isDevDeployed")
        img#logo.nav-bar__logo(*ngIf="currentPage!='home'", src="assets/images/logo-3.2-mark.svg")
        img#logo.nav-bar__logo-h(*ngIf="currentPage=='home'", src="assets/images/logo-3.2-horizontal.svg")
      //-  Dev logos
      ng-container(*ngIf="isDevDeployed")
        img#logo.nav-bar__logo(*ngIf="currentPage!='home'", src="assets/images/logo-3.2-mark--dev.svg")
        img#logo.nav-bar__logo-h(*ngIf="currentPage=='home'", src="assets/images/logo-3.2-horizontal--dev.svg")
    //- Dashboard Nav
    .nav__menu(*ngIf="showDashboardOptions")
      ng-container(*ngFor="let link of navLinks")
        a.btn.btn-link([attr.id]="link.id", [routerLink]="[link.route]", routerLinkActive="active", [attr.title]="link.tooltip")
          | {{ link.displayName }}
      .dropdown(*ngIf="user.isAcademyAdmin", [class.show]="academyMenuShow")
        a#navAcademy.btn.btn-link([routerLink]="['/academy/licenses']", routerLinkActive="active") 
          | Academy
        //- a#navAcademy.btn.btn-link.dropdown-toggle(
        //-     routerLinkActive="active",
        //-     (click)="academyMenuShow = !academyMenuShow"
        //-   )
        //-   | Academy
        //- .dropdown-menu(aria-labelledby="navAcademy")
        //-   a.dropdown-item([routerLink]="['/academy/engagement']", routerLinkActive="active")
        //-     | Engagement
        //-   a.dropdown-item([routerLink]="['/academy/licenses']", routerLinkActive="active")
        //-     | Licenses
      a#navGuide.btn.btn-link.btn--hover-icon(*ngIf="!user.isStudent", href="http://guide.edji.it", target="_blank", )
        | Guide
        .icon.icon-external
    //- Optional Title
    div(*ngIf="currentPage == 'project' || hideAccountOptions")
      .nav-bar__heading.hidden-sm-down(*ngIf="!showProjectInfo")
        h1(
          *ngIf="pageTitle",
          title="{{ pageTitle }}"
          ) {{ pageTitle }}
      .nav-bar__heading.hidden-sm-down(*ngIf="showProjectInfo")
        h1.with-nav-sub(
          *ngIf="currentReading.title",
          title="{{ currentReading.title }}"
          ) {{ currentReading.title }}
        .nav-bar__author(*ngIf="projectOwner && projectOwner._id")
          follow-tag([owner]="projectOwner")
          .badge.badge-pill([ngClass]="[ liveCount > 1 ? 'badge-primary' : 'badge-secondary']") {{ liveCount }} Reading

    //- Login/Register Actions
    .nav__btn-wrap(*ngIf="!user.isLoggedIn && !hideAccountOptions")
      a#loginLink.btn.btn-primary.nav-bar__btn([routerLink]="['/login']") Log In
      a#registerLink.btn.btn-secondary.nav-bar__btn([routerLink]="['/register']") Register
    //- User Menu: Logged in Actions
    .outer-circle--large.float-right(*ngIf="user.isLoggedIn", [class.active]="showAvatarDropdown")
      .avatar__wrap
        #avatarActionIcon.user-icon--large.pointer.float-right((click)="showAvatarDropdown=!showAvatarDropdown", (clickOutside)="showAvatarDropdown=false")
          span.user-icon__initials {{user.fullname.substring(0,2)}}
          span.hero-tag.avatar-bottom(*ngIf="user.hero_status", title="Hero Powers Activated") H
        .avatar__drop-down.list-group(*ngIf="showAvatarDropdown", [class.visible]="showAvatarDropdown")
          .arrow
          //- Account
          button#accountButton.list-group-item.list-group-item-action(type="button", (click)="openAccount()") {{ user.fullname }}
            span.list-icon--right([innerHtml]="':gear:' | emojione")
          //- Refer
          button#navReferralButton.list-group-item.list-group-item-action(*ngIf="!user.isStudent" type="button", (click)="openReferralModal()") Refer Teachers
            span.list-icon--right([innerHtml]="':satellite:' | emojione")
          //- Feedback
          button#navFeedbackButton.list-group-item.list-group-item-action(type="button", (click)="openFeedback()") Contact Us
            span.list-icon--right([innerHtml]="':question:' | emojione")
          //- Guides
          button#navGuidesButton.list-group-item.list-group-item-action(type="button", (click)="openGuides()") Guide
            span.list-icon--right([innerHtml]="':book:' | emojione")
          //- Log Out
          button#logOutButton.list-group-item.list-group-item-action(type="button", (click)="logout()") Log Out
            span.list-icon--right([innerHtml]="':outbox_tray:' | emojione")
    //- Project Info (Desktop & Mobile)
    .nav-bar__project-data
      ng-container(*ngIf="showProjectInfo && currentProject && currentProject._id")
        //- Heat Vision Status
        .nav__btn-slider(
            [class.expanded]="sliderBtnExpanded['heat']",
            [class.has-action]="projectOwner._id == user._id",
            (click)="toggleSlider('heat')",
            )
          ng-container(*ngIf="currentProject.heat_vision")
            i.icon.icon-vision-flame
            .btn-slider__value Heat Vision On
          ng-container(*ngIf="!currentProject.heat_vision")
            i.icon.icon-vision-flame.inactive
            .btn-slider__value Heat Vision Off
        //- Group Label
        .nav__btn-slider([class.expanded]="sliderBtnExpanded['group']", (click)="toggleSlider('group')")
          i.icon.icon-group
          .btn-slider__value
            | {{ currentProject.label }}
        //- Key Code
        .nav__btn-slider.has-action([class.expanded]="sliderBtnExpanded['code']")
          i.icon.icon-key((click)="toggleSlider('code')")
          .btn-slider__value.code((click)="showShareCodeModal()") {{ currentProject.code }}
      //- Academy Info
      .nav__btn-slider__wrap(*ngIf="academyState && academyState.academies && academyState.academies.length > 0")
        .nav__btn-slider.has-action(
            [class.expanded]="sliderBtnExpanded['academy']"
          )
          i.icon.icon-academy-plate((click)="toggleSlider('academy')")
          .btn-slider__value((click)="showAcademyDropdown = !showAcademyDropdown") 
            | {{ currentAcademy.abbreviation }}
        .btn-slider__drop-down.list-group([class.visible]="showAcademyDropdown")
          .arrow
          button.list-group-item.list-group-item-action(*ngFor="let academy of academyState.academies; let i = index", (click)="_auth.setCurrentAcademy(i); showAcademyDropdown = false")
            | {{ academy.name }} ({{academy.abbreviation}})
    //- New Reading actions
    .nav__btn-wrap
      //- Share button: Desktop
      button#addReadingButton.btn.btn-action.nav-bar__btn.hidden-sm-down(*ngIf="canPublish", (click)="this.shareAction.emit()", [class.active]="showShareTooltip") Share
      //- Share button: Mobile
      button#addReadingButtonMobile.btn.btn-clear.nav-bar__btn.hidden-md-up(*ngIf="canPublish", (click)="this.shareAction.emit()", [class.active]="showShareTooltip") Share
      //- Publish Tooltip
      //- .publish-tooltip(*ngIf="showShareTooltip && !_util.showShareCode")
      //-   h1.publish-tooltip__title Publish and Share
      //-   p.sub-label.pb-2F Finished with your reading? Give it a group name, Finalize and get your group code to share with your readers!
      //-   .form-group(style="margin-bottom: 0px;")
      //-     label Group Name
      //-       .input-group
      //-         input#firstProjectLabel.form-control.form-item--editor.h3.mGroup([(ngModel)]="groupLabel", type="text", placeholder="eg. First Period, Peer review...")
      //-       #errorGroupLabel.alert.alert-info(*ngIf="groupLabel.length < 1 && messages.groupNameLengthError") Please pick a name for your first Reading Group!
      //-   .form-group(*ngIf="user.hero_status")
      //-     label(for="customCodeInput") Custom Code
      //-       input#customCodeInput.form-control.form-item--editor.h3.mGroup([(ngModel)]="customCode", type="text", placeholder="(optional)", style="text-transform:lowercase;")
      //-     #errorInvalidCustomCode.alert.alert-warning(*ngIf="messages.invalidCode") Whoops, someone is already using that group code. Could you pick another?
      //-     #errorServiceResponse.alert.alert-warning(*ngIf="messages.serviceError") Oh no! Something went wrong. If it keeps happening, let us know!
      //-   button#addReadingFinalizeButton.btn.btn-action((click)="finalizeReadingAndShare({ groupLabel: groupLabel, customCode: customCode })", [class.loading]="shareLoading") Finalize and Share
      .nav__btn-wrap
      //- Save button: Desktop
      button#saveDraftButton.btn.btn-secondary.nav-bar__btn.hidden-sm-down(*ngIf="canPublish", (click)="saveAction.emit()") Save
      //- Save button: Mobile
      button#saveDraftButtonMobile.btn.btn-clear.nav-bar__btn.hidden-md-up(*ngIf="canPublish", (click)="saveAction.emit()") Save

    //- Join Reading Code
    .row.col-4.col-xl-5.nav__join-code.hidden-sm-down(*ngIf="(currentPage != 'project') && !canPublish && !hideAccountOptions")
      .input-group.input-group-lg
        input#projectCodeInputNav.form-control(
          name="ProjectCodeInput", 
          type="text", 
          style="text-align: center;", 
          (keyup.enter)="joinSession(projectCode)", 
          [(ngModel)]="projectCode", 
          [class.is-invalid]="errorObject.invalidCode"
          placeholder="🔑 Code", 
          aria-describedby="add-project-code")
        span.input-group-btn
          button#buttonJoinProject.btn.btn-primary(
            [class.loading]="joinLoading", 
            type="button", 
            (click)="joinSession(projectCode)", 
            name="Join", 
            href="#") Go!
      #projectCodeError.invalid-feedback(*ngIf="errorObject.invalidCode", [innerHtml]="errorObject.invalidCode | emojione")
    //- Go hero action (non-existent if already a hero)
    .nav__btn-wrap(*ngIf="!showProjectInfo && (!user.isLoggedIn || (!user.hero_status && !user.isStudent))")
      a#heroLink.btn.btn-hero.btn-sm.nav-bar__btn.hidden-sm-down([routerLink]="['/hero']", routerLinkActive="hide", fragment="top") 
        | {{ currentPage == "home" ? "Discover Hero" : heroBtnCopy }}
      a#goHeroLink.btn.btn-hero.btn-sm.nav-bar__btn.hidden-sm-down(
          *ngIf="user.isLoggedIn && currentPage == 'hero'",
          (click)="showHeroSubModal = true"
        ) Go Hero
  //- Page title/reading title
  h1.hidden-md-up.mobile-heading(*ngIf="(pageTitle && !showProjectInfo) || hideAccountOptions") {{ pageTitle }}
  h1.hidden-md-up.mobile-heading(*ngIf="showProjectInfo || hideAccountOptions") {{ currentReading.title }}

//- Join Reading Code
//- .container
.col-12.nav__join-code--under.hidden-md-up(*ngIf="_router.url.indexOf('/home') > -1")
  .input-group.input-group-lg
    input#projectCodeInputUnderNav.form-control(
      name="ProjectCodeInput", 
      type="text", 
      style="text-align: center;",
      [class.is-invalid]="errorObject.invalidCode",
      (keyup.enter)="joinSession(projectCode)", 
      [(ngModel)]="projectCode", 
      placeholder="🔑 Code", 
      aria-describedby="add-project-code")
    span.input-group-btn
      button#buttonJoinProject.btn.btn-primary(
        [class.loading]="joinLoading", 
        type="button", 
        (click)="joinSession(projectCode)", 
        name="Join", 
        href="#") Go!
  #projectCodeError.invalid-feedback(*ngIf="errorObject.invalidCode", [innerHtml]="errorObject.invalidCode | emojione")

share-code([showOpenReading]="_route.snapshot.queryParams.readingCodeModal")
referral-modal([showReferral]="showReferralModal", (hideReferral)="showReferralModal=false", (exerciseCoupon)="useCoupon($event)")
hero-subscribe-modal.modal-will-fade(
  *ngIf="showHeroSubModal",
  [class.show]="showHeroSubModal", 
  (closeModal)="showHeroSubModal=false", 
  (heroWasBorn)="_router.navigate(['/dashboard'])",
  [couponCode]="couponCode"
)