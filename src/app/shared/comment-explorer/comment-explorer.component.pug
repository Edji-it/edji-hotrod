.sliding-pane-comment.from-left(#commentPane="", [ngClass]="[ visible ? 'slide-in' : '' ]", style="z-index: 5999;")
    .loading-screen([class.fade-in]="loading", data-test="explorerLoading")
      .loader.icon-loading--action
    .sliding-pane-comment__header.container-fluid(*ngIf="visible")
      .row
        .col-12
          .header-wrap
            button.close.btn-icon--round(
              (click)="close()",
              type="button",
              data-text="closeCommentExplorer"
            )
              span(aria-hidden="true") ×
            //- All Comments header
            ng-container(*ngIf="filterMode === 'all'")
              i.icon.icon-comment-feed
              .header-text(data-test="allFilterHeader")
                | {{ commentCount }} Comments
                .sub-label All Students
            //- All Comments header
            ng-container
              //-(*ngIf="filterMode === 'search'")
              i.icon.icon-comment-feed
              .header-text(data-test="searchFilterHeader")
                .sub-label Search Comments
                input.form-control([(ngModel)]="searchTerm", (keyup.enter)="filterComments()")
            //- Comments on Line
            ng-container(*ngIf="filterMode === 'line'")
              i.icon.icon-view-line
              .header-text(data-test="lineFilterHeader")
                | Viewing Line
                .sub-label {{ commentCount }} Comments
            //- User's Comments
            ng-container(*ngIf="filterMode === 'user' && !filterCurrentUser")
              user-avatar(
                [userId]="filterUserId",
                [size]="'medium'",
                [showName]="true",
                [subLabel]="commentCount + ' Comments & Replies'",
                data-test="userFilterHeader"
              )
            //- Current User's Comments
            ng-container(*ngIf="filterMode === 'user' && filterCurrentUser")
              .comment-count__wrap
                i.icon.icon-comment-count
                .count {{ commentCount }}
              .header-text.no-label(data-test="userFilterHeader")
                | My Comments
        .col-12(*ngIf="filterMode !== 'line'")
          label#sortByCreated.form-check-label.form-check-btn.form-check-sm(
              [class.active]="sortValue == 'created'",
              title="Sort comments in the order they were created"
            )
            input.form-check-input(
                type="radio",
                name="sortCreated",
                value="created",
                [(ngModel)]="sortValue",
                (click)="filterComments({sort: 'created' })",
                checked
              )
            span By Time
          label#sortByLocation.form-check-label.form-check-btn.form-check-sm(
              [class.active]="sortValue == 'location'",
              title="Sort comments by where they appear in the text"
            )
            input.form-check-input(
                type="radio",
                name="sortLocation",
                value="location",
                [(ngModel)]="sortValue",
                (click)="filterComments({sort: 'location' })",
              )
            span By Location
        .col-12(*ngIf="filterMode !== 'all'")
          .btn-row.right.header__btn-row
            .hover--tooltip(*ngIf="!filterUserId")
              button.btn.btn-xs-primary.has-icon(
                *ngIf="filterMode != 'all'",
                (click)="viewAll()",
                [disabled]="!project.heat_vision && !project.isTeaching"
              )
                .icon.icon-comments
                |  All Comments
                .tooltip-wrap.tooltip--on-disabled
                  .tooltip
                    .tooltip-title Heat Vision is disabled
            //- Student view actions/options
            ng-container(*ngIf="filterUserId")
              a.btn.btn-xs-primary.has-icon(
                *ngIf="project.isTeaching",
                [routerLink]="'./'",
                [queryParams]="{ recap: filterUserId }"
              )
                .icon.icon-recap-sm
                | Recap
              button.btn.btn-xs-primary.has-icon(
                (click)="viewStudentFilter(filterUserId)"
              )
                .icon.icon-comment-filter
                | Highlights
              //- User filter, small "all comments" option
              button.btn.btn-xs-primary.has-icon.pl-0(
                  *ngIf="filterMode != 'all'",
                  (click)="viewAll()",
                  [disabled]="!project.heat_vision && !project.isTeaching",
                  title="All Comments"
                )
                  .icon.icon-comments.mr-0
    ng-scrollbar
      .comment-container.container-fluid(
        *ngIf="visible",
        [ngClass]="[ _comments.activeComment.active && _comments.activeComment.type=='emoji' ? 'commentOverflow-eKey' : '' ]",
      )
        .row
          .col-12
            ng-container(*ngFor="let c of comments; let i = index; trackBy: trackComment")
              hr.comment-block-hr(*ngIf="i > 0")
              h2 {{ c.search_score }}
              edji-comment(
                [class.hidden]="(!project.heat_vision && user._id !== project.teacher_id) && c.user_id !== user._id && c.user_id !== project.teacher_id",
                [comment]="c",
                [selected]="comment && c._id === comment._id",
                (commentActivation)="commentActivationEmitter($event)",
                (commentDeleted)="onDelete()",
              )
            .end-block(*ngIf="filterMode === 'all' && sortValue === 'created'")
              hr.comment-block-hr
              .timeline-line
              .pt-2
                .user-icon.user-icon--medium
                    span.user-icon__initials
                      span.is-emoji([innerHtml]="':seedling:' | emojione")
                .comment-block
                  .comment-meta
                    .comment-meta__time.p-0 {{ project.createdAt | edjidate:'timeAgo':null }}
                  p.small
                    b {{project.label}}
                    |  group was created.
.exit-row(*ngIf="visible", (tap)="close()")
//- END .comment - mobile
