nav-bar([showDashboardOptions]="true")
.container-fluid.profile-container.row
  //- Profile Pic Column
  .column.col-sm-3
    h1.profile-title Profile
    //- Profile Pic block
    .profile-pic-container.text-center
      user-avatar([userDetails]="currentUser", [size]="'profile'")
      //- Edit Profile Picture Button 
      //-   - Opens UploadProfPicModal -->
      //-  @todo enabling avatars
      //- button#editAvatarBtn.btn.btn-sm.edit-btn(*ngIf="currentUser.hero_status", type="button", (click)="showUploadProfPicModal= true;") Edit
  //- Text Column
  .column.col-sm-9
    //- spacer div
    .spacer-mobile-collapse
    //- Name
    .info-group
      .name-label {{currentUser.fullname}}
      //- .info-label Name
    //- user name
    .row
      .col-md-8
        .info-group(*ngIf="currentUser.username")
          label.info-label Username
          p.info {{currentUser.username}}
      .col-md-4.pt-3
        //- Change Password Button
        button.btn.change-password-btn.mb-4(type="button", (click)="showPassModal = !showPassModal") Change Password
    //- email
    .info-group
      label.info-label Email
      p.info {{currentUser.email}}
    //- Hero Subscription Mgmt
    .row
      .col-md-8
        .info-group
          label.info-label Hero Subscription
          .info
            span.text-capitalize.mr-4(*ngIf="currentUser.hero_status && !canceled && !academyHero", [style.display]="'inline-block'") Subscribed (Yearly)
            span.text-capitalize.mr-4(*ngIf="currentUser.hero_status && academyHero", [style.display]="'inline-block'") Hero Academy
            span.mr-4(*ngIf="!currentUser.hero_status") Unsubscribed
            .alert.alert-warning.my-1(*ngIf="canceled") 
              b Canceled
              | Your Hero subscription was canceled{{ customerCancelDate && ' on ' + (customerCancelDate | edjidate:'timeStamp':'mediumDate') }}.
              br 
              | Your Hero powers will go away on {{ customerSubEnd | edjidate:'timeStamp':'mediumDate' }}.
          span(*ngIf="currentUser.hero_status && !canceled && !academyHero") Renews on {{ customerSubEnd | edjidate:'timeStamp':'mediumDate' }}
      .col-md-4.pt-3
        button#heroModifyBtn.btn.btn-secondary.mr-4(*ngIf="currentUser.hero_status && !canceled && !academyHero", (click)="showHeroChangeModal = true") Modify
        button.btn.btn-hero.mr-4(*ngIf="!currentUser.hero_status", (click)="showHeroSubModal = true; trackHeroClick()") Go Hero
        button.btn.btn-hero.mr-4(*ngIf="canceled", (click)="showHeroSubModal = true; trackHeroClick()") Renew Subscription
    //- Linked Accounts
    .info-group
      label.info-label Linked Accounts
      //- Clever linked
      div.mt-2
        a.linked-block.hover--tooltip(
            *ngIf="linkedAccounts.clever",
            href="https://clever.com/oauth/sis/login", 
            target="_blank"
          )
          .icon.icon-link
          img.linked-logo(src="/assets/images/clever-logo.png")
          .tooltip-wrap
            .tooltip
              .tooltip-title Clever account is linked
        //- Clever NOT linked
        edji-clever-button(*ngIf="!linkedAccounts.clever", [dark]="true")
    //- Reading on Edji since
    .info-group.mt-5
      p.faded Reading on Edji since {{currentUser.createdAt | edjidate:'timeStamp':'mediumDate'}}
  //- buffer before the footer. Includes a nice border line.
  .row.container-line

edji-change-pass.modal-will-fade(
  *ngIf="showPassModal",
  [class.show]="showPassModal", 
  (closeModal)="showPassModal = !showPassModal"
)
hot-upload-avatar.modal-will-fade(
  [class.show]="showUploadProfPicModal", 
  (closeModal)="showUploadProfPicModal = !showUploadProfPicModal"
)
hero-subscribe-modal.modal-will-fade(
  *ngIf="showHeroSubModal",
  [class.show]="showHeroSubModal", 
  [goHeroLocation]="'accountPage'", 
  (closeModal)="showHeroSubModal = !showHeroSubModal; updateHeroStatus()", 
  (heroWasBorn)="_router.navigate(['/dashboard'])"
)
hero-change-modal.modal-will-fade(
  [class.show]="showHeroChangeModal", 
  (closeModal)="showHeroChangeModal = !showHeroChangeModal; updateHeroStatus()"
)