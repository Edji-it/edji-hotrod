nav-bar([showDashboardOptions]="true")
.container-fluid.profile-container.row(style="overflow:visible;")
  //- Profile Pic Column
  .column.col-sm-3
    h1.profile-title Profile
    //- Profile Pic block
    .profile-pic-container.text-center
      .avatar-editor__wrap.profile
        user-avatar([userDetails]="currentUser", [size]="'profile'")
        .btn.edit-btn(*ngIf="!editAvatar", (click)="editAvatar = true", data-test="btnAvatarEdit") Edit
        user-avatar-editor(*ngIf="editAvatar", (close)="editAvatar = false")
      //- Edit Profile Picture Button
      //-   - Opens UploadProfPicModal -->
      //-  @todo enabling avatars
      //- button#editAvatarBtn.btn.btn-sm.edit-btn(*ngIf="currentUser.hero_status", type="button", (click)="showUploadProfPicModal= true;") Edit
  //- Text Column
  .column.col-sm-9
    //- spacer div
    .spacer-mobile-collapse
    //- Name
    .row
      .col-md-8
        .info-group
          .name-label {{currentUser.fullname}}
      .col-md-4.pt-3
        button.btn.change-password-btn.mb-4(type="button", (click)="showUserUpdateModal=true", [innerHtml]="':pencil2: &nbsp; Update Your Profile' | emojione", title="Click to edit your profile")
        //- .outer-circle.btn-profile-edit((click)="showUserUpdateModal=true", title="Click to edit your profile")
        //-   span([innerHtml]="':pencil2:' | emojione", title="Click to edit your profile")
      //- .info-label Name
    //- user name
    .row
      .col-md-8
        .info-group(*ngIf="currentUser.username")
          label.info-label Username
          p.info {{currentUser.username}}
      .col-md-4.pt-3
        //- Set Password Button
        button.btn.set-password-btn.mb-4(*ngIf="(linkedAccounts.clever || linkedAccounts.google) && !currentUser.has_password" type="button", (click)="showPassModal = !showPassModal") Set Password
        //- Change Password Button
        button.btn.change-password-btn.mb-4(*ngIf="currentUser.has_password" type="button", (click)="showPassModal = !showPassModal") Change Password
    .row
      .col-md-8
      .col-md-4.pt-3
        //- Change Email Button
        button.btn.change-email-btn.mb-4(type="button", (click)="showEmailModal = !showEmailModal") Change Email
    //- email
    .info-group
      label.info-label Email
      p.info {{currentUser.email}}
    //- Hero Subscription Mgmt
    .row
      .col-md-8
        .info-group
          label.info-label Hero Subscription
          .info
            span.text-capitalize.mr-4(*ngIf="currentUser.hero_status && !canceled && !academyHero", [style.display]="'inline-block'") Subscribed (Yearly)
            span.text-capitalize.mr-4(*ngIf="currentUser.hero_status && academyHero", [style.display]="'inline-block'") Hero Academy
            span.mr-4(*ngIf="!currentUser.hero_status") Unsubscribed
            .alert.alert-warning.my-1(*ngIf="canceled")
              b Canceled
              | Your Hero subscription was canceled{{ customerCancelDate && ' on ' + (customerCancelDate | edjidate:'timeStamp':'mediumDate') }}.
              br
              | Your Hero powers will go away on {{ customerSubEnd | edjidate:'timeStamp':'mediumDate' }}.
          span(*ngIf="currentUser.hero_status && !canceled && !academyHero") Renews on {{ customerSubEnd | edjidate:'timeStamp':'mediumDate' }}
      .col-md-4.pt-3
        button#heroModifyBtn.btn.btn-secondary.mr-4(*ngIf="currentUser.hero_status && !canceled && !academyHero", (click)="showHeroChangeModal = true") View/Modify Subscription
        button.btn.btn-hero.mr-4(*ngIf="!currentUser.hero_status", (click)="showHeroSubModal = true; trackHeroClick()") Go Hero
        button#heroResubscribeBtn.btn.btn-hero.mr-4(*ngIf="canceled", (click)="showHeroSubModal = true; trackHeroClick()") Renew Subscription
    //- selected school
    .info-group(*ngIf="currentUser.school && currentUser.school.district_name")
      label.info-label School District
      p.info {{currentUser.school.district_name}}
      div(*ngIf="currentUser.school && currentUser.school.school_name")
        label.info-label School Name
        p.info {{currentUser.school.school_name}}
    //- Linked Accounts
    //- Only showing this section if the user has an account linked, because we are temporarily disabling linking from this page.
    .info-group(*ngIf="linkedAccounts.clever")
      label.info-label Linked Accounts
      //- Clever linked
      div.mt-2
        a.linked-block.hover--tooltip(
            *ngIf="linkedAccounts.clever",
            href="https://clever.com/oauth/sis/login",
            target="_blank"
          )
          .icon.icon-link
          img.linked-logo(src="/assets/images/clever-logo.png")
          .tooltip-wrap
            .tooltip
              .tooltip-title Clever account is linked
        //- Clever NOT linked
        //- edji-clever-button(*ngIf="!linkedAccounts.clever", [dark]="true")
    //- Reading on Edji since
    .info-group.mt-5
      p.faded Reading on Edji since {{currentUser.createdAt | edjidate:'timeStamp':'mediumDate'}}
  //- buffer before the footer. Includes a nice border line.
  .row.container-line

edji-change-pass.modal-will-fade(
  *ngIf="showPassModal",
  [class.show]="showPassModal",
  (closeModal)="showPassModal = !showPassModal"
)
edji-change-email.modal-will-fade(
  *ngIf="showEmailModal",
  [class.show]="showEmailModal",
  (closeModal)="showEmailModal = !showEmailModal"
)
hot-upload-avatar.modal-will-fade(
  [class.show]="showUploadProfPicModal",
  (closeModal)="showUploadProfPicModal = !showUploadProfPicModal"
)
hero-subscribe-modal.modal-will-fade(
  *ngIf="showHeroSubModal",
  [class.show]="showHeroSubModal",
  [goHeroLocation]="'accountPage'",
  (closeModal)="showHeroSubModal = !showHeroSubModal; updateHeroStatus()",
  (heroWasBorn)="_router.navigate(['/dashboard'])"
)
hero-change-modal.modal-will-fade(
  *ngIf="showHeroChangeModal",
  [class.show]="showHeroChangeModal",
  (closeModal)="showHeroChangeModal = !showHeroChangeModal; updateHeroStatus()"
)
hot-user-update-modal.modal-will-fade(
  *ngIf="showUserUpdateModal",
  [class.show]="showUserUpdateModal",
  (closeModal)="showUserUpdateModal = !showUserUpdateModal"
)
