//- Homepage video pop-up
.modal.show(*ngIf="showPromoVideoModal", (click)="showPromoVideoModal = false")
  .modal-dialog.modal-video
    button.close(aria-label="close", (click)="showPromoVideoModal = false")
      span &times;
    .modal-content
      .modal-body
        .embed-responsive.embed-responsive-16by9
          iframe.embed-responsive-item(
              src="//www.youtube.com/embed/F9LgNtwnsZw?autoplay=1",
              frameborder="0",
              allow="autoplay; encrypted-media",
              allowfullscreen
          )
