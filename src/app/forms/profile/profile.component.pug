
.profile-card
    .avatar-editor__wrap.large
        user-avatar([userDetails]="user", [size]="'large'")
        .btn.edit-btn(*ngIf="!editAvatar", (click)="editAvatar = true") Edit
        user-avatar-editor(*ngIf="editAvatar", (close)="editAvatar = false")
    .h1([innerHtml]="getProfileName(profileForm)")
    .label.small.text-muted.mb-0(*ngIf="profileForm.controls['school'] && profileForm.controls['school'].value")
        i.icon.icon-school
        | {{ ' ' + profileForm.controls['school'].value }}

form.form-block#registerForm([formGroup]="profileForm", (ngSubmit)="updateProfile(profileForm.value)")
    .row
        .col.pr-1
            .form-group
                label(for="firstnameInput") First Name
                input#firstnameInput(
                    type="text",
                    [formControl]="profileForm.controls['firstname']",
                    tabindex="0",
                    [placeholder]="userCopy.firstname",
                    (keyup)="setInitials(profileForm)",
                    (blur)="tempLocalUserUpdate({firstname: profileForm.controls['firstname'].value })"
                )

        .col.pl-1
            .form-group
                label(for="lastnameInput") Last Name
                input#lastnameInput(
                    type="text",
                    [formControl]="profileForm.controls['lastname']",
                    tabindex="0",
                    [placeholder]="userCopy.lastname",
                    (keyup)="setInitials(profileForm)",
                    (blur)="tempLocalUserUpdate({lastname: profileForm.controls['lastname'].value })"
                )
        .col-12
            #msgfirstnameRequired.alert.alert-info(*ngIf="profileForm.controls['firstname'].hasError('required') && profileForm.controls['firstname'].dirty") Please add your first name.
            #msglastnameRequired.alert.alert-info(*ngIf="profileForm.controls['lastname'].hasError('required') && profileForm.controls['lastname'].dirty") Please add your last name.
    .form-group
        label Using as?
            p.sub-label Please select how you will be using Edji.
        .input-group
            .form-check.pl-0
                //- Student option
                label#typeStudentInput.form-check-label.form-check-btn.hover--tooltip(
                    [class.active]="profileForm.controls['accountRole'].value == 'student'"
                    )
                    input.form-check-input(
                        type="radio",
                        name="accountRole",
                        value="student",
                        [formControl]="profileForm.controls['accountRole']"
                    )
                    span([innerHTML]="':writing_hand: Student' | emojione")
                    .tooltip-wrap
                        .tooltip
                            .tooltip-title I will be mostly reading on Edji
                //- Teacher option
                label#typeTeacherInput.form-check-label.form-check-btn.hover--tooltip(
                    [class.active]="profileForm.controls['accountRole'].value == 'teacher'"
                    )
                    input.form-check-input(
                        type="radio",
                        name="accountRole",
                        value="teacher",
                        [formControl]="profileForm.controls['accountRole']"
                    )
                    span([innerHTML]="':apple: Teacher' | emojione")
                    .tooltip-wrap
                        .tooltip
                            .tooltip-title I will be using Edji to teach
                //- Other Identity options
                ng-container(*ngIf="showMoreIdentities")
                    label.form-check-label.form-check-btn(
                        *ngFor="let identity of moreIdentities",
                        [attr.id]="identity.id",
                        [class.active]="profileForm.controls['accountRole'].value == identity.name",
                    )
                        input.form-check-input(
                            type="radio",
                            name="accountRole",
                            [value]="identity.name",
                            [formControl]="profileForm.controls['accountRole']"
                        )
                        span([innerHTML]="identity.displayName | emojione")
                //- Other Options
                label.form-check-label.form-check-link((click)="showMoreIdentities = !showMoreIdentities", data-test="toggleOtherIdentities")
                    | {{ !showMoreIdentities ? 'Other?' : 'Hide' }}
    .form-group(*ngIf="isSchoolStaff(profileForm.controls['accountRole'].value)")
        label School/District
        hot-school-selector(
            name="school",
            [formControlAlias]="profileForm.controls['school']",
            (schoolDistrictChange)="updateSchoolInfo($event)"
        )
        .alert.alert-info(*ngIf="profileForm.controls['school'].dirty && profileForm.hasError('schoolRequired')")
            | Please add your school or district
    #msgBadName.alert.alert-warn(*ngIf="errorObject.badName", [innerHtml]="errorObject.badName | emojione")
    .button__row.right
        button#buttonCreateProfile.btn.btn-primary(
            title="Make sure you've completed all the fields!",
            type="submit",
            [class.loading]="profileFormLoading",
            [disabled]="!profileForm.valid",
            tabindex="0"
        )
            span(*ngIf="!readingToAdd && !readingToPreview") {{ submitCopy }}
            span(*ngIf="readingToPreview") To Shared Reading
            span(*ngIf="readingToAdd") To My Reading
