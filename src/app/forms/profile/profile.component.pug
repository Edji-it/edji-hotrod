h1.on-dark.center
//- p(*ngIf="readingToAdd") Your reading will be ready to edit after you sign up!
//- p(*ngIf="projectToAdd") Your reading will be on the dashboard after you sign up!
//- h3.text-center.my-4 Register with a firstName and password
form#registerForm([formGroup]="profileForm", (ngSubmit)="register(profileForm.value)")
    .form-group
        label(for="firstNameInput") First Name
        input#firstNameInput(type="text", [formControl]="profileForm.controls['firstName']", tabindex="0", [placeholder]="userCopy.firstName")
        div#msgUsernameRequired.alert.alert-info(*ngIf="profileForm.controls['firstName'].hasError('required') && profileForm.controls['firstName'].dirty") Please add your first name.
    .form-group
        label(for="lastNameInput") Last Name
        input#lastNameInput(type="text", [formControl]="profileForm.controls['lastName']", tabindex="0", [placeholder]="userCopy.lastName")
        div#msgUsernameRequired.alert.alert-info(*ngIf="profileForm.controls['lastName'].hasError('required') && profileForm.controls['lastName'].dirty") Please add your last name.