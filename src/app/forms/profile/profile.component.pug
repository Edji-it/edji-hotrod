
.profile-card
    .user-icon--large
        span.user-icon__initials {{ getInitials(profileForm) }}
    .h1([innerHtml]="getProfileName(profileForm)")
    .label.small.text-muted(*ngIf="profileForm.controls['school'] && profileForm.controls['school'].value")
        i.icon.icon-school
        | {{ ' ' + profileForm.controls['school'].value }}

form.form-block#registerForm([formGroup]="profileForm", (ngSubmit)="updateProfile(profileForm.value)")
    .row
        .col.pr-1
            .form-group
                label(for="firstNameInput") First Name
                input#firstNameInput(type="text", [formControl]="profileForm.controls['firstName']", tabindex="0", [placeholder]="userCopy.firstName")
                
        .col.pl-1
            .form-group
                label(for="lastNameInput") Last Name
                input#lastNameInput(type="text", [formControl]="profileForm.controls['lastName']", tabindex="0", [placeholder]="userCopy.lastName")
        .col-12
            #msgFirstNameRequired.alert.alert-info(*ngIf="profileForm.controls['firstName'].hasError('required') && profileForm.controls['firstName'].dirty") Please add your first name.
            #msgLastNameRequired.alert.alert-info(*ngIf="profileForm.controls['lastName'].hasError('required') && profileForm.controls['lastName'].dirty") Please add your last name.
    .form-group
        label Using as?
            p.sub-label Please select how you will be using Edji.
        .input-group
            .form-check.pl-0
                //- Student option
                label#typeStudentInput.form-check-label.form-check-btn.hover--tooltip(
                    [class.active]="profileForm.controls['accountRole'].value == 'student'"
                    )
                    input.form-check-input(
                        type="radio",
                        name="accountRole",
                        value="student",
                        [formControl]="profileForm.controls['accountRole']"
                    )
                    span([innerHTML]="':writing_hand: Student' | emojione")
                    .tooltip-wrap
                        .tooltip
                            .tooltip-title Focused on reading and have limited sharing abilities
                //- Teacher option
                label#typeTeacherInput.form-check-label.form-check-btn.hover--tooltip(
                    [class.active]="profileForm.controls['accountRole'].value == 'teacher'"
                    )
                    input.form-check-input(
                        type="radio",
                        name="accountRole",
                        value="teacher",
                        [formControl]="profileForm.controls['accountRole']"
                    )
                    span([innerHTML]="':apple: Teacher' | emojione")
                    .tooltip-wrap
                        .tooltip
                            .tooltip-title Focused on created and managing readings
                //- Other Identity options
                ng-container(*ngIf="showMoreIdentities")
                    label.form-check-label.form-check-btn(
                        *ngFor="let identity of moreIdentities",
                        [attr.id]="identity.id",
                        [class.active]="profileForm.controls['accountRole'].value == identity.name",
                    )
                        input.form-check-input(
                            type="radio",
                            name="accountRole",
                            [value]="identity.name",
                            [formControl]="profileForm.controls['accountRole']"
                        )
                        span([innerHTML]="identity.displayName | emojione")
                //- Other Options
                label.form-check-label.form-check-link((click)="showMoreIdentities = !showMoreIdentities")
                    | {{ !showMoreIdentities ? 'Other?' : 'Hide' }}
    .form-group(*ngIf="isSchoolStaff(profileForm.controls['accountRole'].value)")
        label School/District
        hot-school-selector(name="school", [formControlAlias]="profileForm.controls['school']")
    .button__row.right
        button#buttonCreateProfile.btn.btn-primary(title="Make sure you've completed all the fields!", type="submit", [class.loading]="profileLoading", [disabled]="!profileForm.valid", tabindex="0") Go to Dashboard