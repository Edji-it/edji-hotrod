nav-bar([hideAccountOptions]="true", [pageTitle]="'Join Your Academy'")
.container-fluid
  //- Login or Register
  .row.navy-gradient.has-sparks(*ngIf="!errorKey && !user.isLoggedIn")
    .sparks
    .col-sm-2
    .col-sm-8.col-pad.on-dark
      .row.mt-5
          .col-10
            ng-container(*ngIf="login")
              h1.on-dark Login
              p.on-dark Join your Academy by logging in to your account
            ng-container(*ngIf="!login")
              h1.on-dark Register
              p.on-dark Join your Academy by registering for an account
          .col-2
            button.float-right.btn.btn-primary(*ngIf="login", (click)="login=false") Register
            button.float-right.btn.btn-primary(*ngIf="!login", (click)="login=true") Login
      .mt-5
        .row
          .col-12(*ngIf="login")
            .button__row
              hot-google-button([copy]="'Sign In with Google'")
            hr
            p.text-divider(style="background:#133d64;") or
            //- On Log In, user will be updated via Observable
            hot-login-form
          .col-12(*ngIf="!login")
            //- On Registration, user will be updated via Observable
            hot-register-form((registerSuccess)="userRegistered($event)")
  //- Confirm License
  .row.navy-gradient.has-sparks.row-xl-pad(*ngIf="!errorKey && user.isLoggedIn")
    .sparks
    .col-lg-8.offset-lg-2.col-md-10.offset-md-1.col-sm-12.offset-sm-0
      h1.on-dark Confirm Invite to <i>{{academyName}}</i>
      p.on-dark Please verify this is the account you would like to use.
      .card
        .card-block
          .card-title
            .user-icon--large.float-left.mr-3
              span.user-icon__initials {{user.fullname | userinitials}}
            h4.mb-0 {{user.fullname}}
            p.small {{user.email}}
        .card-block
          .btn-row.text-right
            .btn.btn-secondary((click)="changeAccount()") Use other account
            .btn.btn-hero((click)="processLicense()") Join Academy
      .row-pad
        p.on-dark By joining a Hero Academy, your institution provides you with a license of 
          a.link.on-dark([routerLink]="['/hero']") Edji Hero
          | .

  //- Acceptance Errors
  .row.mt-5(*ngIf="errorKey")
    .col-12
      .alert.alert-danger.mb-0(*ngIf="errorKey === 'licenseProcessError'") There was an issue processing your license. Please try again or contact Edji Support.
      .alert.alert-danger.mb-0(*ngIf="errorKey === 'serverError'") There was an error while fetching the user information. Please try again or contact Edji Support.
      .alert.alert-danger.mb-0(*ngIf="errorKey === 'invalidLicense'") Sorry! Looks like that might not be a valid license. Please contact your administrator, or contact Edji Support.
    .col-12.text-center
      button.btn.btn-primary.mr-2([routerLink]="['/dashboard']") Back to Dashboard
      button.btn.btn-primary((click)="_util.showFeedbackModal=true") Contact Edji Support