nav-bar([hideAccountOptions]="true", [pageTitle]="'Join Your Academy'")
.alert.alert-danger(*ngIf="messages.licenseProcessError") There was an issue processing your license. Please try again or contact Edji Support.
.alert.alert-danger(*ngIf="messages.serverError") There was an error while fetching the user information. Please try again or contact Edji Support.
.alert.alert-danger(*ngIf="messages.invalidLicense") Sorry! Looks like that might not be a valid license. Please contact your administrator, or contact Edji Support.

.container-fluid.mt-5
  .row
    .col-10
      h1(*ngIf="login") Login
      h1(*ngIf="!login") Register
    .col-2
      button.float-right.btn.btn-primary(*ngIf="login", (click)="login=false") Register
      button.float-right.btn.btn-primary(*ngIf="!login", (click)="login=true") Login

.container-fluid.mt-5
  .row
    .col-12
      hot-login-form(*ngIf="login")
    .col-12
      hot-register-form(*ngIf="!login")