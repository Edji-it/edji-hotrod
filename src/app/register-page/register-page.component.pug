      #msgReferral.alert.alert-success(
        *ngIf="successObject.referral", 
        [innerHtml]=" '<strong>Congratulations!</strong> :tada: <br>' + userReferral.fullname + ' thought you would really like Edji. Sign up and make your first reading to receive 20% off Hero today!' | emojione"
      )
      hot-register-form(
        [readingToAdd]="readingToAdd",
        [projectToAdd]="projectToAdd",
        [tempUserId]="tempUserId",
        [referralId]="referralId"
      )