nav-bar(
    [pageTitle]="reading._id ? 'Edit Reading' : 'New Reading'",
    [canPublish]="true",
    [saveState]="saveState",
    (saveAction)="saveReading(readingForm.value)",
    (shareAction)="verifyCanShare(readingForm.value)",
    (previewAction)="openReadingPreview(readingForm.value)"
  )
  //- (saveAction)="saveReading(readingForm.value)",
.container.pt-4
  .row
    .col-sm-12
      form([formGroup]="readingForm")
        #readingPageForm.reading-page
          //- Error and Success Messaging
          p.alert.alert-danger(*ngIf="error.length > 0",  [innerHtml]="error | emojione")
          #msgDraftSaved.alert.alert-success.alert-readings.alert-dismissable(role="alert", *ngIf="showAlert") {{ successObject.readingSuccess }}
            a.close(href="#", (click)="showAlert=false") ×
          .alert.alert-danger.alert-readings(role="alert", *ngIf="errorObject.readingError") {{ errorObject.readingError }}
          //- Title Section
          .form-group
            label
              span Title
              input#readingTitle.form-control.title-input.h1.form-item--editor.mTitle(
                  type="text",
                  placeholder="Reading Title...",
                  [formControl]="readingForm.controls['title']",
                  (keyup)="changeMonitor()"
                )
              #errorTitle.alert.alert-danger(*ngIf="readingForm.controls['title'].hasError('required') && (readingForm.controls['title'].dirty || submitted)")
                b No Title
                | Please give your Reading a title!
          //- Public Flag
          .form-group
            label Make Public
              p.sub-label Share this Reading with other teachers looking for lessons. <b>Grade Level</b> and <b>Subject</b> are added to Public readings.
            .input-group
              .form-check.pl-0((click)="changeMonitor()")
                //- Public option
                label#readingMakePublic.form-check-label.form-check-btn(
                    [class.active]="readingForm.controls['public'].value == 'true'",
                    title="Allow anyone to find this Reading in Discover"
                  )
                  input.form-check-input(
                      type="radio",
                      name="publicFlag",
                      value="true",
                      [formControl]="readingForm.controls['public']",
                      checked
                    )
                  span([innerHTML]="':earth_americas: Public' | emojione")
                //- Private option
                label#readingMakePrivate.form-check-label.form-check-btn(
                    [class.active]="readingForm.controls['public'].value == 'false'",
                    title="Hide this Reading from Discover"
                  )
                  input.form-check-input(
                      type="radio",
                      name="publicFlag",
                      value="false",
                      [formControl]="readingForm.controls['public']"
                    )
                  span([innerHTML]="':lock: Private' | emojione")
          //- Grade level range selector
          .form-group(*ngIf="readingForm.controls['public'].value == 'true'")
            label Grade Level
              p.sub-label Select which grade levels this reading targets. (Click to select start of range, and click again to select end of range!)
            grade-selector(formControlName="grade_levels", (click)="changeMonitor()")
            #errorTitle.alert.alert-danger.mt-2(*ngIf="readingForm.controls['grade_levels'].hasError('required') && (readingForm.controls['grade_levels'].dirty || submitted)")
              b No Grades Selected
              | Please select the range of grade levels this Reading is best suited for.
          //- Subject Selector
          .form-group(*ngIf="readingForm.controls['public'].value == 'true'")
            label Subject
            .input-group
            ss-multiselect-dropdown(id="subjectDropdown",[options]="subjects", formControlName="subjects", [settings]="subjectDropSettings")
            #errorTitle.alert.alert-danger.mt-2(*ngIf="readingForm.controls['subjects'].hasError('required') && (readingForm.controls['subjects'].dirty || submitted)")
              b No Subjects Selected
              | Please select at least one Subject area that this Reading applies to.
          //- Reading Group Instructions section
          //- .form-group(*ngIf="user.hero")
          //-   label Group Instructions
          //-     p.sub-label Provide your students with instructions for this reading. Instructions can be changed whenever you make a new group
          //-     .input-group
          //-       input#readingInstructions.form-control.form-item--editor.h3(type="text", placeholder="Reading Group Instructions", [formControl]="readingForm.controls['instructions']")
          //- Body Section
              - Includes "reading content" and "source"
          .form-group.medium-wrap(style="position:relative;")
            label Reading Content
            //- Reading Content section
            p.sub-label Select text to see formatting options. Use the insert buttons on the left to add images and PDFs.
            //- Too large warning
            .alert.alert-warning(*ngIf="isLargeReading(wordCount, wordBoxCount)")
              b Reading may be too large
              p.mb-0 Readings with too much content may perform slowly, especially on older devices. Exceeding 3000+ words or using too many word-heavy PDF pages will display this warning. For the best, snappy Edji experience, please reduce the amount of content.
            div(*ngFor="let readingPart of readingHtml; let i=index")
              edji-question(
                *ngIf="readingPart.question",
                (questionDelete)="deleteQuestion(i)",
                [question]="readingPart.question",
                (questionUpdate)="updateQ(readingPart.question,$event)",
                (keyup)="contentChange($event)",
                (mouseup)="contentChange($event)",
                (mousedown)="$event.preventDefault ? $event.preventDefault() : $event.returnValue = false")
              medium-editor#angularMediumEditor.content(
                [editorModel]="readingPart.text",
                [editorOptions]="mediumEditorConfig",
                [editorPlaceholder]="getReadingPlaceholder(i)",
                (keyup)="contentChange($event)",
                (mouseup)="contentChange($event)",
                [ngClass]="[i<readingHtml.length - 1 ? 'medium-editor__new-question' : '']",
                [attr.rindex]="i")
            #errorContent.alert.alert-danger(*ngIf="submitted && readingIsBlank")
              b No Content
              | Please give your Reading some content!
            //- Editor Insert Options
                - Insert a Picture or Pdf
                - (Hero) Insert a Question
            //- Desktop Insert Buttons
            .editor-button-bar.hidden-md-down([class.hide]="editorToolbarHidden", [style.top]="editorToolbarY + 'px'")
              //- Insert Label
              span.editor-button-bar__title Insert
              //- Upload Image Button
                  - Opens Modal.
              a#buttonUploadImage.btn.btn-icon--plain(
                  (click)="showUploadModal = true",
                  data-test="buttonUploadImage"
                )
                img(title="Add Picture" src="/assets/images/icon-picture.svg")
              //- Upload PDF Button
                  - Opens Modal
              a#buttonUploadPdf.btn.btn-icon--plain((click)="showPdfUploadModal = true")
                .badge.badge-success.badge-dot(*ngIf="newWordHighlights")
                img(title="Add PDF" src="/assets/images/icon-pdf.svg")
              //- Insert Question Button (Hero) - NOT DONE
                  - Modal not needed.
              a#buttonInsertQuestion.btn.btn-icon--plain((click)="addQuestionInLine()")
                img(title="Add Question" src="/assets/images/icon-add-question.svg")
            //- Mobile Insert Buttons
            .editor-button-bar.hidden-lg-up([class.hide]="editorToolbarHidden")
              //- Insert Label
              //- Upload Image Button
                  - Opens Modal.
              .insert-options-group--mobile([class.btn-group-show--animation]="insertOptionShow")
                a#buttonUploadImageMobile.btn.btn-icon--circle-shadow.insert-options--mobile(
                  (tap)="showUploadModal = true; insertOptionShow=!insertOptionShow",
                  [class.btn-show--animation]="insertOptionShow",
                  data-test="buttonUploadImage"
                )
                  img(title="Add Picture", src="/assets/images/icon-picture.svg", [class.hide]="!insertOptionShow")
                //- Upload PDF Button
                    - Opens Modal
                a#buttonUploadPdfMobile.btn.btn-icon--circle-shadow.insert-options--mobile(
                  (tap)="showPdfUploadModal = true; insertOptionShow=!insertOptionShow",
                  [class.btn-show--animation]="insertOptionShow"
                )
                  img(title="Add PDF", src="/assets/images/icon-pdf.svg", [class.hide]="!insertOptionShow")
                //- Insert Question Button (Hero) - NOT DONE
                    - Modal not needed.
                a#buttonInsertQuestionMobile.btn.btn-icon--circle-shadow.insert-options--mobile(
                  (tap)="addQuestionInLine(); insertOptionShow=!insertOptionShow",
                  [class.btn-show--animation]="insertOptionShow"
                )
                  img(title="Add Question", src="/assets/images/icon-add-question.svg", [class.hide]="!insertOptionShow")
              a#buttonInsertToolToggle.btn.btn-icon--circle-shadow.mobile-menu-spot((tap)="insertOptionShow=!insertOptionShow")
                span(style="font-size: 11px;") Insert
          .form-group
            //- Source section
            label Source
              p.sub-label (Optional) Provide a link or title for the source of the text.
              .input-group
                input#readingSource.form-control.form-item--editor.h3.mSource(type="text", placeholder="New Reading Source...", [formControl]="readingForm.controls['source']")

.fixed-btn-row--SE
  tutorial-box([tutorialName]="'newReading'",
    [pageObjs]="guideContent",
    [pager]="guideStepNo",
    (pageChange)="guideStepNo = $event")

//- Modals
upload-picture-modal.modal-will-fade([class.show]="showUploadModal", (returnImage)="addImages($event)", (closeModal)="showUploadModal = false")
upload-pdf-modal.modal-will-fade([class.show]="showPdfUploadModal", (returnImage)="addImages($event)", (closeModal)="showPdfUploadModal = false")
//- Confirm if user wants to archive a past reading
hot-confirm-archive-modal.modal-will-fade(
  *ngIf="showConfirmArchiveModal",
  [class.show]="showConfirmArchiveModal",
  (confirmArchive)="showConfirmArchiveModal=false; showFirstGroupModal = true",
  (declineArchive)="showConfirmArchiveModal=false",
  (goHero)="showHeroParam=true",
  (closeModal)="showConfirmArchiveModal=false",
  [readingToArchive]="readingToArchive"
)
//- Create First Group
hot-add-project-modal.modal-will-fade(
  *ngIf="showFirstGroupModal",
  [class.show]="showFirstGroupModal",
  [heading]="'Create and Share First Group'",
  [subheading]="'Your Reading has been saved! Now create your first group to publish this Reading and share with students.'",
  [reading]="reading",
  [groupLabel]="'Group 1'",
  [largeReadingWarning]="isLargeReading(wordCount, wordBoxCount)",
  (groupSaved)="finalizeShare(readingForm.value, $event)",
  (closeModal)="showFirstGroupModal = false"
)
//- Go Hero!
hero-subscribe-modal.modal-will-fade(
  *ngIf="showHeroSubModal",
  [class.show]="showHeroSubModal",
  (closeModal)="showHeroSubModal=false",
  (heroWasBorn)="router.navigate(['/dashboard'])"
)
//- Reading Preview Modal
hot-reading-preview-modal(
  *ngIf="showReadingPreviewModal",
  [reading]="selectedReading",
  [user]="user",
  (closeModal)="showReadingPreviewModal=false",
  (createSuccess)="verifyCanShare($event)",
  [context]="'creator'"
)
