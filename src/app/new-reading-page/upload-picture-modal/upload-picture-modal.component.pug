#uploadModal.modal
  .modal-dialog.modal-lg
    .modal-content
      form
        .modal-header
          h4.modal-title Add a Picture
          button.close.btn-icon--round(
            (click)="closeModal.emit()",
            type="button",
            data-dismiss="modal",
            aria-label="Close"
          )
            span(aria-hidden="true") &times;
        .modal-body
          form
            .form-group
              .input-group
                input.file-name.form-control(
                  (click)="browseBtn.click()",
                  type="text",
                  readonly,
                  value="{{ file ? file.name : '' }}",
                  placeholder="Select image to upload..."
                  )
                .input-group-append
                  label.mb-0.btn.btn-secondary.btn-file(#browseBtn) Browse
                    input#imageFileInput(
                      type="file",
                      accept=".jpg,.png,.gif,.jpeg,.svg",
                      (change)="updateUploadFile()",
                      style="display:none;"
                    )
                  button#buttonBeginImageUpload.btn.btn-primary(
                    (click)="beginUpload()",
                    type="submit",
                    [disabled]="!file || noUploadAllowed",
                    [class.loading]="uploading"
                  ) Upload
              small.form-text.text-muted Image should be less than <b>5MB</b>, and can be a JPG, PNG, GIF, or SVG
          .alert.alert-warning(*ngIf="errorMsg") {{ errorMsg }}
          hr
          p#status Select an image to insert into your Reading
          .card-columns
            ng-container(*ngFor="let image of uploadedImages; let i = index")
              .card.upload-list-item(
                *ngIf="i < 30",
                (click)="insertImage(i)",
                [class.new]="newImgUrls.indexOf(image.url) > -1"
              )
                img.card-img-top.img-fluid([src]="image.url", [title]="image.title")
                .card-img-overlay.overlay-on-hover
                  button.btn.btn-primary.btn--center-overlay Insert
        .modal-footer